---
const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Artista", href: "/artista" },
  { label: "Música", href: "/musica" },
  { label: "Videos", href: "/videos" },
  { label: "Drop Room", href: "/drop-room" },
];
---

<header class="site-header">
  <a href="/" class="site-header__logo" aria-label="Inicio">
    <span class="site-header__logo-g">G</span><span class="site-header__logo-rest">ARGUT</span>
  </a>

  <nav class="site-header__nav" aria-label="Navegación principal">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="site-header__link"
        data-nav={item.href}
        aria-current={Astro.url.pathname === item.href ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <button
    class="site-header__menu-btn"
    id="menuToggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobileDrawer"
  >
    <span class="site-header__menu-line" aria-hidden="true"></span>
    <span class="site-header__menu-line" aria-hidden="true"></span>
    <span class="site-header__menu-line" aria-hidden="true"></span>
  </button>
</header>

<script is:inline>
  (function() {
    const links = document.querySelectorAll('.site-header__link[data-nav]');
    const path = window.location.pathname;
    links.forEach(function(link) {
      var href = link.getAttribute('href');
      if (href === '/' ? path === '/' : path.startsWith(href || '')) {
        link.classList.add('is-active');
        link.setAttribute('aria-current', 'page');
      }
    });
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 1.25rem;
    background: linear-gradient(180deg, rgba(7, 7, 9, 0.9) 0%, rgba(7, 7, 9, 0.68) 100%);
    backdrop-filter: blur(22px) saturate(1.25);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.9);
  }
  .site-header::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(225, 29, 46, 0.5) 32%,
      rgba(225, 29, 46, 0.18) 68%,
      transparent 100%
    );
    pointer-events: none;
  }

  .site-header__logo {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 0.2s;
    line-height: 1;
  }
  .site-header__logo:hover { opacity: 0.82; }

  .site-header__logo-g {
    font-family: var(--font-display);
    font-size: 1.55rem;
    background: linear-gradient(180deg, #ff6b76 0%, var(--accent) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 0.02em;
    line-height: 1;
    filter: drop-shadow(0 0 12px rgba(225, 29, 46, 0.5));
  }
  .site-header__logo-rest {
    font-family: var(--font-display);
    font-size: 1.28rem;
    color: var(--text);
    letter-spacing: 0.14em;
    line-height: 1;
    margin-left: 0.04em;
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  .site-header__link {
    position: relative;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.1em;
    padding: 0.42rem 0.78rem;
    border-radius: 999px;
    transition: color 0.2s, background 0.2s, border-color 0.2s, box-shadow 0.3s;
    -webkit-tap-highlight-color: transparent;
    border: 1px solid transparent;
  }
  .site-header__link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.045);
    border-color: var(--border);
  }
  .site-header__link.is-active {
    color: var(--text);
    border-color: var(--accent-line);
    background: var(--accent-soft);
    box-shadow: inset 0 0 18px -6px rgba(225, 29, 46, 0.5);
  }
  .site-header__link.is-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.12rem;
    width: 14px;
    height: 1px;
    transform: translateX(-50%);
    background: var(--accent-bright);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .site-header__menu-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 42px; height: 42px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s, border-color 0.2s;
    padding: 0;
  }
  .site-header__menu-btn:hover {
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .site-header__menu-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  @media (min-width: 768px) {
    .site-header { height: 64px; padding: 0 2.5rem; }
    .site-header__logo-g { font-size: 1.8rem; }
    .site-header__logo-rest { font-size: 1.5rem; }
    .site-header__nav { display: flex; }
    .site-header__menu-btn { display: none; }
    .site-header__link { font-size: 0.92rem; padding: 0.45rem 0.9rem; }
  }
</style>

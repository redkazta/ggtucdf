---
const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Artista", href: "/artista" },
  { label: "Música", href: "/musica" },
  { label: "Videos", href: "/videos" },
  { label: "Drop Room", href: "/drop-room" },
];

const tickerItems = [
  "NUEVO DROP: YO TE KIERO SOLO",
  "DROP ROOM ABIERTO",
  "GUADALAJARA, MÉXICO",
  "MÚSICA URBANA",
];
const ticker = tickerItems.join(" ✦ ") + " ✦ ";
---

<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label="Inicio">
      <span class="site-header__mark" aria-hidden="true"></span>
      GARGUT<span class="site-header__tm" aria-hidden="true">®</span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          class="site-header__link"
          data-nav={item.href}
          aria-current={Astro.url.pathname === item.href ? "page" : undefined}
        >
          <span class="site-header__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <button
      class="site-header__menu-btn"
      id="menuToggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileDrawer"
    >
      <span class="site-header__menu-label">Menú</span>
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span><span></span>
      </span>
    </button>
  </div>

  <div class="site-header__ticker" aria-hidden="true">
    <div class="site-header__ticker-track">
      <span>{ticker}</span>
      <span>{ticker}</span>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const links = document.querySelectorAll('.site-header__link[data-nav]');
    const path = window.location.pathname;
    links.forEach(function(link) {
      var href = link.getAttribute('href');
      if (href === '/' ? path === '/' : path.startsWith(href || '')) {
        link.classList.add('is-active');
        link.setAttribute('aria-current', 'page');
      }
    });
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 1rem;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: 0.03em;
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s;
  }
  .site-header__logo:hover { color: var(--accent); }

  .site-header__mark {
    width: 9px;
    height: 9px;
    background: var(--accent);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .site-header__tm {
    align-self: flex-start;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    color: var(--text-dim);
    letter-spacing: 0;
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.5rem 0 0.45rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .site-header__index {
    font-size: 0.52rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .site-header__link:hover {
    color: var(--ink);
    border-bottom-color: var(--line-strong);
  }
  .site-header__link:hover .site-header__index { color: var(--accent); }
  .site-header__link.is-active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .site-header__link.is-active .site-header__index { color: var(--accent); }

  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    background: transparent;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .site-header__menu-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .site-header__menu-icon {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 22px;
  }
  .site-header__menu-icon span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s ease;
  }
  .site-header__menu-btn:hover .site-header__menu-icon span:first-child { transform: translateX(3px); }
  .site-header__menu-btn:hover .site-header__menu-icon span:last-child { transform: translateX(-3px); }

  /* Ticker */
  .site-header__ticker {
    overflow: hidden;
    background: var(--accent);
    border-top: 1px solid var(--accent-deep);
  }
  .site-header__ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-run 28s linear infinite;
  }
  .site-header__ticker-track span {
    display: block;
    padding: 0.34rem 0;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
  }

  @keyframes ticker-run {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (min-width: 768px) {
    .site-header__bar { height: 62px; padding: 0 2.25rem; }
    .site-header__logo { font-size: 1.9rem; }
    .site-header__nav { display: flex; }
    .site-header__menu-btn { display: none; }
    .site-header__ticker-track span { font-size: 0.58rem; padding: 0.38rem 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__ticker-track { animation: none; }
  }
</style>

      linear-gradient(160deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.012) 100%);
    box-shadow: var(--shadow-deep);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

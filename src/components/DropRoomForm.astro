    color: var(--accent-bright);
    text-underline-offset: 2px;
  }

  button {
    position: relative;
    margin-top: 0.25rem;
    padding: 0.9rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: linear-gradient(135deg, var(--accent-bright) 0%, var(--accent) 48%, var(--accent-deep) 100%);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    box-shadow:
      0 16px 34px -14px var(--accent-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
    transition: transform 0.2s ease, box-shadow 0.3s ease, background 0.3s ease;
  }
  button:hover:not(:disabled) {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #ff5563 0%, #ec2233 48%, #b31120 100%);
    box-shadow:
      0 22px 44px -14px var(--accent-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  button:active:not(:disabled) { transform: scale(0.985); }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .error-message,
  .success-message {
    font-size: 0.8rem;
    text-align: center;
    min-height: 1.2rem;
    line-height: 1.5;
  }
  .error-message { color: #ff6b76; }
  .success-message { color: #4ade80; }

  @media (prefers-reduced-motion: reduce) {
    input, button { transition: none; }
    button:hover:not(:disabled) { transform: none; }
  }
</style>

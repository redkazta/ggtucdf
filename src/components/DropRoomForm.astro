<form id="dropRoomForm" class="drop-room-form" novalidate>
  <input
    type="text"
    name="nombre"
    placeholder="Nombre"
    required
    minlength="2"
    maxlength="80"
    autocomplete="name"
  />
  <input
    type="email"
    name="email"
    placeholder="Email"
    required
    maxlength="254"
    autocomplete="email"
  />
  <input
    type="tel"
    name="whatsapp"
    placeholder="WhatsApp (+52...)"
    required
    maxlength="20"
    autocomplete="tel"
    inputmode="tel"
  />
  <label class="checkbox-label">
    <input type="checkbox" name="acepto_privacidad" required />
    <span>
      Acepto el
      <a href="/privacidad" target="_blank" rel="noopener">aviso de privacidad</a>
      y recibir contenido exclusivo
    </span>
  </label>
  <button type="submit">Unirme al Drop Room</button>
  <p id="formError" class="error-message" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById("dropRoomForm");
  const messageEl = document.getElementById("formError");

  if (form && messageEl) {
    const submitButton = form.querySelector('button[type="submit"]');
    const defaultButtonText = submitButton?.textContent ?? "Unirme al Drop Room";

    function showMessage(message, type) {
      messageEl.textContent = message;
      messageEl.className =
        type === "success" ? "success-message" : "error-message";
    }

    function setSubmitting(isSubmitting) {
      if (!submitButton) return;
      submitButton.disabled = isSubmitting;
      submitButton.textContent = isSubmitting ? "Enviando..." : defaultButtonText;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const nombre = String(formData.get("nombre") ?? "").trim();
      const email = String(formData.get("email") ?? "").trim();
      const rawWhatsapp = String(formData.get("whatsapp") ?? "").trim();
      const whatsapp = rawWhatsapp.replace(/[\s().-]+/g, "");
      const accepted = formData.get("acepto_privacidad") === "on";

      if (nombre.length < 2 || nombre.length > 80) {
        showMessage("Introduce un nombre válido (2-80 caracteres).");
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showMessage("Por favor, introduce un email válido.");
        return;
      }

      if (!/^\+?\d{7,15}$/.test(whatsapp)) {
        showMessage(
          "Por favor, introduce un número de WhatsApp válido (ej. +521234567890)."
        );
        return;
      }

      if (!accepted) {
        showMessage("Debes aceptar el aviso de privacidad.");
        return;
      }

      setSubmitting(true);
      showMessage("");

      try {
        const response = await fetch("/api/register-fan", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            nombre,
            email,
            whatsapp,
            acepto_privacidad: true,
          }),
        });

        if (response.ok) {
          form.reset();
          showMessage(
            "¡Ya estás dentro! Gracias por unirte al Drop Room.",
            "success"
          );
          return;
        }

        let message = "Hubo un error al registrarte. Inténtalo de nuevo.";

        try {
          const payload = await response.json();
          if (typeof payload?.error === "string") message = payload.error;
        } catch {
          // Keep the generic message when the server did not return JSON.
        }

        showMessage(message);
      } catch (error) {
        console.error("[DropRoomForm] Registration request failed:", error);
        showMessage("No se pudo conectar al servidor. Inténtalo de nuevo.");
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>

<style>
  .drop-room-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 400px;
    margin: 0 auto;
  }
  input {
    padding: 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
  }
  input:focus {
    outline: none;
    border-color: #ff3333;
  }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    text-align: left;
    line-height: 1.5;
  }
  .checkbox-label input {
    width: auto;
    margin-top: 0.2rem;
    accent-color: #ff3333;
  }
  .checkbox-label a {
    color: #ff6b6b;
    text-underline-offset: 2px;
  }
  button {
    padding: 0.75rem;
    border-radius: 8px;
    border: none;
    background: #ff3333;
    color: #fff;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  button:hover:not(:disabled) {
    background: #e02a2a;
  }
  button:active:not(:disabled) {
    transform: scale(0.98);
  }
  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .error-message,
  .success-message {
    font-size: 0.8rem;
    text-align: center;
    min-height: 1.2rem;
    line-height: 1.5;
  }
  .error-message {
    color: #ff3333;
  }
  .success-message {
    color: #1db954;
  }
</style>

---
import { SPOTIFY_TRACK_ID } from "../data/siteConfig";
---

<div class="spotify-player" id="spotifyPlayer" data-fallback-id={SPOTIFY_TRACK_ID}>
  <div class="spotify-skeleton" data-skeleton aria-hidden="true">
    <div class="skeleton-bar"></div>
    <div class="skeleton-bar"></div>
  </div>
</div>

<script>
  const container = document.getElementById("spotifyPlayer");
  const fallbackId = container?.dataset.fallbackId ?? "";

  function isTrackId(value) {
    return typeof value === "string" && /^[A-Za-z0-9]{22}$/.test(value);
  }

  function renderIframe(trackId) {
    if (!container || !isTrackId(trackId)) return;

    const iframe = document.createElement("iframe");
    iframe.src = `https://open.spotify.com/embed/track/${trackId}`;
    iframe.className = "spotify-iframe";
    iframe.loading = "eager";
    iframe.allow = "encrypted-media; clipboard-write";
    iframe.title = "Último lanzamiento en Spotify";

    container.replaceChildren(iframe);
  }

  async function loadLatestTrack() {
    if (!container) return;

    try {
      const response = await fetch("/api/latest-spotify", {
        headers: { Accept: "application/json" },
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = await response.json();
      if (!isTrackId(data?.id)) {
        throw new Error("Spotify returned an invalid track id");
      }

      renderIframe(data.id);
    } catch (error) {
      console.warn("[SpotifyLatestPlayer] Usando track de respaldo:", error);
      renderIframe(fallbackId);
    }
  }

  if (container) {
    void loadLatestTrack();
  }
</script>

<style>
  .spotify-player {
    position: relative;
    width: 100%;
    padding: 10px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(420px 120px at 50% 0%, rgba(29, 185, 84, 0.09), transparent 70%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.012) 100%);
    box-shadow:
      var(--shadow-deep),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .spotify-player::before {
    content: "";
    position: absolute;
    top: 0; left: 20%; right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(29, 185, 84, 0.4), transparent);
    pointer-events: none;
  }
  .spotify-iframe {
    width: 100%;
    height: 80px;
    border: none;
    border-radius: 10px;
    display: block;
    background: #0a0a0c;
  }
  .spotify-skeleton {
    position: absolute;
    inset: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
  }
  .skeleton-bar {
    height: 12px;
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.04) 0%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.04) 100%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.6s ease-in-out infinite;
  }
  @keyframes skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skeleton-bar {
      animation: none;
    }
  }
</style>

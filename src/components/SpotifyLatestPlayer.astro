---
import { LATEST_RELEASE } from "../data/siteConfig";

const trackId = /^[A-Za-z0-9]{22}$/.test(LATEST_RELEASE.id) ? LATEST_RELEASE.id : "";
---

<div class="spotify-player" id="spotifyPlayer">
  {
    trackId ? (
      <iframe
        src={`https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0`}
        class="spotify-iframe"
        data-latest-track
        data-current-id={trackId}
        width="100%"
        height="80"
        style="border:0;"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        title="Último lanzamiento en Spotify"
      />
    ) : null
  }
</div>

<script is:inline>
  (() => {
    const iframe = document.querySelector("[data-latest-track]");
    if (!iframe) return;

    fetch("/api/latest-spotify", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;

        const id = data.id;
        if (typeof id !== "string" || !/^[A-Za-z0-9]{22}$/.test(id)) return;
        if (id === iframe.dataset.currentId) return;

        iframe.src = `https://open.spotify.com/embed/track/${id}?utm_source=generator&theme=0`;
        iframe.dataset.currentId = id;
        iframe.title = data.name
          ? `${data.name} en Spotify`
          : "Último lanzamiento en Spotify";
      })
      .catch(() => {});
  })();
</script>

<style>
  .spotify-player {
    position: relative;
    width: 100%;
    padding: 0;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: var(--bg);
  }
  :global(.spotify-iframe) {
    width: 100%;
    height: 80px;
    border: none;
    border-radius: 0;
    display: block;
    background: var(--bg);
  }
</style>

  }
  .copy-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.8rem 1rem 0.72rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;

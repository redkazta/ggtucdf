    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .copy-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .admin-actions {
    display: flex;
    justify-content: flex-start;

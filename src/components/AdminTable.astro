    font-size: clamp(1.6rem, 5vw, 2.3rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .table-count {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }


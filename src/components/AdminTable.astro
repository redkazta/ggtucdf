<div class="admin-table-container" id="adminTable">
  <div class="loading" id="loading">Cargando fans...</div>
  <div class="error" id="error" style="display:none"></div>
  <div class="empty" id="empty" style="display:none">No hay fans registrados todavía.</div>
  <table class="fans-table" id="fansTable" style="display:none">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Email</th>
        <th>WhatsApp</th>
        <th>Fecha</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody id="fansBody"></tbody>
  </table>
  <div class="admin-actions" id="adminActions" style="display:none">
    <button type="button" class="copy-all-btn" id="copyAllBtn">
      Copiar todos los números (coma-separados)
    </button>
  </div>
</div>

<script>
  import { toast } from "../lib/toast";

  const loadingEl = document.getElementById("loading");
  const errorEl = document.getElementById("error");
  const emptyEl = document.getElementById("empty");
  const tableEl = document.getElementById("fansTable");
  const bodyEl = document.getElementById("fansBody");
  const actionsEl = document.getElementById("adminActions");
  const copyAllBtn = document.getElementById("copyAllBtn");

  if (
    loadingEl &&
    errorEl &&
    emptyEl &&
    tableEl &&
    bodyEl &&
    actionsEl &&
    copyAllBtn
  ) {
    let fans = [];

    function formatDate(value) {
      const date = new Date(String(value ?? ""));
      if (Number.isNaN(date.getTime())) return "—";

      return new Intl.DateTimeFormat("es-MX", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    }

    async function copyText(text, successMessage) {
      if (!text) {
        toast("No hay número para copiar", "error");
        return;
      }

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
        } else {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "-9999px";
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand("copy");
          textarea.remove();
          if (!copied) throw new Error("copy command failed");
        }

        toast(successMessage);
      } catch (error) {
        console.error("[AdminTable] Copy failed:", error);
        toast("No se pudo copiar", "error");
      }
    }

    function makeCell(text) {
      const cell = document.createElement("td");
      cell.textContent = text;
      return cell;
    }

    function render() {
      loadingEl.style.display = "none";
      errorEl.style.display = "none";
      bodyEl.replaceChildren();

      if (fans.length === 0) {
        emptyEl.style.display = "block";
        tableEl.style.display = "none";
        actionsEl.style.display = "none";
        return;
      }

      emptyEl.style.display = "none";
      tableEl.style.display = "table";
      actionsEl.style.display = "flex";

      const fragment = document.createDocumentFragment();

      for (const fan of fans) {
        const row = document.createElement("tr");
        const name = String(fan.nombre ?? "");
        const whatsapp = String(fan.whatsapp ?? "");

        row.append(
          makeCell(name),
          makeCell(String(fan.email ?? "")),
          makeCell(whatsapp),
          makeCell(formatDate(fan.created_at))
        );

        const actionCell = document.createElement("td");
        const copyButton = document.createElement("button");
        copyButton.type = "button";
        copyButton.className = "copy-btn";
        copyButton.textContent = "Copiar";
        copyButton.setAttribute("aria-label", `Copiar WhatsApp de ${name || "fan"}`);
        copyButton.addEventListener("click", () => {
          void copyText(whatsapp, "Número copiado al portapapeles");
        });

        actionCell.appendChild(copyButton);
        row.appendChild(actionCell);
        fragment.appendChild(row);
      }

      bodyEl.appendChild(fragment);
    }

    async function loadFans() {
      try {
        const response = await fetch("/api/fans", {
          headers: { Accept: "application/json" },
        });

        if (response.status === 401) {
          errorEl.textContent =
            "Tu sesión ha expirado. Recarga la página para volver a entrar.";
          errorEl.style.display = "block";
          loadingEl.style.display = "none";
          return;
        }

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const payload = await response.json();
        fans = Array.isArray(payload?.fans) ? payload.fans : [];
        render();
      } catch (error) {
        console.error("[AdminTable] Could not load fans:", error);
        errorEl.textContent = "No se pudieron cargar los fans.";
        errorEl.style.display = "block";
        loadingEl.style.display = "none";
      }
    }

    copyAllBtn.addEventListener("click", () => {
      const numbers = fans
        .map((fan) => String(fan.whatsapp ?? ""))
        .filter(Boolean);

      if (numbers.length === 0) {
        toast("No hay números para copiar", "error");
        return;
      }

      void copyText(numbers.join(", "), "Todos los números copiados");
    });

    void loadFans();
  }
</script>

<style>
  .admin-table-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem;
  }
  .loading,
  .error,
  .empty {
    text-align: center;
    padding: 2rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .error {
    color: #ff3333;
  }
  .fans-table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    overflow: hidden;
  }
  .fans-table th {
    background: rgba(255, 50, 50, 0.15);
    color: #fff;
    text-align: left;
    padding: 0.75rem;
    font-family: "Bebas Neue", sans-serif;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .fans-table td {
    padding: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .fans-table tr:last-child td {
    border-bottom: none;
  }
  .fans-table tr:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .copy-btn {
    background: rgba(255, 50, 50, 0.15);
    color: #ff3333;
    border: 1px solid rgba(255, 50, 50, 0.3);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }
  .copy-btn:hover {
    background: rgba(255, 50, 50, 0.3);
    color: #fff;
  }
  .admin-actions {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }
  .copy-all-btn {
    background: rgba(29, 185, 84, 0.15);
    color: #1db954;
    border: 1px solid rgba(29, 185, 84, 0.3);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.2s;
  }
  .copy-all-btn:hover {
    background: rgba(29, 185, 84, 0.3);
    color: #fff;
  }

  @media (max-width: 640px) {
    .admin-table-container {
      padding: 0.5rem;
    }
    .fans-table th,
    .fans-table td {
      padding: 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>

<div class="admin-table-container" id="adminTable">
  <div class="table-head">
    <div>
      <span class="kicker">03 / Registros</span>
      <h2>Fans del Drop Room</h2>
    </div>
    <span class="table-count" id="fanCount">—</span>
  </div>

  <div class="table-shell">
    <div class="state" id="loading">Cargando fans...</div>
    <div class="state state--error" id="error" style="display:none">
      <span class="state__title" id="errorTitle"></span>
      <span class="state__hint" id="errorHint"></span>
    </div>
    <div class="state" id="empty" style="display:none">
      No hay fans registrados todavía.
    </div>

    <div class="table-scroll">
      <table class="fans-table" id="fansTable" style="display:none">
        <thead>
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>WhatsApp</th>
            <th>Fecha</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody id="fansBody"></tbody>
      </table>
    </div>
  </div>

  <div class="admin-actions" id="adminActions" style="display:none">
    <button type="button" class="copy-all-btn" id="copyAllBtn">
      Copiar todos los números <span aria-hidden="true">→</span>
    </button>
  </div>
</div>

<script>
  import { toast } from "../lib/toast";

  const loadingEl = document.getElementById("loading");
  const errorEl = document.getElementById("error");
  const errorTitleEl = document.getElementById("errorTitle");
  const errorHintEl = document.getElementById("errorHint");
  const emptyEl = document.getElementById("empty");
  const tableEl = document.getElementById("fansTable");
  const bodyEl = document.getElementById("fansBody");
  const actionsEl = document.getElementById("adminActions");
  const copyAllBtn = document.getElementById("copyAllBtn");
  const countEl = document.getElementById("fanCount");

  if (
    loadingEl &&
    errorEl &&
    errorTitleEl &&
    errorHintEl &&
    emptyEl &&
    tableEl &&
    bodyEl &&
    actionsEl &&
    copyAllBtn &&
    countEl
  ) {
    let fans = [];

    function formatDate(value) {
      const date = new Date(String(value ?? ""));
      if (Number.isNaN(date.getTime())) return "—";

      return new Intl.DateTimeFormat("es-MX", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    }

    async function copyText(text, successMessage) {
      if (!text) {
        toast("No hay número para copiar", "error");
        return;
      }

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
        } else {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "-9999px";
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand("copy");
          textarea.remove();
          if (!copied) throw new Error("copy command failed");
        }

        toast(successMessage);
      } catch (error) {
        console.error("[AdminTable] Copy failed:", error);
        toast("No se pudo copiar", "error");
      }
    }

    function makeCell(text) {
      const cell = document.createElement("td");
      cell.textContent = text;
      return cell;
    }

    function showError(title, hint) {
      errorTitleEl.textContent = title;
      errorHintEl.textContent = hint ?? "";
      errorHintEl.style.display = hint ? "block" : "none";
      errorEl.style.display = "flex";
      loadingEl.style.display = "none";
    }

    function render() {
      loadingEl.style.display = "none";
      errorEl.style.display = "none";
      bodyEl.replaceChildren();
      countEl.textContent = `${String(fans.length).padStart(2, "0")} registros`;

      if (fans.length === 0) {
        emptyEl.style.display = "block";
        tableEl.style.display = "none";
        actionsEl.style.display = "none";
        return;
      }

      emptyEl.style.display = "none";
      tableEl.style.display = "table";
      actionsEl.style.display = "flex";

      const fragment = document.createDocumentFragment();

      fans.forEach((fan, index) => {
        const row = document.createElement("tr");
        const name = String(fan.nombre ?? "");
        const whatsapp = String(fan.whatsapp ?? "");

        const indexCell = makeCell(String(index + 1).padStart(2, "0"));
        indexCell.className = "cell-index";

        row.append(
          indexCell,
          makeCell(name),
          makeCell(String(fan.email ?? "")),
          makeCell(whatsapp),
          makeCell(formatDate(fan.created_at))
        );

        const actionCell = document.createElement("td");
        const copyButton = document.createElement("button");
        copyButton.type = "button";
        copyButton.className = "copy-btn";
        copyButton.textContent = "Copiar";
        copyButton.setAttribute("aria-label", `Copiar WhatsApp de ${name || "fan"}`);
        copyButton.addEventListener("click", () => {
          void copyText(whatsapp, "Número copiado al portapapeles");
        });

        actionCell.appendChild(copyButton);
        row.appendChild(actionCell);
        fragment.appendChild(row);
      });

      bodyEl.appendChild(fragment);
    }

    async function loadFans() {
      try {
        const response = await fetch("/api/fans", {
          headers: { Accept: "application/json" },
        });

        if (response.status === 401) {
          showError(
            "Tu sesión ha expirado.",
            "Recarga la página para volver a entrar."
          );
          return;
        }

        if (!response.ok) {
          const payload = await response.json().catch(() => null);
          const serverMessage =
            typeof payload?.error === "string" ? payload.error : null;

          showError(
            serverMessage ?? `No se pudieron cargar los fans (HTTP ${response.status}).`,
            response.status === 503
              ? "Revisa PUBLIC_SUPABASE_URL y PRIVATE_SUPABASE_SERVICE_ROLE_KEY en Vercel."
              : "Verifica que ejecutaste supabase/fans_gargut.sql en Supabase y que la service role key es correcta."
          );
          return;
        }

        const payload = await response.json();
        fans = Array.isArray(payload?.fans) ? payload.fans : [];
        render();
      } catch (error) {
        console.error("[AdminTable] Could not load fans:", error);
        showError(
          "No se pudieron cargar los fans.",
          "No hubo respuesta del servidor. Intenta recargar la página."
        );
      }
    }

    copyAllBtn.addEventListener("click", () => {
      const numbers = fans
        .map((fan) => String(fan.whatsapp ?? ""))
        .filter(Boolean);

      if (numbers.length === 0) {
        toast("No hay números para copiar", "error");
        return;
      }

      void copyText(numbers.join(", "), "Todos los números copiados");
    });

    void loadFans();
  }
</script>

<style>

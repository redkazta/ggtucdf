    text-transform: uppercase;
    text-align: center;
  }
  .state--error {
    flex-direction: column;
    gap: 0.35rem;
    border-left: 3px solid var(--accent);
    color: var(--accent-bright);
    text-align: left;
  }
  .state__title {
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .state__hint {
    color: var(--text-muted);
    letter-spacing: 0.02em;

---
import { dropConfig } from "../data/dropConfig";

const { showCountdown, nextDropName, nextDropDate, latestReleaseName, latestReleaseUrl } =
  dropConfig;

const targetTime = nextDropDate ? Date.parse(nextDropDate) : Number.NaN;
const hasCountdown =
  showCountdown && Number.isFinite(targetTime) && targetTime > Date.now();
---

<div
  class="drop-countdown"
  id="dropCountdown"
  data-show={String(hasCountdown)}
  data-target={nextDropDate ?? ""}
>
  <div class="latest-drop" data-latest hidden={hasCountdown}>
    <span class="countdown-label">ÚLTIMO DROP</span>
    <a
      href={latestReleaseUrl}
      target="_blank"
      rel="noopener"
      class="latest-drop-link"
      data-latest-link
    >
      <span data-latest-name>{latestReleaseName}</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>

  <div class="countdown-content" data-countdown hidden={!hasCountdown}>
    <div class="countdown-header">
      <span class="countdown-label">PRÓXIMO DROP</span>
      <h2 class="countdown-title" data-next-name>{nextDropName}</h2>
    </div>
    <div class="countdown-timer" id="countdownTimer" role="timer">
      <div class="countdown-unit">
        <span class="countdown-value" id="days">00</span>
        <span class="countdown-unit-label">DÍAS</span>
      </div>
      <span class="countdown-separator">:</span>
      <div class="countdown-unit">
        <span class="countdown-value" id="hours">00</span>
        <span class="countdown-unit-label">HRS</span>
      </div>
      <span class="countdown-separator">:</span>
      <div class="countdown-unit">
        <span class="countdown-value" id="minutes">00</span>
        <span class="countdown-unit-label">MIN</span>
      </div>
      <span class="countdown-separator">:</span>
      <div class="countdown-unit">
        <span class="countdown-value" id="seconds">00</span>
        <span class="countdown-unit-label">SEG</span>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById("dropCountdown");

  if (root) {
    const latest = root.querySelector("[data-latest]");
    const latestLink = root.querySelector("[data-latest-link]");
    const latestName = root.querySelector("[data-latest-name]");
    const countdown = root.querySelector("[data-countdown]");
    const nextName = root.querySelector("[data-next-name]");
    const countdownLabel = root.querySelector("[data-countdown] .countdown-label");

    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");

    let intervalId = 0;

    const setText = (element, value) => {
      if (element) element.textContent = String(value).padStart(2, "0");
    };

    const setVisible = (element, visible) => {
      if (element) element.hidden = !visible;
    };

    const stopTimer = () => {
      if (intervalId) {
        window.clearInterval(intervalId);
        intervalId = 0;
      }
    };

    const updateCountdown = (target) => {
      const diff = target - Date.now();

      if (diff <= 0) {
        stopTimer();
        setText(daysEl, 0);
        setText(hoursEl, 0);
        setText(minutesEl, 0);
        setText(secondsEl, 0);
        if (countdownLabel) countdownLabel.textContent = "DROP DISPONIBLE";
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      setText(daysEl, days);
      setText(hoursEl, hours);
      setText(minutesEl, minutes);
      setText(secondsEl, seconds);
    };

    const applySettings = (settings) => {
      if (!settings || typeof settings !== "object") return;

      if (
        typeof settings.latestReleaseName === "string" &&
        settings.latestReleaseName.trim() &&
        latestName
      ) {
        latestName.textContent = settings.latestReleaseName.trim();
      }

      if (typeof settings.latestReleaseUrl === "string" && latestLink) {
        try {
          const url = new URL(settings.latestReleaseUrl);
          if (url.protocol === "http:" || url.protocol === "https:") {
            latestLink.href = url.href;
          }
        } catch {
          // Keep the fallback link when the stored URL is invalid.
        }
      }

      if (typeof settings.nextDropName === "string" && nextName) {
        nextName.textContent = settings.nextDropName.trim();
      }

      const target =
        typeof settings.nextDropDate === "string"
          ? Date.parse(settings.nextDropDate)
          : Number.NaN;
      const show =
        Boolean(settings.showCountdown) &&
        Number.isFinite(target) &&
        target > Date.now();

      root.dataset.show = String(show);
      root.dataset.target =
        typeof settings.nextDropDate === "string" ? settings.nextDropDate : "";

      stopTimer();
      setVisible(latest, !show);
      setVisible(countdown, show);

      if (show) {
        if (countdownLabel) countdownLabel.textContent = "PRÓXIMO DROP";
        updateCountdown(target);
        intervalId = window.setInterval(() => updateCountdown(target), 1000);
      }
    };

    const initialTarget = Date.parse(root.dataset.target || "");
    if (root.dataset.show === "true" && Number.isFinite(initialTarget)) {
      updateCountdown(initialTarget);
      intervalId = window.setInterval(() => updateCountdown(initialTarget), 1000);
    }

    fetch("/api/drop-config", {
      headers: { Accept: "application/json" },
      cache: "no-store",
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((settings) => {
        if (settings) applySettings(settings);
      })
      .catch((error) => {
        console.warn("[DropCountdown] Usando configuración local:", error);
      });
  }
</script>

<style>
  .drop-countdown {
    padding: 1.5rem;
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      rgba(255, 50, 50, 0.1) 0%,
      rgba(255, 50, 50, 0.02) 100%
    );
    border: 1px solid rgba(255, 50, 50, 0.2);
    text-align: center;
  }
  .drop-countdown [hidden] {
    display: none !important;
  }
  .countdown-header {
    margin-bottom: 1rem;
  }
  .countdown-label {
    display: block;
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: rgba(255, 50, 50, 0.8);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .countdown-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .countdown-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 50px;
  }
  .countdown-value {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: #fff;
    line-height: 1;
  }
  .countdown-unit-label {
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    margin-top: 0.2rem;
  }
  .countdown-separator {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: rgba(255, 50, 50, 0.6);
    line-height: 1;
  }
  .latest-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .latest-drop-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.2s;
  }
  .latest-drop-link:hover {
    color: #ff3333;
  }
  .latest-drop-link svg {
    flex-shrink: 0;
  }
</style>

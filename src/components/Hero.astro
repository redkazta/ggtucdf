---
export interface Props {
  videoUrl: string;
  title: string;
  subtitle?: string;
  tagline?: string;
}

const {
  videoUrl,
  title,
  subtitle = "TIENE UN CHINGO DE FERIA",
  tagline = "Música urbana desde Guadalajara, México.",
} = Astro.props;
---

<section class="hero" id="hero-root" aria-label="Portada">
  <div class="hero__video-wrap" aria-hidden="true">
    <video
      id="hero-video"
      class="hero__video"
      muted
      loop
      playsinline
      autoplay
      disablepictureinpicture
      preload="metadata"
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span> Nuevo drop / disponible ahora</p>

    <h1 class="hero__title">
      <span class="hero__title-main">{title}</span>
      <span class="hero__title-sub">{subtitle}</span>
    </h1>

    <p class="hero__tagline">{tagline}</p>

    <div class="hero__actions">
      <slot />
    </div>
  </div>
</section>

<script>
  (() => {
    const video = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (!video) return;

    let revealed = false;

    const reveal = () => {
      if (revealed) return;
      revealed = true;
      video.style.opacity = "1";
    };

    const play = () => {
      if (video.paused) video.play().catch(() => {});
    };

    if (video.readyState >= 1) {
      reveal();
      play();
    }

    video.addEventListener("loadeddata", reveal, { once: true });
    video.addEventListener("canplay", () => { reveal(); play(); }, { once: true });

    const interval = window.setInterval(() => {
      if (video.readyState >= 1 || video.currentTime > 0) {
        reveal();
        play();
        window.clearInterval(interval);
      }
    }, 300);

    window.setTimeout(() => {
      reveal();
      play();
      window.clearInterval(interval);
    }, 2000);
  })();
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #000000;
  }

  .hero__video-wrap {
    position: absolute;
    inset: 0;
  }

  .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.12) 38%, rgba(0, 0, 0, 0.9) 100%),
      radial-gradient(1000px 620px at 82% 4%, rgba(255, 35, 56, 0.18), transparent 62%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(6.5rem, 16vh, 10rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 8vh, 5.5rem);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 1.8vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent-glow);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    color: #ffffff;
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-shadow: 0 12px 60px rgba(0, 0, 0, 0.8);
  }

  .hero__title-main {
    font-size: clamp(3.5rem, 14vw, 9.5rem);
  }

  .hero__title-sub {
    font-size: clamp(1.05rem, 3.4vw, 2.3rem);
    letter-spacing: 0.08em;
    color: #ffffff;
    margin-top: 0.35rem;
    opacity: 1;
  }

  .hero__tagline {
    margin-top: 1.3rem;
    max-width: 46ch;
    color: #ffffff;
    font-size: clamp(0.92rem, 1.5vw, 1.1rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  :global(.hero__actions .btn) {
    flex: 1 1 auto;
  }

  @media (min-width: 640px) {
    :global(.hero__actions .btn) {
      flex: 0 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video { transition: none; }
    .hero__dot { box-shadow: none; }
  }
</style>

---
export interface Props {
  videoUrl: string;
}

const { videoUrl } = Astro.props;
---

<section class="hero" id="hero-root" aria-label="Portada">
  <div class="hero__media">
    <video
      id="hero-video"
      class="hero__video"
      muted
      loop
      playsinline
      autoplay
      disablepictureinpicture
      preload="metadata"
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  </div>

  <div class="hero__tint" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__frame" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <div class="hero__content">
    <slot />
  </div>
</section>

<script>
  (function () {
    const video = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (!video) return;

    let revealed = false;

    function reveal() {
      if (revealed) return;
      revealed = true;
      video.style.opacity = "1";
    }

    function attemptPlay() {
      if (video.paused) {
        video.play().catch(function () {});
      }
    }

    if (video.readyState >= 1) {
      reveal();
      attemptPlay();
    }

    video.addEventListener("loadedmetadata", function () { reveal(); attemptPlay(); }, { once: true });
    video.addEventListener("loadeddata", function () { reveal(); attemptPlay(); }, { once: true });
    video.addEventListener("canplay", function () { reveal(); attemptPlay(); }, { once: true });

    var checkInterval = setInterval(function () {
      if (video.readyState >= 1 || video.currentTime > 0) {
        reveal();
        attemptPlay();
        clearInterval(checkInterval);
      }
    }, 300);

    setTimeout(function () {
      reveal();
      attemptPlay();
      clearInterval(checkInterval);
    }, 2200);

    video.addEventListener("error", function () {
      console.error("[Hero] Video error", video.error);
      clearInterval(checkInterval);
    }, { once: true });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background: var(--bg);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero__video {
    position: absolute;
    inset: -2%;
    width: 104%;
    height: 104%;
    object-fit: cover;
    opacity: 0;
    filter: grayscale(1) contrast(1.22) brightness(0.58);
    transition: opacity 1.1s ease;
    animation: hero-drift 36s ease-in-out infinite alternate;
  }

  /* Tinte rojo + degradados para que la tipografía respire */
  .hero__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(7, 7, 8, 0.86) 0%, rgba(7, 7, 8, 0.2) 34%, rgba(7, 7, 8, 0.72) 78%, var(--bg) 100%),
      linear-gradient(90deg, rgba(7, 7, 8, 0.82) 0%, rgba(7, 7, 8, 0.15) 48%, rgba(7, 7, 8, 0.6) 100%),
      radial-gradient(70% 55% at 82% 18%, rgba(255, 35, 56, 0.34), transparent 66%);
    pointer-events: none;
  }
  .hero__tint::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: color;
    opacity: 0.16;
  }

  /* Retícula editorial */
  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      linear-gradient(180deg, var(--line-soft) 1px, transparent 1px);
    background-size: 25% 100%, 100% 25%;
    opacity: 0.55;
  }

  .hero__frame {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .hero__frame span {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--line-strong);
  }
  .hero__frame span:nth-child(1) { top: calc(var(--header-h) + 14px); left: 14px; border-right: 0; border-bottom: 0; }
  .hero__frame span:nth-child(2) { top: calc(var(--header-h) + 14px); right: 14px; border-left: 0; border-bottom: 0; }
  .hero__frame span:nth-child(3) { bottom: 14px; left: 14px; border-right: 0; border-top: 0; }
  .hero__frame span:nth-child(4) { bottom: 14px; right: 14px; border-left: 0; border-top: 0; }

  .hero__content {
    position: relative;
    z-index: 3;
    min-height: 100dvh;
  }

  @keyframes hero-drift {
    from { transform: scale(1) translate3d(0, 0, 0); }
    to { transform: scale(1.06) translate3d(-1.2%, -1%, 0); }
  }

  @media (min-width: 768px) {
    .hero__grid {
      background-size: 20% 100%, 100% 33.33%;
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video { animation: none; transition: none; }
  }
</style>

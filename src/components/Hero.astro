---
export interface Props {
  videoUrl: string;
  title: string;
  tagline?: string;
}

const { videoUrl, title, tagline = "Música urbana desde Guadalajara, México." } = Astro.props;
---

<section class="hero" id="hero-root" aria-label="Portada">
  <div class="hero__bg">
    <video
      class="hero__video"
      id="hero-video"
      muted
      loop
      playsinline
      autoplay
      disablepictureinpicture
      preload="metadata"
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__eyebrow">Rap · Trap · Ruido propio</div>
    <h1 class="hero__title" aria-label={title}>{title}</h1>
    <p class="hero__tagline">{tagline}</p>

    <div class="hero__actions">
      <a href="/musica" class="btn btn--primary">Escuchar música <span aria-hidden="true">→</span></a>
      <a href="/artista" class="btn btn--ghost">Conocer al artista <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  (() => {
    const video = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (!video) return;

    let revealed = false;

    function reveal() {
      if (revealed) return;
      revealed = true;
      video.style.opacity = "1";
    }

    function attemptPlay() {
      if (video.paused) {
        video.play().catch(() => {});
      }
    }

    if (video.readyState >= 1) {
      reveal();
      attemptPlay();
    }

    video.addEventListener("loadeddata", reveal, { once: true });
    video.addEventListener("canplay", reveal, { once: true });

    const checkInterval = window.setInterval(() => {
      if (video.readyState >= 1 || video.currentTime > 0) {
        reveal();
        attemptPlay();
        window.clearInterval(checkInterval);
      }
    }, 300);

    window.setTimeout(() => {
      reveal();
      attemptPlay();
      window.clearInterval(checkInterval);
    }, 2000);
  })();
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #000000;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.88) 100%),
      radial-gradient(1100px 620px at 80% 0%, rgba(255, 35, 56, 0.18), transparent 60%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(6rem, 14vh, 9rem) clamp(1.25rem, 5vw, 4rem) clamp(3.5rem, 9vh, 6rem);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    color: #ffffff;
    font-size: clamp(3.4rem, 13vw, 9.5rem);
    line-height: 0.84;
    letter-spacing: -0.02em;
    max-width: 12ch;
    text-shadow: 0 10px 60px rgba(0, 0, 0, 0.75);
  }

  .hero__tagline {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: #ffffff;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video { transition: none; }
  }
</style>

---
import { SPOTIFY_ARTIST_URL, YOUTUBE_URL } from "../data/siteConfig";
---

<footer class="page-footer">
  <div class="page-footer__divider" aria-hidden="true"></div>
  <div class="page-footer__links">
    <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="footer-link footer-link--spotify">
      <span class="footer-link__icon" aria-hidden="true">&#9836;</span>
      <span class="footer-link__text">Spotify</span>
    </a>
    <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="footer-link footer-link--youtube">
      <span class="footer-link__icon" aria-hidden="true">&#9654;</span>
      <span class="footer-link__text">YouTube</span>
    </a>
  </div>
  <p class="page-footer__copy">Gargut &mdash; Guadalajara, México</p>
</footer>

<style>
  .page-footer {
    padding: 2.75rem 1.25rem 2rem;
    text-align: center;
  }

  .page-footer__divider {
    width: 72px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--accent-line) 50%,
      transparent 100%
    );
    box-shadow: 0 0 14px -2px var(--accent-glow);
    margin: 0 auto 1.75rem;
  }

  .page-footer__links {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    -webkit-tap-highlight-color: transparent;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--text-soft);
  }
  .footer-link:hover {
    transform: translateY(-1px);
    border-color: var(--accent-line);
    color: var(--text);
    box-shadow: 0 0 28px -8px var(--accent-glow);
  }
  .footer-link:active { transform: scale(0.98); }

  .footer-link--spotify .footer-link__icon { color: #1db954; }
  .footer-link--youtube .footer-link__icon { color: var(--accent-bright); }

  .footer-link__icon {
    font-size: 0.8rem;
    line-height: 1;
    filter: drop-shadow(0 0 8px currentColor);
  }

  .page-footer__copy {
    font-family: var(--font-body);
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .page-footer { padding: 3.25rem 2.5rem 2rem; }
    .footer-link { font-size: 0.95rem; padding: 0.65rem 1.35rem; }
  }
</style>

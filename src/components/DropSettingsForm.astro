---
import { toDatetimeLocalValue, type DropSettings } from "../lib/dropSettings";

interface Props {
  settings: DropSettings;
  configured: boolean;
  error?: string;
}

const { settings, configured, error } = Astro.props;
const nextDropValue = toDatetimeLocalValue(settings.nextDropDate);
const updatedAtLabel =
  settings.updatedAt && !Number.isNaN(Date.parse(settings.updatedAt))
    ? new Date(settings.updatedAt).toLocaleString("es-MX", {
        dateStyle: "short",
        timeStyle: "short",
        timeZone: "America/Mexico_City",
      })
    : null;
---

<section class="drop-settings" id="drop-settings" aria-labelledby="dropSettingsTitle">
  <div class="drop-settings-header">
    <div>
      <h2 id="dropSettingsTitle">Drop / ERP</h2>
      <p class="drop-settings-subtitle">
        Controla el último drop y el contador de <a href="/musica" target="_blank" rel="noopener">/musica</a>
        sin volver a desplegar.
      </p>
    </div>
    {updatedAtLabel ? <span class="drop-settings-updated">Actualizado: {updatedAtLabel}</span> : null}
  </div>

  {!configured ? (
    <p class="drop-settings-warning" role="alert">
      Supabase no está configurado. Agrega <code>PUBLIC_SUPABASE_URL</code> y
      <code>PRIVATE_SUPABASE_SERVICE_ROLE_KEY</code> para guardar estos ajustes.
    </p>
  ) : error ? (
    <p class="drop-settings-warning" role="alert">{error}</p>
  ) : null}

  <form id="dropSettingsForm" class="drop-settings-form" novalidate>
    <div class="drop-settings-grid">
      <label>
        <span>Último drop (nombre)</span>
        <input
          name="latestReleaseName"
          type="text"
          maxlength="120"
          required
          value={settings.latestReleaseName}
          disabled={!configured}
        />
      </label>

      <label>
        <span>Último drop (URL)</span>
        <input
          name="latestReleaseUrl"
          type="url"
          maxlength="500"
          required
          value={settings.latestReleaseUrl}
          disabled={!configured}
        />
      </label>

      <label>
        <span>Próximo drop (nombre)</span>
        <input
          name="nextDropName"
          type="text"
          maxlength="120"
          value={settings.nextDropName}
          disabled={!configured}
        />
      </label>

      <label>
        <span>Fecha del próximo drop</span>
        <input
          name="nextDropDate"
          type="datetime-local"
          value={nextDropValue}
          disabled={!configured}
        />
        <small>Hora de Guadalajara (UTC-6).</small>
      </label>
    </div>

    <label class="drop-settings-check">
      <input
        name="showCountdown"
        type="checkbox"
        checked={settings.showCountdown}
        disabled={!configured}
      />
      <span>
        Mostrar contador regresivo. Si está desactivado, /musica muestra el último drop.
      </span>
    </label>

    <div class="drop-settings-actions">
      <button type="submit" disabled={!configured}>Guardar ajustes</button>
      <a href="/musica" target="_blank" rel="noopener">Ver /musica</a>
    </div>

    <p id="dropSettingsMessage" class="drop-settings-message" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  const form = document.getElementById("dropSettingsForm");
  const message = document.getElementById("dropSettingsMessage");

  if (form && message) {
    const submitButton = form.querySelector('button[type="submit"]');
    const defaultText = submitButton?.textContent ?? "Guardar ajustes";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitButton || submitButton.disabled) return;

      const data = new FormData(form);
      const payload = {
        latestReleaseName: String(data.get("latestReleaseName") ?? "").trim(),
        latestReleaseUrl: String(data.get("latestReleaseUrl") ?? "").trim(),
        nextDropName: String(data.get("nextDropName") ?? "").trim(),
        nextDropDate: String(data.get("nextDropDate") ?? "").trim() || null,
        showCountdown: data.get("showCountdown") === "on",
      };

      submitButton.disabled = true;
      submitButton.textContent = "Guardando...";
      message.textContent = "";
      message.className = "drop-settings-message";

      try {
        const response = await fetch("/api/drop-settings", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          message.textContent =
            "Ajustes guardados. /musica se actualizará en menos de un minuto.";
          message.className = "drop-settings-message success";
        } else {
          message.textContent =
            result?.error ?? "No se pudieron guardar los ajustes.";
          message.className = "drop-settings-message error";
        }
      } catch (error) {
        console.error("[DropSettingsForm] Save failed:", error);
        message.textContent = "No se pudo conectar al servidor.";
        message.className = "drop-settings-message error";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = defaultText;
      }
    });
  }
</script>

<style>
  .drop-settings {
    position: relative;
    margin-bottom: 1.75rem;
    padding: 1.6rem 1.35rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background:
      radial-gradient(520px 220px at 100% 0%, rgba(225, 29, 46, 0.08), transparent 68%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.012) 100%);
    box-shadow: var(--shadow-deep);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
  }
  .drop-settings::before {
    content: "";
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-line), transparent);
  }

  .drop-settings-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .drop-settings h2 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .drop-settings-subtitle {
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .drop-settings-subtitle a {
    color: var(--accent-bright);
    text-underline-offset: 2px;
    text-decoration-color: var(--accent-line);
  }

  .drop-settings-updated {
    flex-shrink: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-dim);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .drop-settings-warning {
    margin-bottom: 1rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(225, 29, 46, 0.28);
    background: rgba(225, 29, 46, 0.07);
    color: #ffb3b9;
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .drop-settings-warning code {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.08rem 0.3rem;
    color: var(--text-soft);
  }

  .drop-settings-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .drop-settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .drop-settings label {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .drop-settings input[type="text"],
  .drop-settings input[type="url"],
  .drop-settings input[type="datetime-local"] {
    width: 100%;
    padding: 0.72rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.035);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.86rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }
  .drop-settings input::placeholder { color: var(--text-dim); }
  .drop-settings input:hover:not(:focus):not(:disabled) { border-color: var(--border-strong); }
  .drop-settings input:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    box-shadow:
      0 0 0 3px var(--accent-soft),
      0 0 24px -8px var(--accent-glow);
  }
  .drop-settings input:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .drop-settings small {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: 0.64rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .drop-settings-check {
    flex-direction: row !important;
    align-items: flex-start;
    gap: 0.55rem !important;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-muted) !important;
    font-family: var(--font-body) !important;
    font-size: 0.76rem !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    line-height: 1.55;
    cursor: pointer;
  }
  .drop-settings-check input {
    width: auto;
    margin-top: 0.12rem;
    accent-color: var(--accent);
  }

  .drop-settings-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .drop-settings-actions button {
    padding: 0.78rem 1.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: linear-gradient(135deg, var(--accent-bright) 0%, var(--accent) 48%, var(--accent-deep) 100%);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow:
      0 16px 34px -16px var(--accent-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.2s ease, box-shadow 0.3s ease, background 0.3s ease, opacity 0.2s;
  }
  .drop-settings-actions button:hover:not(:disabled) {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #ff5563 0%, #ec2233 48%, #b31120 100%);
    box-shadow:
      0 22px 44px -16px var(--accent-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }
  .drop-settings-actions button:active:not(:disabled) { transform: scale(0.985); }
  .drop-settings-actions button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
  }

  .drop-settings-actions a {
    color: var(--text-muted);
    font-size: 0.74rem;
    text-underline-offset: 3px;
    text-decoration-color: var(--border-strong);
    transition: color 0.2s ease;
  }
  .drop-settings-actions a:hover {
    color: var(--accent-bright);
    text-decoration-color: var(--accent-line);
  }

  .drop-settings-message {
    min-height: 1.2rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .drop-settings-message.success { color: #4ade80; }
  .drop-settings-message.error { color: #ff6b76; }

  @media (min-width: 768px) {
    .drop-settings { padding: 1.85rem 1.75rem; }
  }

  @media (max-width: 640px) {
    .drop-settings-header { flex-direction: column; }
    .drop-settings-updated { white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drop-settings input,
    .drop-settings-actions button { transition: none; }
    .drop-settings-actions button:hover:not(:disabled) { transform: none; }
  }
</style>

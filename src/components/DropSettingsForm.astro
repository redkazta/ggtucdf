---
import { toDatetimeLocalValue, type DropSettings } from "../lib/dropSettings";

interface Props {
  settings: DropSettings;
  configured: boolean;
  error?: string;
}

const { settings, configured, error } = Astro.props;
const nextDropValue = toDatetimeLocalValue(settings.nextDropDate);
const updatedAtLabel =
  settings.updatedAt && !Number.isNaN(Date.parse(settings.updatedAt))
    ? new Date(settings.updatedAt).toLocaleString("es-MX", {
        dateStyle: "short",
        timeStyle: "short",
        timeZone: "America/Mexico_City",
      })
    : null;
---

<section class="drop-settings" id="drop-settings" aria-labelledby="dropSettingsTitle">
  <div class="panel-bar">
    <span>02 / Drop ERP</span>
    <span class="panel-bar__flag" data-state={configured ? "on" : "off"}>
      <i aria-hidden="true"></i>
      {configured ? "Conectado" : "Sin conexión"}
    </span>
  </div>

  <div class="settings-body">
    <div class="settings-head">
      <div>
        <h2 id="dropSettingsTitle">Control de drops</h2>
        <p class="drop-settings-subtitle">
          Edita el último drop y el contador de
          <a href="/musica" target="_blank" rel="noopener">/musica</a>
          sin volver a desplegar.
        </p>
      </div>
      {updatedAtLabel ? <span class="drop-settings-updated">Actualizado: {updatedAtLabel}</span> : null}
    </div>

    {!configured ? (
      <div class="drop-settings-warning" role="alert">
        <p>
          Supabase no está configurado. Agrega <code>PUBLIC_SUPABASE_URL</code> y
          <code>PRIVATE_SUPABASE_SERVICE_ROLE_KEY</code> en Vercel y vuelve a desplegar.
        </p>
      </div>
    ) : error ? (
      <div class="drop-settings-warning" role="alert">
        <p>{error}</p>
        <p class="drop-settings-warning__hint">
          Revisa que hayas ejecutado <code>supabase/drop_settings.sql</code> en el
          SQL Editor de Supabase y que la service role key sea la del proyecto
          correcto.
        </p>
      </div>
    ) : null}

    <form id="dropSettingsForm" class="drop-settings-form" novalidate>
      <div class="drop-settings-grid">
        <label>
          <span class="field-label"><i aria-hidden="true">01</i> Último drop (nombre)</span>
          <input
            name="latestReleaseName"
            type="text"
            maxlength="120"
            required
            value={settings.latestReleaseName}
            disabled={!configured}
          />
        </label>

        <label>
          <span class="field-label"><i aria-hidden="true">02</i> Último drop (URL)</span>
          <input
            name="latestReleaseUrl"
            type="url"
            maxlength="500"
            required
            value={settings.latestReleaseUrl}
            disabled={!configured}
          />
        </label>

        <label>
          <span class="field-label"><i aria-hidden="true">03</i> Próximo drop (nombre)</span>
          <input
            name="nextDropName"
            type="text"
            maxlength="120"
            value={settings.nextDropName}
            disabled={!configured}
          />
        </label>

        <label>
          <span class="field-label"><i aria-hidden="true">04</i> Fecha del próximo drop</span>
          <input
            name="nextDropDate"
            type="datetime-local"
            value={nextDropValue}
            disabled={!configured}
          />
          <small>Hora de Guadalajara (UTC-6).</small>
        </label>
      </div>

      <label class="drop-settings-check">
        <input
          name="showCountdown"
          type="checkbox"
          checked={settings.showCountdown}
          disabled={!configured}
        />
        <span>
          Mostrar contador regresivo. Si está desactivado, /musica muestra el último drop.
        </span>
      </label>

      <div class="drop-settings-actions">
        <button type="submit" disabled={!configured}>
          Guardar ajustes <span aria-hidden="true">→</span>
        </button>
        <a href="/musica" target="_blank" rel="noopener">Ver /musica ↗</a>
      </div>

      <p id="dropSettingsMessage" class="drop-settings-message" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("dropSettingsForm");
  const message = document.getElementById("dropSettingsMessage");

  if (form && message) {
    const submitButton = form.querySelector('button[type="submit"]');
    const defaultText = submitButton?.textContent ?? "Guardar ajustes";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitButton || submitButton.disabled) return;

      const data = new FormData(form);
      const payload = {
        latestReleaseName: String(data.get("latestReleaseName") ?? "").trim(),
        latestReleaseUrl: String(data.get("latestReleaseUrl") ?? "").trim(),
        nextDropName: String(data.get("nextDropName") ?? "").trim(),
        nextDropDate: String(data.get("nextDropDate") ?? "").trim() || null,
        showCountdown: data.get("showCountdown") === "on",
      };

      submitButton.disabled = true;
      submitButton.textContent = "Guardando...";
      message.textContent = "";
      message.className = "drop-settings-message";

      try {
        const response = await fetch("/api/drop-settings", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          message.textContent =
            "Ajustes guardados. /musica se actualizará en menos de un minuto.";
          message.className = "drop-settings-message success";
        } else {
          message.textContent =
            result?.error ?? "No se pudieron guardar los ajustes.";
          message.className = "drop-settings-message error";
        }
      } catch (error) {
        console.error("[DropSettingsForm] Save failed:", error);
        message.textContent = "No se pudo conectar al servidor.";
        message.className = "drop-settings-message error";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = defaultText;
      }
    });
  }
</script>

<style>
  .drop-settings {
    margin-bottom: 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg-soft));
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.45);
  }

  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .panel-bar__flag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #ffffff;
  }
  .panel-bar__flag i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ddc73;
  }
  .panel-bar__flag[data-state="off"] i { background: #ffffff; }

  .settings-body {
    padding: clamp(1.15rem, 3vw, 1.6rem);
  }

  .settings-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .drop-settings h2 {
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .drop-settings-subtitle {
    color: var(--ink);
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .drop-settings-subtitle a {
    color: var(--ink);
    text-underline-offset: 2px;
    text-decoration-color: var(--accent);
  }

  .drop-settings-updated {
    flex-shrink: 0;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }

  .drop-settings-warning {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--accent-line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.7;
  }
  .drop-settings-warning__hint { color: var(--ink); }
  .drop-settings-warning code {
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink);
  }

  .drop-settings-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .drop-settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .drop-settings label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .field-label i {
    font-style: normal;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .drop-settings input[type="text"],
  .drop-settings input[type="url"],
  .drop-settings input[type="datetime-local"] {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.88rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .drop-settings input::placeholder { color: var(--ink); opacity: 0.55; }
  .drop-settings input:hover:not(:focus):not(:disabled) { border-color: var(--line-strong); }
  .drop-settings input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--bg-elevated);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .drop-settings input:disabled {
    opacity: 1;
    background: var(--bg-elevated);
    color: var(--ink);
    cursor: not-allowed;
  }

  .drop-settings small {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .drop-settings-check {
    flex-direction: row !important;
    align-items: flex-start;
    gap: 0.6rem !important;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink) !important;
    font-family: var(--font-mono) !important;
    font-size: 0.62rem !important;
    letter-spacing: 0.02em !important;
    text-transform: none !important;
    line-height: 1.7;
    cursor: pointer;
  }
  .drop-settings-check input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 0.1rem;
    border-radius: 4px;
    accent-color: var(--accent);
  }

  .drop-settings-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .drop-settings-actions button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.95rem 1.1rem;
    border-radius: 12px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 14px 34px rgba(255, 35, 56, 0.3);
    transition: transform 0.16s ease, background 0.18s ease, box-shadow 0.16s ease;
  }
  .drop-settings-actions button:hover:not(:disabled) {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(255, 35, 56, 0.4);
  }
  .drop-settings-actions button:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: none;
  }
  .drop-settings-actions button:disabled {
    opacity: 1;
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    color: #ffffff;
    cursor: not-allowed;
    box-shadow: none;
  }

  .drop-settings-actions a {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
    transition: color 0.18s ease;
  }
  .drop-settings-actions a:hover { color: var(--accent); }

  .drop-settings-message {
    min-height: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.7;
  }
  .drop-settings-message.success { color: var(--success); }
  .drop-settings-message.error { color: var(--accent-bright); }

  @media (max-width: 640px) {
    .settings-head { flex-direction: column; }
    .drop-settings-updated { white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drop-settings input,
    .drop-settings-actions button { transition: none; }
    .drop-settings-actions button:hover:not(:disabled) { transform: none; }
  }
</style>

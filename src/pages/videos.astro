---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";

const featured = [
  {
    title: "FENTATRIP",
    type: "youtube",
    id: "txWFWxLmix0",
    tag: "La Rola Main",
  },
  {
    title: "¿Qué es el FENTATRIP?",
    type: "instagram",
    id: "DZByY6CRlAX",
    tag: "El Contexto",
  },
];

const youtubeVideos = [
  { title: "Gargut - Experiencia Espiritual X @zacklyvibes", id: "NdQbpB4QggQ" },
  { title: "Gargut - Yo te kiero solo X @buzk09", id: "lVGN_fBoaOU" },
  { title: "Gargut - El Primer Artista", id: "IpWeeG1wiBE" },
  { title: "Gargut - Soy Artista o Eso Parece ft @zacklyvibes & @skydemongoat", id: "n0C4dFKB-Ks" },
  { title: "Artesania", id: "C5DVwAUr2Go" },
];

const instagramReels = [
  { title: "Primera experiencia espiritual", id: "DYfkaP8SFNK" },
  { title: "Fentatrip llega a Tijuana", id: "DZdTgeEyP-O" },
  { title: "", id: "DWuDsQukspP" },
  { title: "", id: "DZvgoINyut4" },
  { title: "", id: "DZdAZEUqNRb" },
  { title: "", id: "DZaiV0GKylR" },
];

const youtubeEmbed = (id: string) => `https://www.youtube.com/embed/${id}`;
const igEmbed = (id: string) => `https://www.instagram.com/p/${id}/embed/`;
---

<ArtistLayout title="Videos" description="Videos oficiales de Garguttieneunchingodeferia — YouTube, Instagram y TikTok.">
  <div class="videos-page">
    <header class="page-head">
      <span class="eyebrow">Gargut / Visuales</span>
      <h1 class="page-title">Videos</h1>
    </header>

    <!-- DESTACADOS -->
    <section class="featured-section" aria-label="Destacados">
      <span class="section-eyebrow">01 / Destacados</span>
      <div class="featured-grid">
        {featured.map((item) => (
          <div class={`featured-card ${item.type === "youtube" ? "featured-card--youtube" : "featured-card--ig"}`}>
            <div class="featured-card__tag">{item.tag}</div>
            <div class={`featured-card__embed-wrap ${item.type === "instagram" ? "featured-card__embed-wrap--reel" : ""}`}>
              <iframe
                class="featured-card__iframe"
                src={item.type === "youtube" ? youtubeEmbed(item.id) : igEmbed(item.id)}
                title={item.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            <h2 class="featured-card__title">{item.title}</h2>
          </div>
        ))}
      </div>
    </section>

    <!-- YOUTUBE -->
    <section class="video-section" aria-label="YouTube">
      <span class="section-eyebrow">02 / YouTube</span>
      <h2 class="section-headline">Videos Oficiales</h2>
      <div class="video-grid">
        {youtubeVideos.map((v) => (
          <div class="video-card">
            <div class="video-card__embed-wrap">
              <iframe
                class="video-card__iframe"
                src={youtubeEmbed(v.id)}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            <h3 class="video-card__title">{v.title}</h3>
          </div>
        ))}
      </div>
    </section>

    <!-- INSTAGRAM -->
    <section class="video-section" aria-label="Instagram Reels">
      <span class="section-eyebrow">03 / Instagram</span>
      <h2 class="section-headline">Reels</h2>
      <div class="reel-grid">
        {instagramReels.map((r) => (
          <div class="reel-card">
            <div class="reel-card__embed-wrap">
              <iframe
                class="reel-card__iframe"
                src={igEmbed(r.id)}
                title={r.title || "Instagram Reel"}
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
              />
            </div>
            {r.title && <h3 class="reel-card__title">{r.title}</h3>}
          </div>
        ))}
      </div>
    </section>
  </div>

  <PageFooter />

  <style>
    .videos-page {
      padding: 2.5rem 1rem 3rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .page-head { margin-bottom: 2.5rem; }
    .eyebrow {
      display: block;
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      color: var(--accent-bright);
      text-transform: uppercase;
      margin-bottom: 0.45rem;
      opacity: 0.85;
    }

    .page-title {
      position: relative;
      font-family: var(--font-display);
      text-transform: uppercase;
      font-size: clamp(2rem, 6vw, 3.2rem);
      color: var(--text);
      letter-spacing: 0.04em;
      line-height: 0.95;
      padding-bottom: 0.65rem;
      text-shadow: 0 0 32px rgba(225, 29, 46, 0.25);
    }
    .page-title::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 64px;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    .section-eyebrow {
      display: block;
      font-family: var(--font-display);
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      color: var(--accent-bright);
      text-transform: uppercase;
      margin-bottom: 0.45rem;
      opacity: 0.8;
    }

    .section-headline {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 3vw, 1.7rem);
      color: var(--text);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1.35rem;
      line-height: 1;
    }
    .section-headline::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
    }

    .featured-section { margin-bottom: 3.25rem; }
    .featured-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .featured-card {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.012) 100%);
      box-shadow: 0 24px 60px -36px rgba(0, 0, 0, 0.95);
      transition: transform 0.25s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .featured-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent-line);
      box-shadow:
        0 30px 70px -36px rgba(0, 0, 0, 0.95),
        0 0 40px -14px var(--accent-glow);
    }
    .featured-card--youtube,
    .featured-card--ig { border-color: var(--border); }

    .featured-card__tag {
      position: absolute;
      top: 0.8rem;
      left: 0.8rem;
      z-index: 2;
      font-family: var(--font-display);
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent-bright), var(--accent-deep));
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 6px 20px -6px var(--accent-glow);
    }
    .featured-card__embed-wrap {
      position: relative;
      padding-bottom: 56.25%;
      background: #0a0a0c;
    }
    .featured-card__embed-wrap--reel { padding-bottom: 125%; }
    .featured-card__iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    .featured-card__title {
      font-family: var(--font-display);
      font-size: clamp(1rem, 2.5vw, 1.25rem);
      color: var(--text);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.95rem 1.1rem 0.75rem;
      line-height: 1.2;
    }

    .video-section { margin-bottom: 3.25rem; }
    .video-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .video-card {
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.01) 100%);
      transition: transform 0.2s ease, border-color 0.25s ease, box-shadow 0.3s ease;
    }
    .video-card:hover {
      transform: translateY(-3px);
      border-color: var(--accent-line);
      box-shadow: 0 24px 50px -30px rgba(0, 0, 0, 0.95), 0 0 30px -14px var(--accent-glow);
    }
    .video-card__embed-wrap {
      position: relative;
      padding-bottom: 56.25%;
      background: #0a0a0c;
    }
    .video-card__iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    .video-card__title {
      font-family: var(--font-display);
      font-size: 0.82rem;
      color: var(--text-soft);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.7rem 0.85rem 0.6rem;
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .reel-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
    .reel-card {
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 1px solid var(--border);
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.01) 100%);
      transition: transform 0.2s ease, border-color 0.25s ease, box-shadow 0.3s ease;
    }
    .reel-card:hover {
      transform: translateY(-3px);
      border-color: var(--accent-line);
      box-shadow: 0 0 30px -14px var(--accent-glow);
    }
    .reel-card__embed-wrap {
      position: relative;
      padding-bottom: 125%;
      background: #0a0a0c;
    }
    .reel-card__iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    .reel-card__title {
      font-family: var(--font-display);
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.55rem 0.65rem 0.45rem;
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    @media (min-width: 768px) {
      .videos-page { padding: 3rem 1.5rem 4rem; }
      .featured-grid { grid-template-columns: repeat(2, 1fr); align-items: start; gap: 1.5rem; }
      .video-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
      .reel-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
      .video-card__title { font-size: 0.88rem; }
    }

    @media (min-width: 1024px) {
      .video-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
      .reel-grid { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
      .featured-card__title { padding: 1.1rem 1.35rem 0.85rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .featured-card, .video-card, .reel-card { transition: none; }
      .featured-card:hover,
      .video-card:hover,
      .reel-card:hover { transform: none; }
    }
  </style>
---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import { INSTAGRAM_URL, YOUTUBE_URL } from "../data/siteConfig";

const youtubeVideos = [
  { title: "FENTATRIP", id: "txWFWxLmix0" },
  { title: "Gargut - Experiencia Espiritual X @zacklyvibes", id: "NdQbpB4QggQ" },
  { title: "Gargut - Yo te kiero solo X @buzk09", id: "lVGN_fBoaOU" },
  { title: "Gargut - El Primer Artista", id: "IpWeeG1wiBE" },
  { title: "Gargut - Soy Artista o Eso Parece ft @zacklyvibes & @skydemongoat", id: "n0C4dFKB-Ks" },
  { title: "Artesania", id: "C5DVwAUr2Go" },
];

const instagramReels = [
  { title: "Primera experiencia espiritual", id: "DYfkaP8SFNK" },
  { title: "Fentatrip llega a Tijuana", id: "DZdTgeEyP-O" },
  { title: "", id: "DWuDsQukspP" },
  { title: "", id: "DZvgoINyut4" },
  { title: "", id: "DZdAZEUqNRb" },
  { title: "", id: "DZaiV0GKylR" },
];

const youtubeEmbed = (id: string) => `https://www.youtube.com/embed/${id}`;
---

<ArtistLayout
  title="Videos"
  description="Videos oficiales de Garguttieneunchingodeferia — YouTube, Instagram y TikTok."
  theme="red"
  board
>
  <div class="board-page">
    <header class="board-head">
      <h1 class="board-head__title">Videos<span aria-hidden="true">*</span></h1>
      <div class="board-head__meta">
        <span><b>{youtubeVideos.length}</b> videos</span>
        <span><b>{instagramReels.length}</b> reels</span>
        <span>YouTube / Instagram</span>
        <span><a href={YOUTUBE_URL} target="_blank" rel="noopener">Canal ↗</a></span>
      </div>
    </header>

    <div class="board-grid video-board">
      <section class="board-panel console-panel">
        <div class="board-panel__head">
          <span>Consola de video</span>
          <span>Playlist / YouTube</span>
        </div>
        <div class="board-panel__body board-panel__body--flush console-panel__body">
          <div class="video-console">
            <div class="video-console__screen">
              <div class="video-console__frame">
                <iframe
                  id="videoMain"
                  src={youtubeEmbed(youtubeVideos[0].id)}
                  title={youtubeVideos[0].title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
              <div class="video-console__now">
                <div>
                  <span class="video-console__label">Ahora suena</span>
                  <h2 id="videoNow">{youtubeVideos[0].title}</h2>
                </div>
                <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="video-console__link">
                  YouTube <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <ol class="playlist">
              {youtubeVideos.map((video, i) => (
                <li>
                  <button
                    type="button"
                    class:list={["playlist__item", { "is-active": i === 0 }]}
                    data-video-id={video.id}
                    data-video-title={video.title}
                    aria-label={`Reproducir ${video.title}`}
                  >
                    <span class="playlist__num">{String(i + 1).padStart(2, "0")}</span>
                    <span class="playlist__title">{video.title}</span>
                    <span class="playlist__arrow" aria-hidden="true">▶</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section class="board-panel reels-panel">
        <div class="board-panel__head">
          <span>Reels / Instagram</span>
          <span><a href={INSTAGRAM_URL} target="_blank" rel="noopener">Ver IG ↗</a></span>
        </div>
        <div class="board-panel__body board-panel__body--flush reels-panel__body">
          <div class="reel-strip">
            {instagramReels.map((reel, i) => (
              <a
                class="reel-tile"
                href={INSTAGRAM_URL}
                target="_blank"
                rel="noopener"
                aria-label={reel.title ? `Ver reel: ${reel.title}` : "Ver el Instagram de Gargut"}
              >
                <span class="reel-tile__index">{String(i + 1).padStart(2, "0")}</span>
                <span class="reel-tile__grid" aria-hidden="true"></span>
                <span class="reel-tile__word">Reel</span>
                <span class="reel-tile__title">{reel.title || "Ver en Instagram"}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</ArtistLayout>

<script>
  const player = document.getElementById("videoMain") as HTMLIFrameElement | null;
  const nowTitle = document.getElementById("videoNow");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-video-id]"));

  if (player && nowTitle && buttons.length > 0) {
    const activate = (button: HTMLButtonElement) => {
      const id = button.dataset.videoId;
      const title = button.dataset.videoTitle ?? "Video";
      if (!id) return;

      player.src = `https://www.youtube.com/embed/${id}`;
      player.title = title;
      nowTitle.textContent = title;

      buttons.forEach((item) => {
        item.classList.toggle("is-active", item === button);
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => activate(button));
    });
  }
</script>

<style>
  .video-board {
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1.35fr) minmax(0, 0.65fr);
  }
  .console-panel { grid-row: 1; }
  .reels-panel { grid-row: 2; }

  .console-panel__body { display: flex; min-height: 0; }
  .video-console {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    min-height: 0;
    background: #000000;
  }
  .video-console__screen { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .video-console__frame {
    position: relative;
    flex: 1;
    min-height: 0;
    background: #050000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }
  .video-console__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .video-console__now {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.6rem 0.8rem;
  }
  .video-console__label {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .video-console__now h2 {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2.2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    color: #ffffff;
  }
  .video-console__link {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
    white-space: nowrap;
  }

  .playlist { display: flex; flex-direction: column; list-style: none; overflow: auto; min-height: 0; border-top: 1px solid rgba(255, 255, 255, 0.2); }
  .playlist li { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .playlist li:last-child { border-bottom: 0; }
  .playlist__item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.46rem 0.6rem;
    border: 0;
    background: transparent;
    color: #ffffff;
    text-align: left;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .playlist__num { font-family: var(--font-display); font-size: 0.8rem; color: var(--accent); }
  .playlist__title {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .playlist__arrow { font-size: 0.5rem; color: var(--accent); }
  .playlist__item:hover { background: #ffffff; color: #000000; }
  .playlist__item:hover .playlist__num,
  .playlist__item:hover .playlist__arrow { color: #000000; }
  .playlist__item.is-active { background: var(--accent); color: #ffffff; }
  .playlist__item.is-active .playlist__num,
  .playlist__item.is-active .playlist__arrow { color: #ffffff; }

  .reels-panel__body { display: flex; min-height: 0; }
  .reel-strip {
    display: flex;
    gap: 0.6rem;
    width: 100%;
    min-height: 0;
    overflow-x: auto;
    padding: 0.6rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
  }
  .reel-tile {
    position: relative;
    flex: 0 0 auto;
    height: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.6rem;
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 50% 25%, rgba(255, 35, 56, 0.25), transparent 70%),
      #000000;
    border: 1px solid var(--accent);
    text-decoration: none;
    color: #ffffff;
    scroll-snap-align: start;
  }
  .reel-tile__index {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.46rem;
    font-weight: 700;
  }
  .reel-tile__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.4;
  }
  .reel-tile__word,
  .reel-tile__title { position: relative; }
  .reel-tile__word { font-family: var(--font-display); font-size: 1.4rem; line-height: 1; text-transform: uppercase; }
  .reel-tile__title {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.46rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .reel-tile:hover { background: var(--accent); }
  .reel-tile:hover .reel-tile__grid { opacity: 0.15; }

  @media (min-width: 760px) {
    .video-console { grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.85fr); }
    .playlist { border-top: 0; border-left: 1px solid rgba(255, 255, 255, 0.2); }
  }

  @media (max-width: 900px) {
    .video-board {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1.5fr) minmax(0, 0.5fr);
      overflow: hidden;
    }
    .video-console {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .video-console__frame { aspect-ratio: auto; flex: 1; }
    .video-console__now { gap: 0.2rem 0.5rem; padding: 0.3rem 0.5rem; }
    .video-console__label { margin-bottom: 0.1rem; font-size: 0.4rem; }
    .video-console__now h2 { font-size: 0.85rem; }
    .video-console__link { font-size: 0.42rem; }
    .playlist {
      flex: 0 0 auto;
      overflow: hidden;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      border-left: 0;
    }
    .playlist__item { grid-template-columns: 1.1rem minmax(0, 1fr) auto; gap: 0.3rem; padding: 0.22rem 0.4rem; }
    .playlist__num { font-size: 0.58rem; }
    .playlist__title { font-size: 0.38rem; line-height: 1.25; }
    .playlist__arrow { font-size: 0.4rem; }

    .reels-panel__body { padding: 0; }
    .reel-strip {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.3rem;
      padding: 0.35rem;
      overflow: hidden;
    }
    .reel-tile {
      flex: none;
      width: 100%;
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
      padding: 0.3rem;
    }
    .reel-tile__index { top: 0.25rem; right: 0.25rem; font-size: 0.36rem; }
    .reel-tile__word { font-size: 0.78rem; }
    .reel-tile__title { display: none; }
  }
</style>

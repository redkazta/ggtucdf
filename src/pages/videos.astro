---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import { INSTAGRAM_URL } from "../data/siteConfig";

const featured = [
  {
    title: "FENTATRIP",
    type: "youtube",
    id: "txWFWxLmix0",
    tag: "La Rola Main",
  },
  {
    title: "¿Qué es el FENTATRIP?",
    type: "instagram",
    id: "DZByY6CRlAX",
    tag: "El Contexto",
  },
];

const youtubeVideos = [
  { title: "Gargut - Experiencia Espiritual X @zacklyvibes", id: "NdQbpB4QggQ" },
  { title: "Gargut - Yo te kiero solo X @buzk09", id: "lVGN_fBoaOU" },
  { title: "Gargut - El Primer Artista", id: "IpWeeG1wiBE" },
  { title: "Gargut - Soy Artista o Eso Parece ft @zacklyvibes & @skydemongoat", id: "n0C4dFKB-Ks" },
  { title: "Artesania", id: "C5DVwAUr2Go" },
];

const instagramReels = [
  { title: "Primera experiencia espiritual", id: "DYfkaP8SFNK" },
  { title: "Fentatrip llega a Tijuana", id: "DZdTgeEyP-O" },
  { title: "", id: "DWuDsQukspP" },
  { title: "", id: "DZvgoINyut4" },
  { title: "", id: "DZdAZEUqNRb" },
  { title: "", id: "DZaiV0GKylR" },
];

const youtubeEmbed = (id: string) => `https://www.youtube.com/embed/${id}`;
---

<ArtistLayout title="Videos" description="Videos oficiales de Garguttieneunchingodeferia — YouTube, Instagram y TikTok.">
  <div class="videos-page">
    <header class="page-head">
      <div class="page-head__meta">
        <span class="kicker">03 / Visuales</span>
        <span class="page-head__count">YouTube / Instagram</span>
      </div>
      <h1 class="page-title page-title--xl">Videos<span aria-hidden="true">*</span></h1>
      <p class="page-head__lead">
        Clips, reels y experimentos visuales. La imagen también suena.
      </p>
    </header>

    <!-- DESTACADOS -->
    <section class="featured-section" aria-label="Destacados">
      <div class="section-bar">
        <h2>Destacados</h2>
        <span>01 / Selección</span>
      </div>
      <div class="featured-grid">
        {featured.map((item, i) => (
          <article class={`featured-card ${item.type === "youtube" ? "featured-card--youtube" : "featured-card--ig"}`}>
            <div class="featured-card__embed-wrap">
              {item.type === "youtube" ? (
                <iframe
                  class="featured-card__iframe"
                  src={youtubeEmbed(item.id)}
                  title={item.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <a
                  class="ig-feature"
                  href={INSTAGRAM_URL}
                  target="_blank"
                  rel="noopener"
                  aria-label="Ver el Instagram de Gargut"
                >
                  <span class="ig-feature__grid" aria-hidden="true"></span>
                  <span class="ig-feature__eyebrow">Instagram / Reels</span>
                  <span class="ig-feature__word">Instagram</span>
                  <span class="ig-feature__cta">Ver visuales <span aria-hidden="true">↗</span></span>
                </a>
              )}
              <span class="featured-card__tag">{item.tag}</span>
              <span class="featured-card__index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h2 class="featured-card__title">{item.title}</h2>
          </article>
        ))}
      </div>
    </section>

    <!-- YOUTUBE -->
    <section class="video-section" aria-label="YouTube">
      <div class="section-bar">
        <h2>Videos oficiales</h2>
        <span>02 / YouTube</span>
      </div>
      <div class="video-grid">
        {youtubeVideos.map((v, i) => (
          <article class="video-card">
            <div class="video-card__embed-wrap">
              <iframe
                class="video-card__iframe"
                src={youtubeEmbed(v.id)}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
              <span class="video-card__index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="video-card__title">{v.title}</h3>
          </article>
        ))}
      </div>
    </section>

    <!-- INSTAGRAM -->
    <section class="video-section" aria-label="Instagram Reels">
      <div class="section-bar">
        <h2>Reels</h2>
        <span>03 / Instagram</span>
      </div>
      <div class="reel-grid">
        {instagramReels.map((r, i) => (
          <article class="reel-card">
            <div class="reel-card__embed-wrap">
              <a
                class="ig-feature"
                href={INSTAGRAM_URL}
                target="_blank"
                rel="noopener"
                aria-label="Ver el Instagram de Gargut"
              >
                <span class="ig-feature__grid" aria-hidden="true"></span>
                <span class="ig-feature__eyebrow">Instagram</span>
                <span class="ig-feature__word">Reels</span>
                <span class="ig-feature__cta">Ver más <span aria-hidden="true">↗</span></span>
              </a>
              <span class="reel-card__index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            {r.title && <h3 class="reel-card__title">{r.title}</h3>}
          </article>
        ))}
      </div>
    </section>
  </div>

  <PageFooter />
</ArtistLayout>

<style>
  .videos-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .page-head {
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .page-head__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .page-head__count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .page-title--xl {
    display: flex;
    align-items: flex-start;
    gap: 0.1em;
    font-size: clamp(4rem, 19vw, 11rem);
    line-height: 0.78;
    letter-spacing: -0.02em;
  }
  .page-title--xl span {
    font-family: var(--font-mono);
    font-size: 0.16em;
    line-height: 1;
    margin-top: 0.25em;
    color: var(--accent);
    letter-spacing: 0;
  }
  .page-head__lead {
    max-width: 460px;
    margin-top: 1.2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .section-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .section-bar h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 6vw, 2.7rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .section-bar span {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .featured-section { margin-bottom: 3rem; }
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .featured-card,
  .video-card,
  .reel-card {
    border: 1px solid var(--line);
    background: var(--bg-soft);
    transition: transform 0.16s ease, border-color 0.2s ease, box-shadow 0.16s ease;
  }
  .featured-card:hover,
  .video-card:hover,
  .reel-card:hover {
    transform: translate(-3px, -3px);
    border-color: var(--accent);
    box-shadow: 6px 6px 0 var(--accent);
  }

  .featured-card__embed-wrap,
  .video-card__embed-wrap,
  .reel-card__embed-wrap {
    position: relative;
    background: var(--bg);
  }
  .featured-card__embed-wrap { padding-bottom: 56.25%; }
  .featured-card__embed-wrap--reel { padding-bottom: 125%; }
  .video-card__embed-wrap { padding-bottom: 56.25%; }
  .reel-card__embed-wrap { padding-bottom: 125%; }

  .featured-card__iframe,
  .video-card__iframe,
  .reel-card__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.18) contrast(1.04);
    transition: filter 0.3s ease;
  }
  .featured-card:hover .featured-card__iframe,
  .video-card:hover .video-card__iframe,
  .reel-card:hover .reel-card__iframe {
    filter: grayscale(0) contrast(1.02);
  }

  .ig-feature {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.2rem;
    text-decoration: none;
    color: var(--ink);
    background:
      radial-gradient(220px 140px at 50% 30%, rgba(255, 35, 56, 0.16), transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--line);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .ig-feature:hover { background: var(--accent-soft); border-color: var(--accent); }
  .ig-feature__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      linear-gradient(180deg, var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.5;
  }
  .ig-feature__eyebrow {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .ig-feature__word {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 7vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ig-feature__cta {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .featured-card__tag,
  .featured-card__index,
  .video-card__index,
  .reel-card__index {
    position: absolute;
    z-index: 2;
    padding: 0.28rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
  }
  .featured-card__tag {
    top: 0;
    left: 0;
    background: var(--accent);
    color: #ffffff;
  }
  .featured-card__index,
  .video-card__index,
  .reel-card__index {
    top: 0;
    right: 0;
    background: var(--ink);
    color: var(--bg);
  }

  .featured-card__title,
  .video-card__title,
  .reel-card__title {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .featured-card__title {
    padding: 0.65rem 0.7rem 0.55rem;
    font-size: 1.15rem;
  }
  .video-card__title,
  .reel-card__title {
    padding: 0.55rem 0.6rem 0.45rem;
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .video-section { margin-bottom: 3rem; }
  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }
  .reel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (min-width: 640px) {
    .videos-page { padding: 2.5rem 1.5rem 4rem; }
    .featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .reel-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  }

  @media (min-width: 1024px) {
    .videos-page { padding: 3rem 2.25rem 5rem; }
    .video-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
    .reel-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.9rem; }
    .featured-card__title { font-size: 1.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card, .video-card, .reel-card,
    .featured-card__iframe, .video-card__iframe, .reel-card__iframe {
      transition: none;
    }
    .featured-card:hover,
    .video-card:hover,
    .reel-card:hover { transform: none; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import { INSTAGRAM_URL, YOUTUBE_URL } from "../data/siteConfig";

const featured = [
  {
    title: "FENTATRIP",
    type: "youtube",
    id: "txWFWxLmix0",
    tag: "La Rola Main",
  },
  {
    title: "¿Qué es el FENTATRIP?",
    type: "instagram",
    id: "DZByY6CRlAX",
    tag: "El Contexto",
  },
];

const youtubeVideos = [
  { title: "Gargut - Experiencia Espiritual X @zacklyvibes", id: "NdQbpB4QggQ" },
  { title: "Gargut - Yo te kiero solo X @buzk09", id: "lVGN_fBoaOU" },
  { title: "Gargut - El Primer Artista", id: "IpWeeG1wiBE" },
  { title: "Gargut - Soy Artista o Eso Parece ft @zacklyvibes & @skydemongoat", id: "n0C4dFKB-Ks" },
  { title: "Artesania", id: "C5DVwAUr2Go" },
];

const instagramReels = [
  { title: "Primera experiencia espiritual", id: "DYfkaP8SFNK" },
  { title: "Fentatrip llega a Tijuana", id: "DZdTgeEyP-O" },
  { title: "", id: "DWuDsQukspP" },
  { title: "", id: "DZvgoINyut4" },
  { title: "", id: "DZdAZEUqNRb" },
  { title: "", id: "DZaiV0GKylR" },
];

const youtubeEmbed = (id: string) => `https://www.youtube.com/embed/${id}`;
---

<ArtistLayout title="Videos" description="Videos oficiales de Garguttieneunchingodeferia — YouTube, Instagram y TikTok.">
  <div class="internal-shell videos-page">
    <header class="internal-hero">
      <div class="internal-hero__top">
        <span class="kicker">03 / Visuales</span>
        <span class="internal-hero__note">YouTube · Instagram · Reels</span>
      </div>

      <div class="video-hero">
        <div>
          <h1 class="internal-hero__title">Videos<span aria-hidden="true">*</span></h1>
          <p class="internal-hero__lead">
            Clips, reels y experimentos visuales. La imagen también suena.
          </p>
          <div class="internal-hero__actions">
            <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="btn btn--primary">
              Ver canal <span aria-hidden="true">↗</span>
            </a>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--outline">
              Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <dl class="video-stats">
          <div>
            <dt>Destacados</dt>
            <dd>{String(featured.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Videos</dt>
            <dd>{String(youtubeVideos.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Reels</dt>
            <dd>{String(instagramReels.length).padStart(2, "0")}</dd>
          </div>
        </dl>
      </div>
    </header>

    <section class="featured-section" aria-labelledby="featuredTitle">
      <div class="section-heading">
        <h2 id="featuredTitle">Destacados</h2>
        <span>01 / Selección</span>
      </div>

      <div class="featured-grid">
        {featured.map((item, i) => (
          <article class={`featured-card ${item.type === "youtube" ? "featured-card--youtube" : "featured-card--ig"}`}>
            <div class="media-frame">
              {item.type === "youtube" ? (
                <iframe
                  class="media-iframe"
                  src={youtubeEmbed(item.id)}
                  title={item.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <a
                  class="ig-feature"
                  href={INSTAGRAM_URL}
                  target="_blank"
                  rel="noopener"
                  aria-label="Ver el Instagram de Gargut"
                >
                  <span class="ig-feature__grid" aria-hidden="true"></span>
                  <span class="ig-feature__eyebrow">Instagram / Reels</span>
                  <span class="ig-feature__word">Instagram</span>
                  <span class="ig-feature__cta">Ver visuales <span aria-hidden="true">↗</span></span>
                </a>
              )}
              <span class="media-tag">{item.tag}</span>
              <span class="media-index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="featured-card__title">{item.title}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="video-section" aria-labelledby="youtubeTitle">
      <div class="section-heading">
        <h2 id="youtubeTitle">Videos oficiales</h2>
        <span>02 / YouTube</span>
      </div>
      <div class="video-grid">
        {youtubeVideos.map((v, i) => (
          <article class="video-card">
            <div class="media-frame">
              <iframe
                class="media-iframe"
                src={youtubeEmbed(v.id)}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
              <span class="media-index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="video-card__title">{v.title}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="video-section" aria-labelledby="reelsTitle">
      <div class="section-heading">
        <h2 id="reelsTitle">Reels</h2>
        <span>03 / Instagram</span>
      </div>
      <div class="reel-grid">
        {instagramReels.map((r, i) => (
          <article class="reel-card">
            <div class="media-frame media-frame--reel">
              <a
                class="ig-feature ig-feature--reel"
                href={INSTAGRAM_URL}
                target="_blank"
                rel="noopener"
                aria-label={r.title ? `Ver reel: ${r.title}` : "Ver el Instagram de Gargut"}
              >
                <span class="ig-feature__grid" aria-hidden="true"></span>
                <span class="ig-feature__eyebrow">Instagram</span>
                <span class="ig-feature__word">Reels</span>
                <span class="ig-feature__cta">Ver más <span aria-hidden="true">↗</span></span>
              </a>
              <span class="media-index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            {r.title && <h3 class="reel-card__title">{r.title}</h3>}
          </article>
        ))}
      </div>
    </section>

    <div class="videos-footer">
      <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="btn btn--outline">
        Ver todo en YouTube <span aria-hidden="true">↗</span>
      </a>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--outline">
        Ver todo en Instagram <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <PageFooter />
</ArtistLayout>

<style>
  .videos-page { padding-top: clamp(0.75rem, 2.5vw, 1.25rem); }

  .video-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: end;
  }

  .video-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
  }
  .video-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .video-stats dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
    color: #ffffff;
  }
  .video-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 2.1rem);
    line-height: 1;
    color: #ffffff;
  }

  /* Tarjetas de video */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .reel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .featured-card,
  .video-card,
  .reel-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg-soft));
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.42);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .featured-card:hover,
  .video-card:hover,
  .reel-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--accent);
  }

  .media-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #050506;
  }
  .media-frame--reel { aspect-ratio: 4 / 5; }

  .media-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.1) contrast(1.03);
    transition: filter 0.3s ease;
  }
  .featured-card:hover .media-iframe,
  .video-card:hover .media-iframe { filter: grayscale(0) contrast(1.02); }

  .media-tag,
  .media-index {
    position: absolute;
    z-index: 2;
    padding: 0.34rem 0.52rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
  }
  .media-tag {
    top: 0.6rem;
    left: 0.6rem;
    background: var(--accent);
    color: #ffffff;
  }
  .media-index {
    top: 0.6rem;
    right: 0.6rem;
    background: #ffffff;
    color: #000000;
  }

  .featured-card__title,
  .video-card__title,
  .reel-card__title {
    padding: 0.9rem 1rem 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1rem, 2.6vw, 1.3rem);
    line-height: 1.1;
    text-transform: uppercase;
    color: #ffffff;
  }
  .video-card__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Portada Instagram */
  .ig-feature {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.2rem;
    text-decoration: none;
    color: #ffffff;
    background:
      radial-gradient(220px 160px at 50% 28%, rgba(255, 35, 56, 0.28), transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01));
    transition: background 0.2s ease, color 0.2s ease;
  }
  .ig-feature__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }
  .ig-feature:hover {
    background: #ffffff;
    color: #000000;
  }
  .ig-feature:hover .ig-feature__grid { opacity: 0.12; }
  .ig-feature__eyebrow,
  .ig-feature__word,
  .ig-feature__cta { position: relative; z-index: 1; }
  .ig-feature__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: inherit;
  }
  .ig-feature__word {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 7vw, 2.8rem);
    line-height: 1;
    text-transform: uppercase;
    color: inherit;
  }
  .ig-feature__cta {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
  }
  .ig-feature--reel .ig-feature__word { font-size: clamp(1.4rem, 6vw, 2.1rem); }

  .videos-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 640px) {
    .featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reel-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  }

  @media (min-width: 900px) {
    .video-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 340px); }
    .video-stats { align-self: end; }
  }

  @media (min-width: 1024px) {
    .video-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
    .reel-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card,
    .video-card,
    .reel-card,
    .media-iframe,
    .ig-feature { transition: none; }
    .featured-card:hover,
    .video-card:hover,
    .reel-card:hover { transform: none; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import {
  DISCOGRAPHY,
  SPOTIFY_ARTIST_URL,
  INSTAGRAM_URL,
  YOUTUBE_URL,
  TIKTOK_URL,
  ARTIST_MONTHLY_LISTENERS,
  ARTIST_FOLLOWERS,
  ARTIST_TOP_TRACK,
  ARTIST_PORTRAIT_URL,
} from "../data/siteConfig";

const releases = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  const aStreams = a.streams ?? -1;
  const bStreams = b.streams ?? -1;
  if (aStreams !== bStreams) return bStreams - aStreams;
  return a.title.localeCompare(b.title);
});

const half = Math.ceil(releases.length / 2);
const releasesA = releases.slice(0, half);
const releasesB = releases.slice(half);
const firstYear = Math.min(...DISCOGRAPHY.map((track) => track.year));
const lastYear = Math.max(...DISCOGRAPHY.map((track) => track.year));

const formatPlays = (value?: number) =>
  typeof value === "number" && value > 0 ? value.toLocaleString("es-MX") : "—";

const cityFallback = [
  { city: "Ciudad de México", country: "MX", listeners: 614 },
  { city: "Guadalajara", country: "MX", listeners: 465 },
  { city: "Zapopan", country: "MX", listeners: 216 },
  { city: "Bogotá", country: "CO", listeners: 204 },
  { city: "Lima", country: "PE", listeners: 202 },
];

const cityMax = Math.max(...cityFallback.map((city) => city.listeners));
---

<ArtistLayout
  title="Artista"
  description="Gargut — perfil, catálogo, números y señal desde Guadalajara, México."
  theme="red"
  board
>
  <div class="board-page">
    <header class="board-head">
      <h1 class="board-head__title">Gargut<span aria-hidden="true">*</span></h1>
      <div class="board-head__meta">
        <span>GDL / MX</span>
        <span>Activo <b>{firstYear}</b></span>
        <span><b>{releases.length}</b> releases</span>
        <span>Spotify <b>live</b></span>
      </div>
    </header>

    <div class="board-grid board-grid--artista">
      <section class="board-panel profile-panel">
        <div class="board-panel__head">
          <span>Perfil</span>
          <span>FIG. 01</span>
        </div>
        <div class="board-panel__body profile-panel__body">
          <figure class="profile-portrait">
            <img
              src={ARTIST_PORTRAIT_URL}
              alt="Gargut — retrato oficial de Spotify"
              width="640"
              height="640"
              loading="eager"
              decoding="async"
            />
            <figcaption>Retrato oficial · Spotify for Artists</figcaption>
          </figure>

          <div class="profile-copy">
            <span class="kicker">Rap · Trap · Ruido propio</span>
            <p>Singles, colaboraciones y frecuencias bajas.</p>
            <div class="profile-links">
              <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener">Spotify ↗</a>
              <a href={YOUTUBE_URL} target="_blank" rel="noopener">YouTube ↗</a>
            </div>
          </div>

          <dl class="profile-stats">
            <div>
              <dt>Oyentes</dt>
              <dd data-stat="listeners">{ARTIST_MONTHLY_LISTENERS.toLocaleString("es-MX")}</dd>
            </div>
            <div>
              <dt>Seguidores</dt>
              <dd data-stat="followers">{ARTIST_FOLLOWERS.toLocaleString("es-MX")}</dd>
            </div>
            <div>
              <dt>Top track</dt>
              <dd data-stat="top">{ARTIST_TOP_TRACK}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="board-panel catalog-panel">
        <div class="board-panel__head">
          <span>Catálogo</span>
          <span>{firstYear}—{lastYear}</span>
        </div>
        <div class="board-panel__body board-panel__body--flush catalog-panel__body">
          <div class="catalog-mini">
            <ol class="catalog-mini__col">
              {releasesA.map((track, i) => (
                <li class="release" data-track-title={track.title}>
                  <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                    <span class="release__index">{String(i + 1).padStart(2, "0")}</span>
                    <span class="release__cover">
                      {track.coverUrl ? (
                        <img src={track.coverUrl} alt="" width="48" height="48" loading="lazy" decoding="async" />
                      ) : (
                        <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                      )}
                    </span>
                    <span class="release__info">
                      <strong>{track.title}</strong>
                      <span class="release__meta">{track.year} · {track.type === "solo" ? "Solo" : "Colab"}</span>
                    </span>
                    <span class="release__plays">{formatPlays(track.streams)}</span>
                    <span class="release__arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>

            <ol class="catalog-mini__col">
              {releasesB.map((track, i) => (
                <li class="release" data-track-title={track.title}>
                  <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                    <span class="release__index">{String(i + half + 1).padStart(2, "0")}</span>
                    <span class="release__cover">
                      {track.coverUrl ? (
                        <img src={track.coverUrl} alt="" width="48" height="48" loading="lazy" decoding="async" />
                      ) : (
                        <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                      )}
                    </span>
                    <span class="release__info">
                      <strong>{track.title}</strong>
                      <span class="release__meta">{track.year} · {track.type === "solo" ? "Solo" : "Colab"}</span>
                    </span>
                    <span class="release__plays">{formatPlays(track.streams)}</span>
                    <span class="release__arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <p class="data-note" data-stats-note>Datos públicos de Spotify.</p>
        </div>
      </section>

      <section class="board-panel signal-panel">
        <div class="board-panel__head">
          <span>Números / Conecta</span>
          <span>GGT—002</span>
        </div>
        <div class="board-panel__body signal-panel__body">
          <div class="signal-block">
            <div class="signal-block__head">
              <span>Dónde suena</span>
              <span>Top 5</span>
            </div>
            <ul class="cities" data-cities>
              {cityFallback.map((city, index) => (
                <li class="city">
                  <span class="city__rank">{String(index + 1).padStart(2, "0")}</span>
                  <span class="city__name">{city.city}</span>
                  <span class="city__bar" aria-hidden="true">
                    <span style={`width:${Math.round((city.listeners / cityMax) * 100)}%`}></span>
                  </span>
                  <span class="city__count">{city.listeners.toLocaleString("es-MX")}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="signal-block">
            <div class="signal-block__head">
              <span>Conecta</span>
              <span>Redes</span>
            </div>
            <div class="signal-links">
              <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener">Spotify ↗</a>
              <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram ↗</a>
              <a href={YOUTUBE_URL} target="_blank" rel="noopener">YouTube ↗</a>
              <a href={TIKTOK_URL} target="_blank" rel="noopener">TikTok ↗</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</ArtistLayout>

<script is:inline>
  (() => {
    const setText = (key, value) => {
      if (value === null || value === undefined || value === "") return;
      document.querySelectorAll(`[data-stat="${key}"]`).forEach((node) => {
        node.textContent = value;
      });
    };

    const formatNumber = (value) =>
      typeof value === "number" ? value.toLocaleString("es-MX") : null;

    const CITY_NAMES = {
      "Mexico City": "Ciudad de México",
      "Mexico city": "Ciudad de México",
      Bogota: "Bogotá",
      "Bogotá": "Bogotá",
    };

    const renderCities = (cities) => {
      const list = document.querySelector("[data-cities]");
      if (!list || !Array.isArray(cities) || cities.length === 0) return;

      const top = cities.slice(0, 5);
      const max = Math.max(...top.map((city) => Number(city.listeners) || 0), 1);
      const items = Array.from(list.querySelectorAll(".city"));

      items.forEach((item, index) => {
        const city = top[index];
        if (!city) {
          item.hidden = true;
          return;
        }

        item.hidden = false;
        const name = CITY_NAMES[city.city] || city.city;
        const rank = item.querySelector(".city__rank");
        const label = item.querySelector(".city__name");
        const fill = item.querySelector(".city__bar span");
        const count = item.querySelector(".city__count");

        if (rank) rank.textContent = String(index + 1).padStart(2, "0");
        if (label) label.textContent = name;
        if (fill) fill.style.width = `${Math.round(((Number(city.listeners) || 0) / max) * 100)}%`;
        if (count) count.textContent = (Number(city.listeners) || 0).toLocaleString("es-MX");
      });
    };

    const normalize = (value) => String(value || "").trim().toLowerCase();

    const applyPlays = (entries, key) => {
      if (!Array.isArray(entries) || entries.length === 0) return;

      const stats = new Map(
        entries
          .filter((entry) => entry && entry[key])
          .map((entry) => [normalize(entry[key]), entry.playcount])
      );

      document.querySelectorAll(".release[data-track-title]").forEach((item) => {
        const playcount = stats.get(normalize(item.dataset.trackTitle));
        if (typeof playcount !== "number") return;

        const plays = item.querySelector(".release__plays");
        if (plays) plays.textContent = playcount.toLocaleString("es-MX");
      });
    };

    fetch("/api/discography-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyPlays(data.tracks, "title");
      })
      .catch(() => {});

    fetch("/api/artist-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;

        setText("listeners", formatNumber(data.monthlyListeners));
        setText("followers", formatNumber(data.followers));
        setText("top", data.topTrack);
        renderCities(data.topCities);
        applyPlays(data.topTracks, "name");
      })
      .catch(() => {});
  })();
</script>

<style>
  .board-grid--artista {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr) minmax(0, 0.75fr);
    grid-template-rows: minmax(0, 1fr);
  }

  /* Perfil */
  .profile-panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .profile-portrait {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    overflow: hidden;
    background: #050000;
  }
  .profile-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition: filter 0.3s ease, transform 0.4s ease;
  }
  .profile-portrait:hover img { filter: grayscale(0); transform: scale(1.02); }
  .profile-portrait figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.3rem 0.45rem;
    background: #000000;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .profile-copy { flex: 0 0 auto; }
  .profile-copy .kicker { display: block; margin-bottom: 0.25rem; }
  .profile-copy p {
    font-size: 0.78rem;
    line-height: 1.5;
    color: #ffffff;
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.45rem;
  }
  .profile-links a {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
  }
  .profile-links a:hover { background: var(--accent); }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    margin: 0;
    flex: 0 0 auto;
  }
  .profile-stats div {
    padding: 0.45rem 0.5rem;
    background: var(--accent);
    border: 1px solid #000000;
  }
  .profile-stats dt {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .profile-stats dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    line-height: 1;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Catálogo compacto */
  .catalog-panel__body { display: flex; flex-direction: column; }
  .catalog-mini {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: 0;
    flex: 1;
  }
  .catalog-mini__col { list-style: none; min-width: 0; }
  .catalog-mini__col + .catalog-mini__col { border-left: 1px solid rgba(255, 255, 255, 0.18); }
  .release { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .release:last-child { border-bottom: 0; }
  .release a {
    display: grid;
    grid-template-columns: 1.15rem 2rem minmax(0, 1fr) auto 0.8rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.55rem;
    color: #ffffff;
    text-decoration: none;
    transition: background 0.16s ease;
  }
  .release__index { font-family: var(--font-display); font-size: 0.75rem; color: var(--accent); }
  .release__cover {
    display: block;
    width: 2rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #100000;
  }
  .release__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.8) contrast(1.05);
    transition: filter 0.25s ease, transform 0.3s ease;
  }
  .release__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 1rem;
    color: #ffffff;
  }
  .release__info { display: flex; flex-direction: column; min-width: 0; }
  .release__info strong {
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 1.2vw, 0.9rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #ffffff;
  }
  .release__meta {
    font-family: var(--font-mono);
    font-size: 0.45rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .release__plays {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
  }
  .release__arrow { font-size: 0.55rem; color: var(--accent); }
  .release:hover a { background: var(--accent); }
  .release:hover .release__index,
  .release:hover .release__arrow { color: #ffffff; }
  .release:hover .release__cover img { filter: grayscale(0); transform: scale(1.05); }
  .data-note {
    flex: 0 0 auto;
    margin: 0;
    padding: 0.4rem 0.55rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--font-mono);
    font-size: 0.46rem;
    letter-spacing: 0.03em;
    color: #ffffff;
  }

  /* Números / Conecta */
  .signal-panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .signal-block__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding-bottom: 0.35rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .signal-block__head span:last-child { color: var(--accent); }
  .cities { list-style: none; }
  .city {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr) auto;
    grid-template-areas: "rank name count" "rank bar bar";
    align-items: center;
    gap: 0.2rem 0.4rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .city:last-child { border-bottom: 0; }
  .city[hidden] { display: none; }
  .city__rank { grid-area: rank; font-family: var(--font-mono); font-size: 0.48rem; font-weight: 700; color: var(--accent); }
  .city__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .city__bar { grid-area: bar; display: block; height: 4px; background: rgba(255, 255, 255, 0.14); overflow: hidden; }
  .city__bar span { display: block; height: 100%; background: var(--accent); }
  .city__count { grid-area: count; font-family: var(--font-mono); font-size: 0.46rem; font-weight: 700; color: #ffffff; }
  .signal-links { display: flex; flex-direction: column; gap: 0.25rem; }
  .signal-links a {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
  }
  .signal-links a:hover { background: var(--accent); border-color: var(--accent); }

  @media (max-width: 900px) {
    .board-grid--artista {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 0.85fr) minmax(0, 1.25fr) minmax(0, 0.9fr);
      overflow: hidden;
    }

    .profile-panel__body {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: "portrait copy" "stats stats";
      gap: 0.3rem 0.45rem;
      padding: 0.4rem 0.5rem;
    }
    .profile-portrait { grid-area: portrait; height: 100%; min-height: 0; aspect-ratio: auto; }
    .profile-copy { grid-area: copy; align-self: center; min-width: 0; }
    .profile-copy .kicker { margin-bottom: 0.15rem; font-size: 0.44rem; }
    .profile-copy p { font-size: 0.56rem; line-height: 1.25; }
    .profile-links { gap: 0.2rem; margin-top: 0.25rem; }
    .profile-links a { padding: 0.2rem 0.3rem; font-size: 0.4rem; }
    .profile-stats { grid-area: stats; gap: 0.25rem; }
    .profile-stats div { padding: 0.22rem 0.3rem; }
    .profile-stats dt { font-size: 0.38rem; }
    .profile-stats dd { font-size: 0.78rem; }

    .catalog-panel__body { padding: 0; }
    .catalog-mini { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .catalog-mini__col + .catalog-mini__col {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.18);
    }
    .release a {
      grid-template-columns: 0.85rem 1.35rem minmax(0, 1fr) auto;
      gap: 0.25rem;
      padding: 0.2rem 0.3rem;
    }
    .release__cover { width: 1.35rem; }
    .release__index { font-size: 0.58rem; }
    .release__info strong { font-size: 0.58rem; }
    .release__meta { font-size: 0.38rem; }
    .release__plays { font-size: 0.4rem; }
    .release__arrow { display: none; }
    .data-note { padding: 0.25rem 0.35rem; font-size: 0.38rem; }

    .signal-panel__body {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 0.45rem;
      padding: 0.4rem 0.5rem;
      align-content: start;
    }
    .signal-block__head { padding-bottom: 0.15rem; margin-bottom: 0.2rem; font-size: 0.4rem; }
    .city {
      grid-template-columns: 0.9rem minmax(0, 1fr) auto;
      gap: 0.12rem 0.25rem;
      padding: 0.12rem 0;
    }
    .city__rank { font-size: 0.4rem; }
    .city__name { font-size: 0.52rem; }
    .city__bar { height: 3px; }
    .city__count { font-size: 0.4rem; }
    .signal-links { gap: 0.2rem; }
    .signal-links a { padding: 0.22rem 0.3rem; font-size: 0.4rem; }
  }

  @media (max-width: 380px) {
    .release a { grid-template-columns: 0.85rem minmax(0, 1fr) auto; }
    .release__cover { display: none; }
    .profile-panel__body { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  }

  @media (max-width: 900px) and (max-height: 700px) {
    .release__meta { display: none; }
    .signal-panel__body { gap: 0.35rem; padding: 0.3rem 0.45rem; }
    .signal-block__head { padding-bottom: 0.1rem; margin-bottom: 0.15rem; }
    .city { padding: 0.05rem 0; }
    .city__bar { display: none; }
    .city__rank,
    .city__name,
    .city__count { line-height: 1.2; }
    .signal-links { gap: 0.15rem; }
    .signal-links a { padding: 0.16rem 0.3rem; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import DropRoomForm from "../components/DropRoomForm.astro";
import DropCountdown from "../components/DropCountdown.astro";
import SpotifyLatestPlayer from "../components/SpotifyLatestPlayer.astro";
import {
  DISCOGRAPHY,
  SPOTIFY_ARTIST_URL,
  SPOTIFY_EMBED_ARTIST,
  INSTAGRAM_URL,
  YOUTUBE_URL,
  TIKTOK_URL,
  ARTIST_MONTHLY_LISTENERS,
  ARTIST_FOLLOWERS,
  ARTIST_TOP_TRACK,
  ARTIST_PORTRAIT_URL,
} from "../data/siteConfig";

const ARTIST_PORTRAIT = ARTIST_PORTRAIT_URL;

const releases = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  const aStreams = a.streams ?? -1;
  const bStreams = b.streams ?? -1;
  if (aStreams !== bStreams) return bStreams - aStreams;
  return a.title.localeCompare(b.title);
});

const half = Math.ceil(releases.length / 2);
const releasesA = releases.slice(0, half);
const releasesB = releases.slice(half);
const firstYear = Math.min(...DISCOGRAPHY.map((track) => track.year));
const lastYear = Math.max(...DISCOGRAPHY.map((track) => track.year));

const formatPlays = (value?: number) =>
  typeof value === "number" && value > 0 ? value.toLocaleString("es-MX") : "—";

const cityFallback = [
  { city: "Ciudad de México", country: "MX", listeners: 614 },
  { city: "Guadalajara", country: "MX", listeners: 465 },
  { city: "Zapopan", country: "MX", listeners: 216 },
  { city: "Bogotá", country: "CO", listeners: 204 },
  { city: "Lima", country: "PE", listeners: 202 },
];

const cityMax = Math.max(...cityFallback.map((city) => city.listeners));

const youtubeVideos = [
  { title: "FENTATRIP", id: "txWFWxLmix0" },
  { title: "Gargut - Experiencia Espiritual X @zacklyvibes", id: "NdQbpB4QggQ" },
  { title: "Gargut - Yo te kiero solo X @buzk09", id: "lVGN_fBoaOU" },
  { title: "Gargut - El Primer Artista", id: "IpWeeG1wiBE" },
  { title: "Gargut - Soy Artista o Eso Parece ft @zacklyvibes & @skydemongoat", id: "n0C4dFKB-Ks" },
  { title: "Artesania", id: "C5DVwAUr2Go" },
];

const instagramReels = [
  { title: "Primera experiencia espiritual", id: "DYfkaP8SFNK" },
  { title: "Fentatrip llega a Tijuana", id: "DZdTgeEyP-O" },
  { title: "", id: "DWuDsQukspP" },
  { title: "", id: "DZvgoINyut4" },
  { title: "", id: "DZdAZEUqNRb" },
  { title: "", id: "DZaiV0GKylR" },
];

const benefits = [
  { title: "Acceso anticipado", body: "Escucha y mira antes de que salga al público." },
  { title: "Contenido exclusivo", body: "Material que no se publica en ningún otro lado." },
  { title: "Fechas de shows", body: "Guadalajara, México y lo que venga después." },
];

const youtubeEmbed = (id: string) => `https://www.youtube.com/embed/${id}`;
---

<ArtistLayout
  title="Artista"
  description="Gargut — catálogo, números, videos y Drop Room en una sola página."
  theme="red"
>
  <nav class="page-command" aria-label="Secciones de la página">
    <div class="page-command__inner">
      <a class="page-command__brand" href="#artista">GARGUT / 2026</a>
      <div class="page-command__links">
        <a href="#artista">Artista</a>
        <a href="#catalogo">Catálogo</a>
        <a href="#numeros">Números</a>
        <a href="#videos">Videos</a>
        <a href="#drop">Drop Room</a>
        <a href="#conecta">Conecta</a>
      </div>
    </div>
  </nav>

  <div class="one-page">
    <header id="artista" class="one-hero">
      <div class="one-hero__meta">
        <span>Expediente / 002</span>
        <span>GDL · MX</span>
        <span>Activo desde {firstYear}</span>
        <span class="one-hero__live"><i aria-hidden="true"></i> Spotify en vivo</span>
      </div>

      <div class="one-hero__main">
        <div class="one-hero__copy">
          <span class="kicker">Rap · Trap · Ruido propio</span>
          <h1 class="one-hero__title">
            <span>GAR</span>
            <span class="outline">GUT</span>
          </h1>
          <p class="one-hero__lead">
            Singles, colaboraciones y frecuencias bajas desde Guadalajara.
            Sin disquera grande y sin pedir permiso.
          </p>
          <div class="one-hero__actions">
            <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--primary">
              Escuchar en Spotify <span aria-hidden="true">↗</span>
            </a>
            <a href="#catalogo" class="btn btn--outline">
              Ver catálogo <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <figure class="one-portrait">
          <div class="one-portrait__frame">
            <img
              src={ARTIST_PORTRAIT}
              alt="Gargut — retrato oficial de Spotify"
              width="640"
              height="640"
              loading="eager"
              decoding="async"
            />
            <span class="one-portrait__tag">FIG. 01</span>
          </div>
          <figcaption>Retrato oficial · Spotify for Artists</figcaption>
        </figure>
      </div>

      <div class="one-hero__strip">
        <span><b>{releases.length}</b> releases</span>
        <span><b>{firstYear}—{String(lastYear).slice(-2)}</b> periodo</span>
        <span><b>dxf prod</b> sello</span>
        <span><b>GDL</b> base</span>
      </div>
    </header>

    <section id="catalogo" class="one-section">
      <div class="one-band">
        <h2>Catálogo</h2>
        <span>{releases.length} releases · {firstYear}—{lastYear}</span>
      </div>

      <div class="catalog">
        <div class="catalog__player">
          <div>
            <span class="kicker">Último lanzamiento</span>
            <strong>Dale play. El siguiente drop ya viene en camino.</strong>
          </div>
          <SpotifyLatestPlayer />
        </div>

        <div class="catalog__cols">
          <ol class="catalog__col">
            {releasesA.map((track, i) => (
              <li class="release" data-track-title={track.title}>
                <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                  <span class="release__index">{String(i + 1).padStart(2, "0")}</span>
                  <span class="release__cover">
                    {track.coverUrl ? (
                      <img src={track.coverUrl} alt="" width="56" height="56" loading="lazy" decoding="async" />
                    ) : (
                      <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                    )}
                  </span>
                  <span class="release__info">
                    <strong>{track.title}</strong>
                    <span class="release__meta">
                      {track.year} · {track.type === "solo" ? "Solo" : "Colab"}
                      {track.collaborators?.length ? ` · ${track.collaborators.join(" / ")}` : ""}
                    </span>
                  </span>
                  <span class="release__plays">{formatPlays(track.streams)}</span>
                  <span class="release__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>

          <ol class="catalog__col">
            {releasesB.map((track, i) => (
              <li class="release" data-track-title={track.title}>
                <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                  <span class="release__index">{String(i + half + 1).padStart(2, "0")}</span>
                  <span class="release__cover">
                    {track.coverUrl ? (
                      <img src={track.coverUrl} alt="" width="56" height="56" loading="lazy" decoding="async" />
                    ) : (
                      <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                    )}
                  </span>
                  <span class="release__info">
                    <strong>{track.title}</strong>
                    <span class="release__meta">
                      {track.year} · {track.type === "solo" ? "Solo" : "Colab"}
                      {track.collaborators?.length ? ` · ${track.collaborators.join(" / ")}` : ""}
                    </span>
                  </span>
                  <span class="release__plays">{formatPlays(track.streams)}</span>
                  <span class="release__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="numeros" class="one-section">
      <div class="one-band">
        <h2>Números</h2>
        <span>Spotify / cada 30 min</span>
      </div>

      <div class="numbers-grid">
        <div class="metrics">
          <article class="metric">
            <strong data-stat="listeners">{ARTIST_MONTHLY_LISTENERS.toLocaleString("es-MX")}</strong>
            <span>Oyentes mensuales</span>
          </article>
          <article class="metric">
            <strong data-stat="followers">{ARTIST_FOLLOWERS.toLocaleString("es-MX")}</strong>
            <span>Seguidores</span>
          </article>
          <article class="metric">
            <strong>{releases.length}</strong>
            <span>Lanzamientos</span>
          </article>
          <article class="metric metric--wide">
            <strong data-stat="top">{ARTIST_TOP_TRACK}</strong>
            <span>Track más escuchado</span>
          </article>
          <p class="data-note" data-stats-note>
            Datos públicos de Spotify · respaldo local si la API no responde.
          </p>
        </div>

        <div class="cities-card">
          <div class="cities-card__head">
            <h3>Dónde suena</h3>
            <span>Top ciudades</span>
          </div>
          <ul class="cities" data-cities>
            {cityFallback.map((city, index) => (
              <li class="city">
                <span class="city__rank">{String(index + 1).padStart(2, "0")}</span>
                <span class="city__name">{city.city}</span>
                <span class="city__bar" aria-hidden="true">
                  <span style={`width:${Math.round((city.listeners / cityMax) * 100)}%`}></span>
                </span>
                <span class="city__count">{city.listeners.toLocaleString("es-MX")}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="videos" class="one-section">
      <div class="one-band">
        <h2>Videos</h2>
        <span>YouTube · Instagram</span>
      </div>

      <div class="video-console">
        <div class="video-console__screen">
          <div class="video-console__frame">
            <iframe
              id="videoMain"
              src={youtubeEmbed(youtubeVideos[0].id)}
              title={youtubeVideos[0].title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
          <div class="video-console__now">
            <div>
              <span class="video-console__label">Ahora suena</span>
              <h3 id="videoNow">{youtubeVideos[0].title}</h3>
            </div>
            <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="video-console__link">
              YouTube <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <ol class="playlist">
          {youtubeVideos.map((video, i) => (
            <li>
              <button
                type="button"
                class:list={["playlist__item", { "is-active": i === 0 }]}
                data-video-id={video.id}
                data-video-title={video.title}
                aria-label={`Reproducir ${video.title}`}
              >
                <span class="playlist__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="playlist__title">{video.title}</span>
                <span class="playlist__arrow" aria-hidden="true">▶</span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="ig-strip">
        <span class="ig-strip__eyebrow">Instagram / El contexto</span>
        <strong>¿Qué es el FENTATRIP?</strong>
        <span class="ig-strip__cta">Ver visuales <span aria-hidden="true">↗</span></span>
      </a>

      <div class="reel-strip" aria-label="Reels de Instagram">
        {instagramReels.map((reel, i) => (
          <a
            class="reel-tile"
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener"
            aria-label={reel.title ? `Ver reel: ${reel.title}` : "Ver el Instagram de Gargut"}
          >
            <span class="reel-tile__index">{String(i + 1).padStart(2, "0")}</span>
            <span class="reel-tile__grid" aria-hidden="true"></span>
            <span class="reel-tile__word">Reel</span>
            <span class="reel-tile__title">{reel.title || "Ver en Instagram"}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="drop" class="one-section">
      <div class="one-band">
        <h2>Drop Room</h2>
        <span>Acceso anticipado</span>
      </div>

      <div class="drop-grid">
        <div class="drop-pitch">
          <span class="kicker">Por qué entrar</span>
          <h3>Entra antes que nadie</h3>
          <ol class="benefits">
            {benefits.map((benefit, i) => (
              <li>
                <span class="benefits__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <strong>{benefit.title}</strong>
                  <p>{benefit.body}</p>
                </div>
              </li>
            ))}
          </ol>

          <DropCountdown />

          <p class="drop-privacy">
            Solo usamos tus datos para enviarte novedades de Gargut. No los vendemos
            ni los compartimos con terceros. Puedes darte de baja cuando quieras.
            <a href="/privacidad">Leer aviso de privacidad ↗</a>
          </p>
        </div>

        <div class="drop-form">
          <DropRoomForm />
        </div>
      </div>
    </section>

    <section id="conecta" class="one-section">
      <div class="one-band">
        <h2>Conecta</h2>
        <span>Spotify / redes</span>
      </div>

      <div class="connect-grid">
        <div class="connect-links">
          <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener">Spotify <span aria-hidden="true">↗</span></a>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a>
          <a href={YOUTUBE_URL} target="_blank" rel="noopener">YouTube <span aria-hidden="true">↗</span></a>
          <a href={TIKTOK_URL} target="_blank" rel="noopener">TikTok <span aria-hidden="true">↗</span></a>
          <a href="/privacidad">Privacidad <span aria-hidden="true">↗</span></a>
        </div>

        <div class="connect-embed">
          <div class="connect-embed__bar">
            <span>Spotify / Artista</span>
            <span>GUT—002</span>
          </div>
          <iframe
            src={SPOTIFY_EMBED_ARTIST}
            width="100%"
            height="352"
            style="border:0;"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Gargut en Spotify"
          />
        </div>
      </div>
    </section>
  </div>

  <PageFooter />
</ArtistLayout>

<script is:inline>
  (() => {
    const setText = (key, value) => {
      if (value === null || value === undefined || value === "") return;
      document.querySelectorAll(`[data-stat="${key}"]`).forEach((node) => {
        node.textContent = value;
      });
    };

    const formatNumber = (value) =>
      typeof value === "number" ? value.toLocaleString("es-MX") : null;

    const CITY_NAMES = {
      "Mexico City": "Ciudad de México",
      "Mexico city": "Ciudad de México",
      Bogota: "Bogotá",
      "Bogotá": "Bogotá",
    };

    const renderCities = (cities) => {
      const list = document.querySelector("[data-cities]");
      if (!list || !Array.isArray(cities) || cities.length === 0) return;

      const top = cities.slice(0, 5);
      const max = Math.max(...top.map((city) => Number(city.listeners) || 0), 1);
      const items = Array.from(list.querySelectorAll(".city"));

      items.forEach((item, index) => {
        const city = top[index];
        if (!city) {
          item.hidden = true;
          return;
        }

        item.hidden = false;
        const name = CITY_NAMES[city.city] || city.city;
        const rank = item.querySelector(".city__rank");
        const label = item.querySelector(".city__name");
        const fill = item.querySelector(".city__bar span");
        const count = item.querySelector(".city__count");

        if (rank) rank.textContent = String(index + 1).padStart(2, "0");
        if (label) label.textContent = name;
        if (fill) fill.style.width = `${Math.round(((Number(city.listeners) || 0) / max) * 100)}%`;
        if (count) count.textContent = (Number(city.listeners) || 0).toLocaleString("es-MX");
      });
    };

    const normalize = (value) => String(value || "").trim().toLowerCase();

    const applyPlays = (entries, key) => {
      if (!Array.isArray(entries) || entries.length === 0) return;

      const stats = new Map(
        entries
          .filter((entry) => entry && entry[key])
          .map((entry) => [normalize(entry[key]), entry.playcount])
      );

      document.querySelectorAll(".release[data-track-title]").forEach((item) => {
        const playcount = stats.get(normalize(item.dataset.trackTitle));
        if (typeof playcount !== "number") return;

        const plays = item.querySelector(".release__plays");
        if (plays) plays.textContent = playcount.toLocaleString("es-MX");
      });
    };

    fetch("/api/discography-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyPlays(data.tracks, "title");
      })
      .catch(() => {});

    fetch("/api/artist-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;

        setText("listeners", formatNumber(data.monthlyListeners));
        setText("followers", formatNumber(data.followers));
        setText("top", data.topTrack);
        renderCities(data.topCities);
        applyPlays(data.topTracks, "name");

        const note = document.querySelector("[data-stats-note]");
        if (note) {
          note.textContent = data.stale
            ? "Datos de Spotify · copia más reciente guardada, reintentando en vivo"
            : "Datos en vivo de Spotify · se actualizan cada 30 min";
        }
      })
      .catch(() => {});
  })();
</script>

<script>
  const player = document.getElementById("videoMain") as HTMLIFrameElement | null;
  const nowTitle = document.getElementById("videoNow");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-video-id]"));

  if (player && nowTitle && buttons.length > 0) {
    const activate = (button: HTMLButtonElement) => {
      const id = button.dataset.videoId;
      const title = button.dataset.videoTitle ?? "Video";
      if (!id) return;

      player.src = `https://www.youtube.com/embed/${id}`;
      player.title = title;
      nowTitle.textContent = title;

      buttons.forEach((item) => {
        item.classList.toggle("is-active", item === button);
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => activate(button));
    });
  }
</script>

<style>
  :global(main.artist-main.theme-red) {
    --font-display: "Anton", "Arial Narrow", Impact, sans-serif;
    background-color: #050000;
    background-image:
      radial-gradient(1000px 600px at 50% -12%, rgba(255, 35, 56, 0.2), transparent 64%),
      linear-gradient(rgba(255, 35, 56, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 35, 56, 0.055) 1px, transparent 1px);
    background-size: 100% 100%, 72px 72px, 72px 72px;
  }

  /* Barra de comando */
  .page-command {
    position: sticky;
    top: var(--header-h);
    z-index: 150;
    background: var(--accent);
    color: #0a0002;
    border-bottom: 2px solid #ffffff;
  }
  .page-command__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0.6rem clamp(1rem, 4vw, 2.5rem);
  }
  .page-command__brand {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #0a0002;
    text-decoration: none;
  }
  .page-command__links {
    display: flex;
    gap: 0.2rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .page-command__links::-webkit-scrollbar { display: none; }
  .page-command__links a {
    flex: 0 0 auto;
    padding: 0.4rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: #0a0002;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .page-command__links a:hover { background: #0a0002; color: #ffffff; }

  .one-page {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem) clamp(3rem, 6vw, 4.5rem);
  }

  .one-section {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-top: calc(var(--header-h) + 3.5rem);
  }
  .one-hero { scroll-margin-top: calc(var(--header-h) + 3.5rem); }

  /* Bandas de sección */
  .one-band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.8rem clamp(1rem, 3vw, 1.4rem);
    background: var(--accent);
    border-top: 2px solid #ffffff;
    border-bottom: 2px solid #000000;
  }
  .one-band h2 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.5vw, 2.8rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: #0a0002;
  }
  .one-band span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0a0002;
    white-space: nowrap;
  }

  /* Héroe */
  .one-hero {
    margin-top: clamp(1rem, 2.5vw, 1.5rem);
    padding: clamp(1.1rem, 3vw, 2rem);
    border: 1px solid var(--accent);
    border-top: 6px solid #ffffff;
    background:
      radial-gradient(110% 130% at 100% 0%, rgba(255, 35, 56, 0.16), transparent 58%),
      #050000;
    box-shadow: 14px 14px 0 rgba(255, 35, 56, 0.25);
  }
  .one-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    padding-bottom: 0.9rem;
    margin-bottom: clamp(1rem, 3vw, 1.8rem);

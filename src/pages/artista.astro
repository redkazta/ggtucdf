---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import Skeleton from "../components/Skeleton.astro";
import {
  SITE_TITLE,
  ARTIST_MONTHLY_LISTENERS,
  ARTIST_FOLLOWERS,
  DISCOGRAPHY,
  SPOTIFY_ARTIST_URL,
  SPOTIFY_EMBED_ARTIST,
  INSTAGRAM_URL,
} from "../data/siteConfig";

const totalStreams = DISCOGRAPHY.reduce((sum, t) => sum + (t.streams || 0), 0);
const featuredCover =
  DISCOGRAPHY.find((t) => t.title === "Yo te kiero solo")?.coverUrl || "";
const topTracks = [...DISCOGRAPHY]
  .sort((a, b) => (b.streams || 0) - (a.streams || 0))
  .slice(0, 6);

const sections = [
  { id: "perfil", label: "Perfil" },
  { id: "musica", label: "Música" },
  { id: "escena", label: "Escena" },
  { id: "conecta", label: "Conecta" },
];
---

<ArtistLayout
  title="Artista"
  description={`${SITE_TITLE} — Artista independiente de Guadalajara, México.`}
>
  <div class="section-scroller" id="sectionScroller">
    <!-- SECCIÓN 1: PERFIL -->
    <section class="artist-section" id="sec-perfil" data-index="0" aria-label="Perfil">
      <div class="section-inner">
        <div class="perfil-visual">
          {featuredCover ? (
            <div class="cover-wrap">
              <img
                src={featuredCover}
                alt=""
                class="perfil-cover"
                width="300"
                height="300"
                decoding="async"
                onload="this.classList.add('is-loaded'); this.nextElementSibling?.classList.add('is-hidden');"
              />
              <div class="cover-skeleton" aria-hidden="true">
                <Skeleton width="100%" height="100%" borderRadius="0" />
              </div>
            </div>
          ) : (
            <div class="perfil-cover-placeholder" aria-hidden="true" />
          )}
        </div>

        <div class="perfil-content">
          <h1 class="perfil-name">{SITE_TITLE}</h1>

          <div class="perfil-stats">
            <div class="stat">
              <span class="stat__value">{ARTIST_MONTHLY_LISTENERS}</span>
              <span class="stat__label">oyentes mensuales</span>
            </div>
            <div class="stat">
              <span class="stat__value">{ARTIST_FOLLOWERS}</span>
              <span class="stat__label">seguidores</span>
            </div>
            <div class="stat">
              <span class="stat__value">{DISCOGRAPHY.length}</span>
              <span class="stat__label">singles</span>
            </div>
            <div class="stat">
              <span class="stat__value">{totalStreams.toLocaleString("es-MX")}</span>
              <span class="stat__label">streams totales</span>
            </div>
          </div>

          <a
            href={SPOTIFY_ARTIST_URL}
            target="_blank"
            rel="noopener"
            class="btn btn--primary"
          >
            Escuchar en Spotify
          </a>
        </div>
      </div>

      <div class="scroll-hint" aria-hidden="true">
        <span class="scroll-hint__line" />
        <span class="scroll-hint__text">Scroll</span>
      </div>
    </section>

    <!-- SECCIÓN 2: MÚSICA -->
    <section class="artist-section" id="sec-musica" data-index="1" aria-label="Música">
      <div class="section-inner section-inner--wide">
        <span class="section-eyebrow">Música</span>
        <h2 class="section-headline">Discografia</h2>
        <div class="music-grid">
          {topTracks.map((track) => (
            <a
              href={track.spotifyUrl}
              target="_blank"
              rel="noopener"
              class="music-card"
              aria-label={`Escuchar ${track.title}`}
            >
              <div class="music-card__cover-wrap">
                {track.coverUrl ? (
                  <>
                    <img
                      src={track.coverUrl}
                      alt=""
                      class="music-card__cover"
                      width="300"
                      height="300"
                      loading="lazy"
                      decoding="async"
                      onload="this.classList.add('is-loaded'); this.nextElementSibling?.classList.add('is-hidden');"
                    />
                    <div class="music-card__skeleton" aria-hidden="true">
                      <Skeleton width="100%" height="100%" borderRadius="0" />
                    </div>
                  </>
                ) : (
                  <div class="music-card__fallback">
                    <span>{track.title.charAt(0)}</span>
                  </div>
                )}
                <div class="music-card__overlay">
                  <span class="music-card__play">&#9654;</span>
                </div>
              </div>
              <div class="music-card__info">
                <h3 class="music-card__title">{track.title}</h3>
                <div class="music-card__meta">
                  <span>{track.year}</span>
                  <span class="badge" data-type={track.type}>
                    {track.type === "solo" ? "Solo" : "Colab"}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: ESCENA -->
    <section class="artist-section" id="sec-escena" data-index="2" aria-label="Escena">
      <div class="section-inner section-inner--wide">
        <span class="section-eyebrow">Escena</span>
        <h2 class="section-headline">Spotify</h2>

        <div class="embed-wrap">
          <div class="embed-skeleton" data-embed-skeleton aria-hidden="true">
            <Skeleton width="100%" height="360px" borderRadius="12px" />
          </div>
          <iframe
            class="embed-iframe"
            src={SPOTIFY_EMBED_ARTIST}
            width="100%"
            height="360"
            style="border-radius:0; border:0;"
            allow="encrypted-media"
            loading="lazy"
            title="Gargut en Spotify"
            onload="this.closest('.embed-wrap').querySelector('[data-embed-skeleton]')?.classList.add('is-hidden'); this.classList.add('is-loaded');"
          />
        </div>
      </div>
    </section>

    <!-- SECCIÓN 4: CONECTA -->
    <section class="artist-section" id="sec-conecta" data-index="3" aria-label="Conecta">
      <div class="section-inner section-inner--center">
        <span class="section-eyebrow">Conecta</span>
        <h2 class="section-headline section-headline--big">Enlaces</h2>

        <div class="connect-grid">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="connect-card connect-card--ig">
            <span class="connect-card__icon">&#9670;</span>
            <span class="connect-card__label">Instagram</span>
          </a>
        </div>

        <PageFooter />
      </div>
    </section>
  </div>

  <!-- Navegacion lateral -->
  <nav class="section-dots" id="sectionDots" aria-label="Navegacion de secciones">
    {sections.map((sec, i) => (
      <button
        class={`section-dot ${i === 0 ? "is-active" : ""}`}
        data-index={i}
        aria-label={sec.label}
        type="button"
      >
        <span class="section-dot__label">{sec.label}</span>
      </button>
    ))}
  </nav>

  <script is:inline>
    (function () {
      const scroller = document.getElementById("sectionScroller");
      const dots = document.querySelectorAll(".section-dot");
      const sections = document.querySelectorAll(".artist-section");
      if (!scroller || !dots.length || !sections.length) return;

      let current = 0;
      let isSnapping = false;

      function activate(index) {
        current = index;
        dots.forEach((d, i) => {
          d.classList.toggle("is-active", i === index);
        });
      }

      function scrollToSection(index) {
        if (index < 0 || index >= sections.length) return;
        isSnapping = true;
        sections[index].scrollIntoView({ behavior: "smooth", block: "start" });
        activate(index);
        setTimeout(() => { isSnapping = false; }, 600);
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = parseInt(dot.dataset.index || "0", 10);
          scrollToSection(idx);
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          if (isSnapping) return;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = parseInt((entry.target).dataset.index || "0", 10);
              activate(idx);
            }
          });
        },
        { root: scroller, threshold: 0.55 }
      );

      sections.forEach((sec) => observer.observe(sec));

      // Entrance animations
      const entranceObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
            }
          });
        },
        { root: scroller, threshold: 0.15 }
      );

      sections.forEach((sec) => entranceObserver.observe(sec));

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "PageDown") {
          e.preventDefault();
          scrollToSection(current + 1);
        } else if (e.key === "ArrowUp" || e.key === "PageUp") {
          e.preventDefault();
          scrollToSection(current - 1);
        }
      });

      let touchStartY = 0;
      scroller.addEventListener("touchstart", (e) => {
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      scroller.addEventListener("touchend", (e) => {
        const diff = touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(diff) > 50) {
          if (diff > 0) scrollToSection(current + 1);
          else scrollToSection(current - 1);
        }
      }, { passive: true });
    })();
  </script>

  <style>
.section-scroller {
  height: calc(100dvh - var(--header-h));
  overflow-y: auto;
  overflow-x: hidden;
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  counter-reset: section;
}
.section-scroller::-webkit-scrollbar { display: none; }

.artist-section {
  position: relative;
  min-height: calc(100dvh - var(--header-h));
  display: flex;
  align-items: center;
  justify-content: center;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  padding: 1.5rem 1rem;
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.artist-section.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.section-inner {
  width: 100%;
  max-width: 540px;
}
.section-inner--wide { max-width: 760px; }
.section-inner--narrow { max-width: 560px; }
.section-inner--center { text-align: center; }

.section-eyebrow {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 0.8rem;
}
.section-eyebrow::before {
  counter-increment: section;
  content: "0" counter(section);
  padding: 0.16rem 0.3rem;
  background: var(--accent);
  color: #ffffff;
  font-size: 0.5rem;
  letter-spacing: 0.06em;
}
.section-eyebrow::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--line);
}

.section-headline {
  position: relative;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2.4rem, 9vw, 4rem);
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 0.85;
  margin-bottom: 1.35rem;
  padding-bottom: 0.65rem;
  border-bottom: 1px solid var(--line-strong);
}
.section-headline::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 72px;
  height: 3px;
  background: var(--accent);
}
.section-inner--center .section-headline::after {
  left: 50%;
  transform: translateX(-50%);
}
.section-headline--big {
  font-size: clamp(2.8rem, 11vw, 5rem);
}

.section-lead {
  font-size: 0.86rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 1.5rem;
}
.section-lead--center {
  max-width: 420px;
  margin-left: auto;
  margin-right: auto;
}

/* PERFIL */
.perfil-visual {
  display: flex;
  justify-content: center;
  margin-bottom: 1.75rem;
}
.cover-wrap {
  position: relative;
  width: 176px;
  height: 176px;
}
.cover-skeleton {
  position: absolute;
  inset: 0;
  z-index: 2;
  transition: opacity 0.4s ease;
}
.cover-skeleton.is-hidden { opacity: 0; pointer-events: none; }

.perfil-cover {
  width: 176px;
  height: 176px;
  object-fit: cover;
  border-radius: 0;
  border: 1px solid var(--line-strong);
  box-shadow: 9px 9px 0 var(--accent);
  opacity: 0;
  transition: opacity 0.4s ease;
  filter: grayscale(0.35) contrast(1.08);
}
.perfil-cover.is-loaded { opacity: 1; }
.perfil-cover-placeholder {
  width: 176px;
  height: 176px;
  border-radius: 0;
  background: var(--bg-elevated);
  border: 1px solid var(--line-strong);
  box-shadow: 9px 9px 0 var(--accent);
}

.perfil-content { text-align: left; }
.perfil-name {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2.6rem, 10vw, 4.4rem);
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 0.82;
  overflow-wrap: anywhere;
  margin-bottom: 1.25rem;
}
.perfil-bio {
  font-size: 0.86rem;
  color: var(--text-muted);
  line-height: 1.7;
  max-width: 460px;
  margin: 0 0 1.5rem;
}

.perfil-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  border: 1px solid var(--line);
  border-bottom: 0;
  max-width: 460px;
  margin: 0 0 1.5rem;
  background: var(--bg-soft);
}
.stat {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.15rem;
  padding: 0.7rem 0.75rem 0.6rem;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  transition: background 0.2s ease;
}
.stat:nth-child(2n) { border-right: 0; }
.stat:hover { background: var(--surface-2); }
.stat__value {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 4vw, 1.7rem);
  color: var(--ink);
  line-height: 0.95;
}
.stat__label {
  font-family: var(--font-mono);
  font-size: 0.48rem;
  font-weight: 700;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  line-height: 1.4;
}

.scroll-hint {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.35rem;
  opacity: 0.6;
  pointer-events: none;
}
.scroll-hint__line {
  display: block;
  width: 1px;
  height: 30px;
  background: linear-gradient(180deg, transparent, var(--accent));
}
.scroll-hint__text {
  font-family: var(--font-mono);
  font-size: 0.5rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-dim);
}
@keyframes hint-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

.story-body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.story-body p {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* MUSICA */
.music-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.7rem;
}
.music-card {
  display: flex;
  flex-direction: column;
  border-radius: 0;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
  border: 1px solid var(--line);
  background: var(--bg-soft);
  transition: transform 0.16s ease, border-color 0.2s ease, box-shadow 0.16s ease;
}
.music-card:hover {
  transform: translate(-3px, -3px);
  border-color: var(--accent);
  box-shadow: 6px 6px 0 var(--accent);
}
.music-card__cover-wrap {
  position: relative;
  aspect-ratio: 1;
  border-radius: 0;
  overflow: hidden;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--line);
}
.music-card__cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 0;
  filter: grayscale(1) contrast(1.08);
  transition: opacity 0.35s ease, filter 0.35s ease, transform 0.5s ease;
}
.music-card:hover .music-card__cover {
  filter: grayscale(0);
  transform: scale(1.04);
}
.music-card__cover.is-loaded { opacity: 1; }
.music-card__skeleton {
  position: absolute;
  inset: 0;
  z-index: 1;
  transition: opacity 0.35s ease;
}
.music-card__skeleton.is-hidden { opacity: 0; pointer-events: none; }
.music-card__fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
}
.music-card__fallback span {
  font-family: var(--font-display);
  font-size: 2.6rem;
  color: var(--line-strong);
}
.music-card__overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0.55rem;
  background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.55));
  opacity: 0;
  transition: opacity 0.2s ease;
}
.music-card:hover .music-card__overlay { opacity: 1; }
.music-card__play {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding-left: 2px;
  border-radius: 0;
  font-size: 0.7rem;
  color: #ffffff;
  background: var(--accent);
  line-height: 1;
  transform: translateY(4px);
  transition: transform 0.2s ease;
}
.music-card:hover .music-card__play { transform: translateY(0); }
.music-card__info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 0.6rem 0.65rem 0.7rem;
}
.music-card__title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 1rem;
  color: var(--ink);
  letter-spacing: 0.01em;
  line-height: 1.05;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.music-card__meta {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-family: var(--font-mono);
  font-size: 0.55rem;
  font-weight: 700;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.badge {
  font-family: var(--font-mono);
  font-size: 0.48rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 0.18rem 0.35rem;
  border-radius: 0;
  background: transparent;
  border: 1px solid var(--line-strong);
  color: var(--text-muted);
  line-height: 1;
}
.badge[data-type="solo"] {
  background: var(--accent);
  border-color: var(--accent);
  color: #ffffff;
}

.embed-wrap {
  position: relative;
  border-radius: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-left: 3px solid var(--accent);
  background: var(--bg-soft);
}
.embed-skeleton {
  position: absolute;
  inset: 0;
  z-index: 1;
  transition: opacity 0.5s ease;
}
.embed-skeleton.is-hidden { opacity: 0; pointer-events: none; }
.embed-iframe {
  opacity: 0;
  transition: opacity 0.5s ease;
  display: block;
}
.embed-iframe.is-loaded { opacity: 1; }

/* CONECTA */
.connect-grid {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}
.connect-card {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.35rem;
  width: 160px;
  height: 104px;
  padding: 0.7rem;
  border-radius: 0;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.2s ease;
  border: 1px solid var(--line);
  background: var(--bg-soft);
  color: var(--ink);
}
.connect-card:hover {
  transform: translate(-3px, -3px);
  border-color: var(--accent);
  box-shadow: 6px 6px 0 var(--accent);
}
.connect-card:active { transform: translate(1px, 1px); box-shadow: none; }
.connect-card__icon {
  font-size: 1.3rem;
  line-height: 1;
  color: var(--accent);
}
.connect-card__label {
  font-family: var(--font-display);
  font-size: 1.1rem;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}
.connect-card--spotify,
.connect-card--youtube,
.connect-card--ig { color: var(--ink); border-color: var(--line); }

/* NAVEGACION LATERAL */
.section-dots {
  position: fixed;
  right: 0.7rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 300;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.55rem;
}
.section-dot {
  position: relative;
  width: 18px;
  height: 2px;
  border-radius: 0;
  border: 0;
  background: var(--line-strong);
  cursor: pointer;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
  transition: background 0.25s, width 0.25s;
}
.section-dot.is-active {
  width: 34px;
  background: var(--accent);
}
.section-dot__label {
  position: absolute;
  right: 42px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--font-mono);
  font-size: 0.52rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.2s;
  pointer-events: none;
}
.section-dot:hover .section-dot__label,
.section-dot.is-active .section-dot__label {
  opacity: 1;
}

@media (min-width: 768px) {
  .artist-section { padding: 2rem 2.5rem; }
  .section-inner { max-width: 660px; }
  .section-inner--wide { max-width: 900px; }
  .section-inner--narrow { max-width: 640px; }

  .perfil-visual { margin-bottom: 2rem; }
  .cover-wrap { width: 220px; height: 220px; }

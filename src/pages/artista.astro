---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import {
  DISCOGRAPHY,
  SPOTIFY_ARTIST_URL,
  SPOTIFY_EMBED_ARTIST,
  INSTAGRAM_URL,
  YOUTUBE_URL,
  TIKTOK_URL,
  ARTIST_MONTHLY_LISTENERS,
  ARTIST_FOLLOWERS,
  ARTIST_TOP_TRACK,
  ARTIST_PORTRAIT_URL,
} from "../data/siteConfig";

const ARTIST_PORTRAIT = ARTIST_PORTRAIT_URL;

const releases = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  const aStreams = a.streams ?? -1;
  const bStreams = b.streams ?? -1;
  if (aStreams !== bStreams) return bStreams - aStreams;
  return a.title.localeCompare(b.title);
});

const firstYear = Math.min(...DISCOGRAPHY.map((track) => track.year));

const formatPlays = (value?: number) =>
  typeof value === "number" && value > 0 ? value.toLocaleString("es-MX") : "—";

const cityFallback = [
  { city: "Ciudad de México", country: "MX", listeners: 614 },
  { city: "Guadalajara", country: "MX", listeners: 465 },
  { city: "Zapopan", country: "MX", listeners: 216 },
  { city: "Bogotá", country: "CO", listeners: 204 },
  { city: "Lima", country: "PE", listeners: 202 },
];

const cityMax = Math.max(...cityFallback.map((city) => city.listeners));
---

<ArtistLayout
  title="Artista"
  description="Gargut — expediente del artista: oyentes, catálogo y señal desde Guadalajara, México."
  theme="red"
  rail={{ number: "02", label: "Artista" }}
>
  <div class="artist-page">
    <div class="progress" aria-hidden="true"><span data-progress></span></div>

    <header class="hero">
      <div class="hero__meta">
        <span>Expediente / 003</span>
        <span>GDL · MX</span>
        <span class="hero__live"><i aria-hidden="true"></i> Spotify en vivo</span>
      </div>

      <div class="hero__main">
        <div class="hero__copy">
          <p class="eyebrow">Rap · Trap · Ruido propio</p>
          <h1 class="hero__title">
            <span>GAR</span>
            <span class="outline">GUT</span>
          </h1>
          <p class="hero__lead">
            Singles, colaboraciones y frecuencias bajas desde Guadalajara. Sin
            disquera grande, sin fórmula y sin pedir permiso.
          </p>
          <div class="hero__actions">
            <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--primary">
              Escuchar en Spotify <span aria-hidden="true">↗</span>
            </a>
            <a href="#catalogo" class="btn btn--outline" data-tab-link="catalogo">
              Ver catálogo <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <figure class="portrait">
          <div class="portrait__frame">
            <img
              src={ARTIST_PORTRAIT}
              alt="Gargut — retrato oficial de Spotify"
              width="640"
              height="640"
              loading="eager"
              decoding="async"
            />
            <span class="portrait__tag">FIG. 01</span>
          </div>
          <figcaption>Retrato oficial · Spotify for Artists</figcaption>
        </figure>
      </div>

      <div class="quick-stats" data-reveal>
        <article>
          <span class="quick-stats__label">Oyentes mensuales</span>
          <strong data-stat="listeners">{ARTIST_MONTHLY_LISTENERS.toLocaleString("es-MX")}</strong>
        </article>
        <article>
          <span class="quick-stats__label">Seguidores</span>
          <strong data-stat="followers">{ARTIST_FOLLOWERS.toLocaleString("es-MX")}</strong>
        </article>
        <article>
          <span class="quick-stats__label">Top track</span>
          <strong data-stat="top">{ARTIST_TOP_TRACK}</strong>
        </article>
      </div>
    </header>

    <nav class="tabs" role="tablist" aria-label="Secciones del artista">
      <button type="button" class="tabs__btn is-active" role="tab" aria-selected="true" aria-controls="panel-perfil" data-tab="perfil">
        <span>01</span> Perfil
      </button>
      <button type="button" class="tabs__btn" role="tab" aria-selected="false" aria-controls="panel-numeros" data-tab="numeros" tabindex="-1">
        <span>02</span> Números
      </button>
      <button type="button" class="tabs__btn" role="tab" aria-selected="false" aria-controls="panel-catalogo" data-tab="catalogo" tabindex="-1">
        <span>03</span> Catálogo
      </button>
      <button type="button" class="tabs__btn" role="tab" aria-selected="false" aria-controls="panel-conecta" data-tab="conecta" tabindex="-1">
        <span>04</span> Conecta
      </button>
    </nav>

    <section class="tab-panel is-active" id="panel-perfil" role="tabpanel" aria-labelledby="tab-perfil" data-panel="perfil">
      <div class="card bio" data-reveal>
        <span class="eyebrow">Bio / Spotify</span>
        <blockquote>“me sobra el Mojo y soy el Matusalén”</blockquote>
        <p>
          Gargut construye su catálogo a golpe de singles: colaboraciones,
          freestyles y un sello propio, <strong>dxf prod</strong>. Este expediente
          reúne lo que Spotify sabe de él: cuántos lo escuchan, desde dónde suena
          y qué track pega más fuerte. El resto se resuelve dándole play.
        </p>
        <div class="bio__facts">
          <span>Origen · Guadalajara, MX</span>
          <span>Activo desde · {firstYear}</span>
          <span>Sello · dxf prod</span>
          <span>Género · Rap / Trap</span>
        </div>
      </div>
    </section>

    <section class="tab-panel" id="panel-numeros" role="tabpanel" aria-labelledby="tab-numeros" data-panel="numeros" hidden>
      <div class="card">
        <div class="section-head">
          <h2>En números</h2>
          <span>Spotify / cada 30 min</span>
        </div>

        <div class="metrics" data-reveal>
          <article class="metric metric--big">
            <strong data-stat="listeners">{ARTIST_MONTHLY_LISTENERS.toLocaleString("es-MX")}</strong>
            <span>Oyentes mensuales</span>
          </article>
          <article class="metric">
            <strong data-stat="followers">{ARTIST_FOLLOWERS.toLocaleString("es-MX")}</strong>
            <span>Seguidores</span>
          </article>
          <article class="metric">
            <strong>{DISCOGRAPHY.length}</strong>
            <span>Lanzamientos</span>
          </article>
          <article class="metric metric--wide">
            <strong data-stat="top">{ARTIST_TOP_TRACK}</strong>
            <span>Track más escuchado</span>
          </article>
        </div>

        <p class="data-note" data-stats-note>Datos públicos de Spotify · respaldo local si la API no responde</p>
      </div>

      <div class="card cities-card" data-reveal>
        <div class="section-head">
          <h2>Dónde suena</h2>
          <span>Oyentes por ciudad</span>
        </div>
        <ul class="cities" data-cities>
          {cityFallback.map((city, index) => (
            <li class="city">
              <span class="city__rank">{String(index + 1).padStart(2, "0")}</span>
              <span class="city__name">{city.city}</span>
              <span class="city__bar" aria-hidden="true">
                <span style={`width:${Math.round((city.listeners / cityMax) * 100)}%`}></span>
              </span>
              <span class="city__count">{city.listeners.toLocaleString("es-MX")}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="tab-panel" id="panel-catalogo" role="tabpanel" aria-labelledby="tab-catalogo" data-panel="catalogo" hidden>
      <div class="card">
        <div class="section-head">
          <h2>Catálogo</h2>
          <span>{releases.length} releases · 2025—2026</span>
        </div>

        <ol class="releases" data-reveal>
          {releases.map((track, index) => (
            <li class="release" data-track-title={track.title}>
              <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                <span class="release__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="release__cover">
                  {track.coverUrl ? (
                    <img src={track.coverUrl} alt="" width="120" height="120" loading="lazy" decoding="async" />
                  ) : (
                    <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                  )}
                </span>
                <span class="release__info">
                  <strong>{track.title}</strong>
                  <span class="release__meta">
                    {track.year} · {track.type === "solo" ? "Solo" : "Colab"}
                    {track.collaborators?.length ? ` · ${track.collaborators.join(" / ")}` : ""}
                  </span>
                </span>
                <span class="release__plays">{formatPlays(track.streams)}</span>
                <span class="release__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="data-note">Reproducciones reales de Spotify · se actualizan automáticamente.</p>
      </div>
    </section>

    <section class="tab-panel" id="panel-conecta" role="tabpanel" aria-labelledby="tab-conecta" data-panel="conecta" hidden>
      <div class="card connect-card">
        <div class="section-head">
          <h2>Señal directa</h2>
          <span>Spotify / redes</span>
        </div>

        <div class="connect-grid" data-reveal>
          <div class="connect-copy">
            <h3>Todo el catálogo, sin intermediarios.</h3>
            <p>Dale play desde aquí mismo y sígueme en las plataformas donde suena Gargut.</p>
            <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--primary">
              Abrir perfil de artista <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="embed-frame">
            <div class="embed-frame__bar">
              <span>SPOTIFY / ARTIST</span>
              <span>GUT—003</span>
            </div>
            <iframe
              src={SPOTIFY_EMBED_ARTIST}
              width="100%"
              height="352"
              style="border:0;"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
              title="Gargut en Spotify"
            />
          </div>
        </div>

        <div class="social-grid">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a>
          <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener">Spotify <span aria-hidden="true">↗</span></a>
          <a href={YOUTUBE_URL} target="_blank" rel="noopener">YouTube <span aria-hidden="true">↗</span></a>
          <a href={TIKTOK_URL} target="_blank" rel="noopener">TikTok <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const tabs = Array.from(document.querySelectorAll("[data-tab]"));
      const panels = Array.from(document.querySelectorAll("[data-panel]"));
      const tablist = document.querySelector(".tabs");

      const activateTab = (name, options = {}) => {
        const target = panels.some((panel) => panel.dataset.panel === name) ? name : "perfil";

        tabs.forEach((tab) => {
          const active = tab.dataset.tab === target;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.tabIndex = active ? 0 : -1;
        });

        panels.forEach((panel) => {
          const active = panel.dataset.panel === target;
          panel.hidden = !active;
          panel.classList.toggle("is-active", active);
        });

        const panel = panels.find((item) => item.dataset.panel === target);
        panel?.querySelectorAll("[data-reveal]").forEach((element) => {
          element.classList.add("is-visible");
        });

        if (options.updateHash !== false) {
          history.replaceState(null, "", `#${target}`);
        }

        if (options.scroll) {
          window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
        }
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activateTab(tab.dataset.tab, { scroll: true }));
      });

      document.querySelectorAll("[data-tab-link]").forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          activateTab(link.dataset.tabLink, { scroll: true });
        });
      });

      if (tablist) {
        tablist.addEventListener("keydown", (event) => {
          if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;

          const currentIndex = tabs.findIndex((tab) => tab.classList.contains("is-active"));
          let nextIndex = currentIndex;

          if (event.key === "ArrowRight") nextIndex = (currentIndex + 1) % tabs.length;
          if (event.key === "ArrowLeft") nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = tabs.length - 1;

          event.preventDefault();
          tabs[nextIndex].focus();
          activateTab(tabs[nextIndex].dataset.tab);
        });
      }

      const initialTab = (window.location.hash || "").replace("#", "");
      activateTab(initialTab || "perfil", { updateHash: false });

      const progress = document.querySelector("[data-progress]");
      if (progress) {
        const updateProgress = () => {
          const root = document.documentElement;
          const max = root.scrollHeight - root.clientHeight;
          progress.style.width = `${max > 0 ? (root.scrollTop / max) * 100 : 0}%`;
        };
        window.addEventListener("scroll", updateProgress, { passive: true });
        window.addEventListener("resize", updateProgress);
        updateProgress();
      }

      const revealables = document.querySelectorAll("[data-reveal]");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealables.forEach((element) => element.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.1 }
        );
        revealables.forEach((element) => observer.observe(element));
      }

      const setText = (key, value) => {
        if (value === null || value === undefined || value === "") return;
        document.querySelectorAll(`[data-stat="${key}"]`).forEach((node) => {
          node.textContent = value;
        });
      };

      const formatNumber = (value) =>
        typeof value === "number" ? value.toLocaleString("es-MX") : null;

      const CITY_NAMES = {
        "Mexico City": "Ciudad de México",
        "Mexico city": "Ciudad de México",
        Bogota: "Bogotá",
        "Bogotá": "Bogotá",
      };

      const renderCities = (cities) => {
        const list = document.querySelector("[data-cities]");
        if (!list || !Array.isArray(cities) || cities.length === 0) return;

        const top = cities.slice(0, 5);
        const max = Math.max(...top.map((city) => Number(city.listeners) || 0), 1);
        const items = Array.from(list.querySelectorAll(".city"));

        items.forEach((item, index) => {
          const city = top[index];
          if (!city) {
            item.hidden = true;
            return;
          }

          item.hidden = false;
          const name = CITY_NAMES[city.city] || city.city;
          const rank = item.querySelector(".city__rank");
          const label = item.querySelector(".city__name");
          const fill = item.querySelector(".city__bar span");
          const count = item.querySelector(".city__count");

          if (rank) rank.textContent = String(index + 1).padStart(2, "0");
          if (label) label.textContent = name;
          if (fill) fill.style.width = `${Math.round(((Number(city.listeners) || 0) / max) * 100)}%`;
          if (count) count.textContent = (Number(city.listeners) || 0).toLocaleString("es-MX");
        });
      };

      const normalize = (value) => String(value || "").trim().toLowerCase();

      const applyPlays = (entries, key) => {
        if (!Array.isArray(entries) || entries.length === 0) return;

        const stats = new Map(
          entries
            .filter((entry) => entry && entry[key])
            .map((entry) => [normalize(entry[key]), entry.playcount])
        );

        document.querySelectorAll(".release[data-track-title]").forEach((item) => {
          const playcount = stats.get(normalize(item.dataset.trackTitle));
          if (typeof playcount !== "number") return;

          const plays = item.querySelector(".release__plays");
          if (plays) plays.textContent = playcount.toLocaleString("es-MX");
        });
      };

      fetch("/api/discography-stats", { headers: { Accept: "application/json" } })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          if (!data || data.source !== "spotify") return;
          applyPlays(data.tracks, "title");
        })
        .catch(() => {});

      fetch("/api/artist-stats", { headers: { Accept: "application/json" } })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          if (!data || data.source !== "spotify") return;

          setText("listeners", formatNumber(data.monthlyListeners));
          setText("followers", formatNumber(data.followers));
          setText("top", data.topTrack);
          renderCities(data.topCities);
          applyPlays(data.topTracks, "name");

          const note = document.querySelector("[data-stats-note]");
          if (note) {
            note.textContent = data.stale
              ? "Datos de Spotify · copia más reciente guardada, reintentando en vivo"
              : "Datos en vivo de Spotify · se actualizan cada 30 min";
          }
        })
        .catch(() => {});
    })();
  </script>

  <style>
    .artist-page {
      width: 100%;
      max-width: 1320px;
      margin: 0 auto;
      padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 4vw, 2.5rem) 4rem;
    }

    .progress {
      position: fixed;
      top: var(--header-h);
      left: 0;
      right: 0;
      z-index: 260;
      height: 2px;
      background: var(--line-soft);
      pointer-events: none;
    }
    .progress span {
      display: block;
      height: 100%;
      width: 0;
      background: var(--accent);
      transition: width 0.12s linear;
    }

    .hero {
      position: relative;
      padding: clamp(1.25rem, 4vw, 3rem);
      border: 1px solid var(--line-strong);
      border-radius: 24px;
      background:
        radial-gradient(120% 140% at 100% 0%, rgba(255, 35, 56, 0.2), transparent 60%),
        linear-gradient(180deg, var(--bg-elevated), var(--bg-soft));
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
      overflow: hidden;
    }

    .hero__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1.5rem;
      padding-bottom: 1rem;
      margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      border-bottom: 1px solid var(--line);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .hero__live {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-left: auto;
      color: var(--accent);
    }
    .hero__live i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    .hero__main {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: end;
    }

    .hero__title {
      display: flex;
      flex-direction: column;
      font-family: var(--font-display);
      font-size: clamp(4rem, 18vw, 9.5rem);
      line-height: 0.82;
      letter-spacing: -0.02em;
      color: var(--ink);
      text-transform: uppercase;
      text-shadow: 0 16px 60px rgba(0, 0, 0, 0.7);
    }
    .hero__title .outline {
      color: transparent;
      -webkit-text-stroke: 2px var(--ink);
    }

    .hero__lead {
      max-width: 48ch;
      margin-top: 1.3rem;
      color: var(--ink);
      font-size: clamp(0.92rem, 1.4vw, 1.05rem);
      line-height: 1.7;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      margin-top: 2rem;
    }

    .portrait {
      margin: 0;
      width: min(100%, 340px);
      justify-self: start;
    }
    .portrait__frame {
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border: 1px solid var(--line-strong);
      border-radius: 18px;
      background: var(--bg-elevated);
      box-shadow: 10px 10px 0 var(--accent);
    }
    .portrait__frame img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.05);
      transition: filter 0.35s ease, transform 0.5s ease;
    }
    .portrait:hover img { filter: grayscale(0); transform: scale(1.03); }
    .portrait__tag {
      position: absolute;
      right: 0;
      bottom: 0;
      padding: 0.35rem 0.5rem;
      background: var(--accent);
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.12em;
    }
    .portrait figcaption {
      margin-top: 1rem;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .quick-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
      margin-top: clamp(1.5rem, 4vw, 2.5rem);
    }
    .quick-stats article {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--surface);
    }
    .quick-stats__label {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .quick-stats strong {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 4vw, 2.3rem);
      font-weight: 400;
      line-height: 1;
      color: var(--ink);
      overflow-wrap: anywhere;
    }

    .tabs {
      position: sticky;
      top: calc(var(--header-h) + 0.6rem);
      z-index: 250;
      display: flex;
      gap: 0.3rem;
      overflow-x: auto;
      margin: 1.25rem 0 1.5rem;
      padding: 0.35rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.9);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(12px);
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }
    .tabs__btn {
      flex: 1 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.7rem 0.9rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.18s ease, color 0.18s ease;
    }
    .tabs__btn span { color: var(--accent); }

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import { INSTAGRAM_URL, SITE_TITLE } from "../data/siteConfig";

const sections = [
  {
    title: "Responsable",
    body: `${SITE_TITLE} es el responsable del tratamiento de los datos personales que proporcionas a través del Drop Room.`,
  },
  {
    title: "Datos que recopilamos",
    body:
      "Nombre, correo electrónico y número de WhatsApp. También registramos la fecha en que aceptaste este aviso y tu consentimiento para recibir comunicaciones.",
  },
  {
    title: "Finalidad",
    body:
      "Usamos tus datos para enviarte novedades sobre lanzamientos, contenido exclusivo, fechas de shows y promociones relacionadas con Gargut. No vendemos ni compartimos tus datos con terceros para fines publicitarios.",
  },
  {
    title: "Conservación y baja",
    body:
      "Conservamos tus datos mientras mantengas tu suscripción al Drop Room. Puedes solicitar la baja o la eliminación de tus datos en cualquier momento escribiéndonos por Instagram.",
  },
  {
    title: "Derechos ARCO",
    body:
      "Puedes solicitar el acceso, rectificación, cancelación u oposición al tratamiento de tus datos personales contactándonos por Instagram.",
    link: true,
  },
  {
    title: "Cambios a este aviso",
    body:
      "Podemos actualizar este aviso para reflejar cambios en nuestras prácticas. La versión vigente estará siempre publicada en esta página.",
  },
];
---

<ArtistLayout
  title="Aviso de privacidad"
  description="Aviso de privacidad de Gargut: qué datos recopilamos en el Drop Room, para qué los usamos y cómo ejercer tus derechos."
>
  <section class="privacy-page" aria-labelledby="privacy-title">
    <aside class="privacy-aside">
      <div class="privacy-aside__sticky">
        <span class="kicker">Legal / 2026</span>
        <h1 id="privacy-title" class="page-title privacy-title">
          Aviso de<br />privacidad<span aria-hidden="true">*</span>
        </h1>
        <div class="privacy-meta">
          <span>Última actualización</span>
          <strong>28 / 10 / 2026</strong>
        </div>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="privacy-contact">
          Contacto directo <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>

    <div class="privacy-content">
      {sections.map((section, i) => (
        <article class="legal-item">
          <span class="legal-item__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div class="legal-item__body">
            <h2>{section.title}</h2>
            <p>
              {section.body}
              {section.link ? (
                <>
                  {" "}
                  <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Abrir Instagram ↗</a>
                </>
              ) : null}
            </p>
          </div>
        </article>
      ))}

      <p class="privacy-end">
        Fin del documento. GGT / Guadalajara, México.
      </p>
    </div>
  </section>

  <PageFooter />
</ArtistLayout>

<style>
  .privacy-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .privacy-title {
    display: block;
    margin-top: 1rem;
    font-size: clamp(3rem, 13vw, 6.4rem);
    line-height: 0.8;
  }
  .privacy-title span {
    display: inline-block;
    margin-left: 0.08em;
    font-family: var(--font-mono);
    font-size: 0.16em;
    line-height: 1;
    color: var(--accent);
    vertical-align: top;
  }

  .privacy-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: 320px;
    margin-top: 1.75rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line-strong);
  }
  .privacy-meta span {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .privacy-meta strong {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .privacy-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .privacy-contact:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .privacy-content {
    border-top: 1px solid var(--line-strong);
  }

  .legal-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1.25rem 0.1rem 1.35rem;
    border-bottom: 1px solid var(--line);
  }
  .legal-item__index {
    padding-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .legal-item h2 {
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4.5vw, 1.9rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .legal-item p {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.75;
  }
  .legal-item p a {
    color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-line);
  }
  .legal-item p a:hover { color: var(--accent-bright); }

  .privacy-end {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  @media (min-width: 900px) {
    .privacy-page {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4rem;
      padding: 3.5rem 2.25rem 5rem;
    }
    .privacy-aside__sticky {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
    .legal-item { padding: 1.5rem 0.1rem 1.6rem; }
    .legal-item__body { padding-top: 0.15rem; }
  }
</style>

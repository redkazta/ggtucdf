---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import { INSTAGRAM_URL, SITE_TITLE } from "../data/siteConfig";

const sections = [
  {
    title: "Responsable",
    body: `${SITE_TITLE} es el responsable del tratamiento de los datos personales que proporcionas a través del Drop Room.`,
  },
  {
    title: "Datos que recopilamos",
    body:
      "Nombre, correo electrónico y número de WhatsApp. También registramos la fecha en que aceptaste este aviso y tu consentimiento para recibir comunicaciones.",
  },
  {
    title: "Finalidad",
    body:
      "Usamos tus datos para enviarte novedades sobre lanzamientos, contenido exclusivo, fechas de shows y promociones relacionadas con Gargut. No vendemos ni compartimos tus datos con terceros para fines publicitarios.",
  },
  {
    title: "Conservación y baja",
    body:
      "Conservamos tus datos mientras mantengas tu suscripción al Drop Room. Puedes solicitar la baja o la eliminación de tus datos en cualquier momento escribiéndonos por Instagram.",
  },
  {
    title: "Derechos ARCO",
    body:
      "Puedes solicitar el acceso, rectificación, cancelación u oposición al tratamiento de tus datos personales contactándonos por Instagram.",
    link: true,
  },
  {
    title: "Cambios a este aviso",
    body:
      "Podemos actualizar este aviso para reflejar cambios en nuestras prácticas. La versión vigente estará siempre publicada en esta página.",
  },
];
---

<ArtistLayout
  title="Aviso de privacidad"
  description="Aviso de privacidad de Gargut: qué datos recopilamos en el Drop Room, para qué los usamos y cómo ejercer tus derechos."
  theme="red"
  board
>
  <div class="board-page">
    <header class="board-head">
      <h1 class="board-head__title">Privacidad<span aria-hidden="true">*</span></h1>
      <div class="board-head__meta">
        <span>Legal / 2026</span>
        <span>Actualizado <b>28 / 10 / 2026</b></span>
        <span>GDL / MX</span>
      </div>
    </header>

    <div class="board-grid privacy-board">
      <section class="board-panel index-panel">
        <div class="board-panel__head">
          <span>Índice</span>
          <span>{sections.length} cláusulas</span>
        </div>
        <div class="board-panel__body index-panel__body">
          <nav aria-label="Índice del aviso">
            {sections.map((section, i) => (
              <a href={`#legal-${i + 1}`}>
                <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {section.title}
              </a>
            ))}
          </nav>

          <div class="index-actions">
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Contacto ↗</a>
            <a href="/drop-room">Drop Room →</a>
          </div>
        </div>
      </section>

      <section class="board-panel doc-panel">
        <div class="board-panel__head">
          <span>Documento</span>
          <span>GGT / Legal</span>
        </div>
        <div class="board-panel__body doc-panel__body">
          {sections.map((section, i) => (
            <article class="legal-item" id={`legal-${i + 1}`}>
              <div class="legal-item__head">
                <span class="legal-item__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h2>{section.title}</h2>
              </div>
              <p>
                {section.body}
                {section.link ? (
                  <>
                    {" "}
                    <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Abrir Instagram ↗</a>
                  </>
                ) : null}
              </p>
            </article>
          ))}

          <p class="privacy-end">Fin del documento. GGT / Guadalajara, México.</p>
        </div>
      </section>
    </div>
  </div>
</ArtistLayout>

<style>
  .privacy-board {
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
    grid-template-rows: minmax(0, 1fr);
  }

  .index-panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .index-panel__body nav {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .index-panel__body nav a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.38rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
  }
  .index-panel__body nav a span { color: var(--accent); }
  .index-panel__body nav a:hover { background: var(--accent); }
  .index-panel__body nav a:hover span { color: #ffffff; }
  .index-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .index-actions a {
    padding: 0.35rem 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
  }
  .index-actions a:hover { background: var(--accent); border-color: var(--accent); }

  .doc-panel__body { scroll-behavior: smooth; }
  .legal-item {
    padding: 0 0 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    scroll-margin-top: 1rem;
  }
  .legal-item:last-of-type { border-bottom: 0; }
  .legal-item__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }
  .legal-item__index {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1;
    color: var(--accent);
  }
  .legal-item h2 {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.4rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: #ffffff;
  }
  .legal-item p {
    font-size: 0.7rem;
    line-height: 1.65;
    color: #ffffff;
  }
  .legal-item p a { color: var(--accent); text-underline-offset: 3px; }
  .privacy-end {
    padding: 0.6rem;
    border: 1px dashed rgba(255, 255, 255, 0.3);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.6;
    text-transform: uppercase;
    color: #ffffff;
  }

  @media (min-width: 901px) and (max-height: 820px) {
    .index-panel__body nav { gap: 0; }
    .index-panel__body nav a { padding: 0.3rem 0.4rem; }
    .legal-item { padding-bottom: 0.6rem; margin-bottom: 0.6rem; }
    .legal-item__head { margin-bottom: 0.25rem; }
    .legal-item h2 { font-size: clamp(0.95rem, 1.5vw, 1.2rem); }
    .legal-item p { font-size: 0.65rem; line-height: 1.5; }
  }

  @media (max-width: 900px) {
    .privacy-board {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 0.38fr) minmax(0, 1.62fr);
      overflow: hidden;
    }

    .index-panel__body { gap: 0.25rem; padding: 0.4rem 0.5rem; }
    .index-panel__body nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.02rem 0.4rem;
    }
    .index-panel__body nav a { padding: 0.1rem 0.2rem; font-size: 0.42rem; }
    .index-actions { gap: 0.25rem; padding-top: 0.25rem; }
    .index-actions a { padding: 0.18rem 0.3rem; font-size: 0.4rem; }

    .doc-panel__body { padding: 0.4rem 0.5rem; }
    .legal-item { padding-bottom: 0.4rem; margin-bottom: 0.4rem; }
    .legal-item__head { gap: 0.4rem; margin-bottom: 0.15rem; }
    .legal-item__index { font-size: 0.85rem; }
    .legal-item h2 { font-size: 0.8rem; }
    .legal-item p { font-size: 0.54rem; line-height: 1.38; }
    .privacy-end { padding: 0.3rem; font-size: 0.4rem; line-height: 1.35; }
  }

  @media (max-width: 900px) and (max-height: 700px) {
    .index-panel__body { gap: 0.15rem; padding: 0.3rem 0.45rem; }
    .index-panel__body nav a { padding: 0.08rem 0.2rem; }
    .index-actions { gap: 0.2rem; padding-top: 0.15rem; }
    .index-actions a { padding: 0.15rem 0.25rem; }
    .legal-item { padding-bottom: 0.28rem; margin-bottom: 0.28rem; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import { INSTAGRAM_URL, SITE_TITLE } from "../data/siteConfig";

const sections = [
  {
    title: "Responsable",
    body: `${SITE_TITLE} es el responsable del tratamiento de los datos personales que proporcionas a través del Drop Room.`,
  },
  {
    title: "Datos que recopilamos",
    body:
      "Nombre, correo electrónico y número de WhatsApp. También registramos la fecha en que aceptaste este aviso y tu consentimiento para recibir comunicaciones.",
  },
  {
    title: "Finalidad",
    body:
      "Usamos tus datos para enviarte novedades sobre lanzamientos, contenido exclusivo, fechas de shows y promociones relacionadas con Gargut. No vendemos ni compartimos tus datos con terceros para fines publicitarios.",
  },
  {
    title: "Conservación y baja",
    body:
      "Conservamos tus datos mientras mantengas tu suscripción al Drop Room. Puedes solicitar la baja o la eliminación de tus datos en cualquier momento escribiéndonos por Instagram.",
  },
  {
    title: "Derechos ARCO",
    body:
      "Puedes solicitar el acceso, rectificación, cancelación u oposición al tratamiento de tus datos personales contactándonos por Instagram.",
    link: true,
  },
  {
    title: "Cambios a este aviso",
    body:
      "Podemos actualizar este aviso para reflejar cambios en nuestras prácticas. La versión vigente estará siempre publicada en esta página.",
  },
];
---

<ArtistLayout
  title="Aviso de privacidad"
  description="Aviso de privacidad de Gargut: qué datos recopilamos en el Drop Room, para qué los usamos y cómo ejercer tus derechos."
  theme="red"
  rail={{ number: "05", label: "Legal" }}
>
  <div class="internal-shell privacy-page">
    <div class="privacy-layout">
      <aside class="privacy-aside">
        <div class="internal-hero privacy-hero">
          <div class="internal-hero__top">
            <span class="kicker">Legal / 2026</span>
            <span class="internal-hero__note">GDL · MX</span>
          </div>

          <h1 class="internal-hero__title privacy-title">
            Aviso de<br />privacidad<span aria-hidden="true">*</span>
          </h1>

          <div class="privacy-meta">
            <span>Última actualización</span>
            <strong>28 / 10 / 2026</strong>
          </div>

          <div class="privacy-actions">
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--primary">
              Contacto directo <span aria-hidden="true">↗</span>
            </a>
            <a href="/drop-room" class="btn btn--outline">
              Ir al Drop Room <span aria-hidden="true">→</span>
            </a>
          </div>

          <nav class="privacy-index" aria-label="Índice del aviso">
            <span class="privacy-index__label">Índice</span>
            {sections.map((section, i) => (
              <a href={`#legal-${i + 1}`}>
                <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {section.title}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <div id="privacy-content" class="privacy-content">
        {sections.map((section, i) => (
          <article class="legal-item" id={`legal-${i + 1}`}>
            <div class="legal-item__head">
              <span class="legal-item__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h2>{section.title}</h2>
            </div>
            <p>
              {section.body}
              {section.link ? (
                <>
                  {" "}
                  <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Abrir Instagram ↗</a>
                </>
              ) : null}
            </p>
          </article>
        ))}

        <p class="privacy-end">
          Fin del documento. GGT / Guadalajara, México.
        </p>
      </div>
    </div>
  </div>

  <PageFooter />
</ArtistLayout>

<style>
  .privacy-page { padding-top: clamp(0.75rem, 2.5vw, 1.25rem); }

  .privacy-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .privacy-hero { width: 100%; }

  .privacy-hero .privacy-title {
    display: block;
    font-size: clamp(2.7rem, 10vw, 5rem);
    line-height: 0.82;
  }
  .privacy-hero .privacy-title span {
    display: inline-block;
    margin-left: 0.08em;
    font-size: 0.18em;
    vertical-align: top;
  }

  .privacy-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .privacy-meta span {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .privacy-meta strong {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
    white-space: nowrap;
  }

  .privacy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .privacy-index {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .privacy-index__label {
    padding: 0 0.7rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .privacy-index a {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.5rem 0.7rem;
    border-radius: 9px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .privacy-index a span { color: var(--accent); }
  .privacy-index a:hover { background: var(--surface-2); }

  .privacy-content {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0 clamp(1.1rem, 3vw, 1.75rem);
    background: #000000;
    border: 1px solid var(--accent);
    box-shadow: 12px 12px 0 rgba(0, 0, 0, 0.35);
  }

  .legal-item {
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .legal-item:last-of-type { border-bottom: 0; }
  .legal-item__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.65rem;
  }
  .legal-item__index {
    display: block;
    flex-shrink: 0;
    background: none;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }
  .legal-item h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .legal-item p {
    max-width: 68ch;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--ink);
  }
  .legal-item p a {
    color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-line);
  }
  .legal-item p a:hover { color: var(--accent-bright); }

  .privacy-end {
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    border: 1px dashed rgba(255, 255, 255, 0.35);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .privacy-layout {
      grid-template-columns: minmax(320px, 0.85fr) minmax(0, 1.15fr);
      gap: 1.5rem;
    }
    .privacy-aside {
      position: sticky;
      top: calc(var(--header-h) + 1.25rem);
    }
  }
</style>

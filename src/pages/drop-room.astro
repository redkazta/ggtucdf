---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import DropRoomForm from "../components/DropRoomForm.astro";
import PageFooter from "../components/PageFooter.astro";
---

<ArtistLayout
  title="Drop Room"
  description="Únete al Drop Room de Gargut y entérate antes que nadie del próximo lanzamiento y del contenido exclusivo."
>
  <section class="drop-room-page" aria-labelledby="drop-room-title">
    <div class="drop-intro">
      <span class="kicker">04 / Drop Room</span>
      <h1 id="drop-room-title" class="page-title page-title--xl">
        Entra antes<br />que nadie<span aria-hidden="true">*</span>
      </h1>
      <p class="intro">
        Regístrate para recibir el próximo drop, contenido exclusivo y fechas de
        shows directamente en tu email.
      </p>

      <ul class="benefits">
        <li>
          <span class="benefits__index" aria-hidden="true">01</span>
          <div>
            <strong>Acceso anticipado</strong>
            <p>Escucha y mira antes de que salga al público.</p>
          </div>
        </li>
        <li>
          <span class="benefits__index" aria-hidden="true">02</span>
          <div>
            <strong>Contenido exclusivo</strong>
            <p>Material que no se publica en ningún otro lado.</p>
          </div>
        </li>
        <li>
          <span class="benefits__index" aria-hidden="true">03</span>
          <div>
            <strong>Fechas de shows</strong>
            <p>Guadalajara, México y lo que venga después.</p>
          </div>
        </li>
      </ul>

      <p class="privacy-note">
        Solo usamos tus datos para enviarte novedades de Gargut. No los vendemos ni
        los compartimos con terceros. Puedes darte de baja cuando quieras.
      </p>
    </div>

    <div class="drop-form-col">
      <DropRoomForm />
    </div>
  </section>

  <PageFooter />
</ArtistLayout>

<style>
  .drop-room-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .drop-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .page-title--xl {
    display: flex;
    align-items: flex-start;
    gap: 0.08em;
    font-size: clamp(3.2rem, 15vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.02em;
    margin-top: 0.9rem;
  }
  .page-title--xl span {
    font-family: var(--font-mono);
    font-size: 0.14em;
    line-height: 1;
    margin-top: 0.22em;
    color: var(--accent);
    letter-spacing: 0;
  }

  .intro {
    max-width: 460px;
    margin: 1.5rem 0 2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .benefits {
    width: 100%;
    max-width: 520px;
    list-style: none;
    border-top: 1px solid var(--line-strong);
    margin-bottom: 1.75rem;
  }
  .benefits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 0.85rem 0.1rem;
    border-bottom: 1px solid var(--line);
  }
  .benefits__index {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    padding-top: 0.2rem;
  }
  .benefits strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  .benefits p {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .privacy-note {
    max-width: 460px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
  }

  .drop-form-col {
    width: 100%;
    max-width: 480px;
  }

  @media (min-width: 1024px) {
    .drop-room-page {
      grid-template-columns: 1.08fr 0.92fr;
      align-items: start;
      gap: 4rem;
      padding: 3.5rem 2.25rem 5rem;
    }
    .drop-form-col {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      max-width: none;
    }
  }
</style>

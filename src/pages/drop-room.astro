---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import DropRoomForm from "../components/DropRoomForm.astro";
import PageFooter from "../components/PageFooter.astro";
---

<ArtistLayout
  title="Drop Room"
  description="Únete al Drop Room de Gargut y entérate antes que nadie del próximo lanzamiento y del contenido exclusivo."
>
  <section class="drop-room-page" aria-labelledby="drop-room-title">
    <span class="eyebrow">Drop Room</span>
    <h1 id="drop-room-title" class="page-title">Entra antes que nadie</h1>
    <p class="intro">
      Regístrate para recibir el próximo drop, contenido exclusivo y fechas de
      shows directamente en tu email.
    </p>

    <DropRoomForm />

    <p class="privacy-note">
      Solo usamos tus datos para enviarte novedades de Gargut. No los vendemos ni
      los compartimos con terceros. Puedes darte de baja cuando quieras.
    </p>

    <PageFooter />
  </section>
</ArtistLayout>

<style>
  .drop-room-page {
    max-width: 560px;
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
    text-align: center;
  }
  .eyebrow {
    display: block;
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: rgba(255, 50, 50, 0.75);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.8rem, 6vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #fff;
    margin-bottom: 1rem;
    text-shadow: 0 0 24px rgba(255, 50, 50, 0.35);
  }
  .intro {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .privacy-note {
    max-width: 400px;
    margin: 1.5rem auto 0;
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.7rem;
    line-height: 1.6;
  }
</style>

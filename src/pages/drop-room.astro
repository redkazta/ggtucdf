---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import DropRoomForm from "../components/DropRoomForm.astro";
import PageFooter from "../components/PageFooter.astro";

const benefits = [
  {
    title: "Acceso anticipado",
    body: "Escucha y mira antes de que salga al público.",
  },
  {
    title: "Contenido exclusivo",
    body: "Material que no se publica en ningún otro lado.",
  },
  {
    title: "Fechas de shows",
    body: "Guadalajara, México y lo que venga después.",
  },
];
---

<ArtistLayout
  title="Drop Room"
  description="Únete al Drop Room de Gargut y entérate antes que nadie del próximo lanzamiento y del contenido exclusivo."
  theme="red"
  rail={{
    number: "04",
    label: "Drop Room",
    links: [
      { href: "#por-que", label: "Por qué entrar" },
      { href: "#registro", label: "Registro" },
    ],
  }}
>
  <div class="internal-shell drop-page">
    <header class="internal-hero">
      <div class="internal-hero__top">
        <span class="kicker">04 / Drop Room</span>
        <span class="internal-hero__note">Acceso anticipado</span>
        <span class="internal-hero__live"><i aria-hidden="true"></i> Registro abierto</span>
      </div>

      <div class="drop-hero">
        <div>
          <h1 class="internal-hero__title">Entra antes<br />que nadie<span aria-hidden="true">*</span></h1>
          <p class="internal-hero__lead">
            Regístrate para recibir el próximo drop, contenido exclusivo y fechas
            de shows directamente en tu email.
          </p>
          <div class="internal-hero__chips">
            <span class="chip chip--accent">Email</span>
            <span class="chip">WhatsApp</span>
            <span class="chip">Gratis</span>
          </div>
        </div>

        <dl class="drop-facts">
          <div>
            <dt>Canal</dt>
            <dd>Email + WhatsApp</dd>
          </div>
          <div>
            <dt>Acceso</dt>
            <dd>Anticipado</dd>
          </div>
          <div>
            <dt>Costo</dt>
            <dd>$0</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="drop-layout">
      <section class="drop-pitch" id="por-que" aria-labelledby="dropBenefitsTitle">
        <div class="drop-pitch__head">
          <span class="kicker">Por qué entrar</span>
          <h2 id="dropBenefitsTitle">Lo que recibes</h2>
        </div>

        <ol class="benefits">
          {benefits.map((benefit, i) => (
            <li>
              <span class="benefits__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <strong>{benefit.title}</strong>
                <p>{benefit.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="privacy-card">
          <span class="privacy-card__label">Privacidad</span>
          <p>
            Solo usamos tus datos para enviarte novedades de Gargut. No los vendemos
            ni los compartimos con terceros. Puedes darte de baja cuando quieras.
          </p>
          <a href="/privacidad" class="privacy-card__link">
            Leer aviso de privacidad <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="drop-quote">
          <span aria-hidden="true">«</span>
          <p>El siguiente drop no se anuncia: se filtra primero aquí.</p>
        </div>
      </section>

      <div class="drop-form-col" id="registro">
        <DropRoomForm />
      </div>
    </div>
  </div>

  <PageFooter />
</ArtistLayout>

<style>
  .drop-page { padding-top: clamp(0.75rem, 2.5vw, 1.25rem); }

  .drop-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: end;
  }

  .drop-hero .internal-hero__title {
    display: block;
    line-height: 0.82;
  }
  .drop-hero .internal-hero__title span {
    display: inline-block;
    margin-top: 0;
    vertical-align: top;
  }

  .drop-facts {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .drop-facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .drop-facts dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .drop-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    line-height: 1.05;
    text-align: right;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Layout principal */
  .drop-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
    align-items: start;
  }

  .drop-pitch {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3.5vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg-soft));
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.45);
  }

  .drop-pitch__head h2 {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.7rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }

  .benefits {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }
  .benefits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    padding: 1rem 0;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
  }
  .benefits__index {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .benefits strong {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .benefits p {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .privacy-card {
    padding: 1rem 0 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
  }
  .privacy-card__label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .privacy-card p {
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--ink);
  }
  .privacy-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
  }
  .privacy-card__link:hover { color: var(--accent); }

  .drop-quote {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .drop-quote span {
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 0.8;
    color: var(--accent);
  }
  .drop-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    line-height: 1.2;
    color: var(--ink);
  }

  .drop-form-col { width: 100%; }

  @media (min-width: 900px) {
    .drop-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 320px); }
    .drop-facts { align-self: end; }
    .drop-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      gap: 1.5rem;
    }
    .drop-form-col {
      position: sticky;
      top: calc(var(--header-h) + 1.25rem);
    }
  }

  @media (max-width: 420px) {
    .drop-facts dd { font-size: 0.95rem; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import DropRoomForm from "../components/DropRoomForm.astro";
import PageFooter from "../components/PageFooter.astro";
---

<ArtistLayout
  title="Drop Room"
  description="Únete al Drop Room de Gargut y entérate antes que nadie del próximo lanzamiento y del contenido exclusivo."
>
  <section class="drop-room-page" aria-labelledby="drop-room-title">
    <span class="eyebrow">Drop Room</span>
    <h1 id="drop-room-title" class="page-title">Entra antes que nadie</h1>
    <p class="intro">
      Regístrate para recibir el próximo drop, contenido exclusivo y fechas de
      shows directamente en tu email.
    </p>

    <DropRoomForm />

    <p class="privacy-note">
      Solo usamos tus datos para enviarte novedades de Gargut. No los vendemos ni
      los compartimos con terceros. Puedes darte de baja cuando quieras.
    </p>

    <PageFooter />
  </section>
</ArtistLayout>

<style>
  .drop-room-page {
    position: relative;
    max-width: 620px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 2rem;
    text-align: center;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--accent-bright);
    text-transform: uppercase;
    margin-bottom: 0.6rem;
    opacity: 0.9;
  }

  .page-title {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text);
    margin-bottom: 1.1rem;
    text-shadow: 0 0 40px rgba(225, 29, 46, 0.3);
  }

  .intro {
    max-width: 460px;
    margin: 0 auto 2.25rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .privacy-note {
    max-width: 420px;
    margin: 1.75rem auto 0;
    color: var(--text-dim);
    font-size: 0.7rem;
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .drop-room-page { padding-top: 4.5rem; }
  }
</style>

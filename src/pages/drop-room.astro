---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import DropRoomForm from "../components/DropRoomForm.astro";

const benefits = [
  { title: "Acceso anticipado", body: "Escucha y mira antes de que salga al público." },
  { title: "Contenido exclusivo", body: "Material que no se publica en ningún otro lado." },
  { title: "Fechas de shows", body: "Guadalajara, México y lo que venga después." },
];
---

<ArtistLayout
  title="Drop Room"
  description="Únete al Drop Room de Gargut y entérate antes que nadie del próximo lanzamiento y del contenido exclusivo."
  theme="red"
  board
>
  <div class="board-page">
    <header class="board-head">
      <h1 class="board-head__title">Drop Room<span aria-hidden="true">*</span></h1>
      <div class="board-head__meta">
        <span>Acceso <b>anticipado</b></span>
        <span>Email + WhatsApp</span>
        <span>Costo <b>$0</b></span>
      </div>
    </header>

    <div class="board-grid drop-board">
      <section class="board-panel pitch-panel">
        <div class="board-panel__head">
          <span>Por qué entrar</span>
          <span>GGT / Drop</span>
        </div>
        <div class="board-panel__body pitch-panel__body">
          <h2>Entra antes que nadie</h2>
          <p class="pitch-lead">
            Recibe el próximo drop, contenido exclusivo y fechas de shows
            directamente en tu email.
          </p>

          <ol class="benefits">
            {benefits.map((benefit, i) => (
              <li>
                <span class="benefits__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <strong>{benefit.title}</strong>
                  <p>{benefit.body}</p>
                </div>
              </li>
            ))}
          </ol>

          <p class="drop-privacy">
            Solo usamos tus datos para enviarte novedades de Gargut. No los vendemos
            ni compartimos con terceros.
            <a href="/privacidad">Aviso de privacidad ↗</a>
          </p>
        </div>
      </section>

      <section class="board-panel form-panel">
        <div class="board-panel__body board-panel__body--flush form-panel__body">
          <DropRoomForm />
        </div>
      </section>
    </div>
  </div>
</ArtistLayout>

<style>
  .drop-board {
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-rows: minmax(0, 1fr);
  }

  .pitch-panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .pitch-panel__body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    font-weight: 400;
    line-height: 0.92;
    text-transform: uppercase;
    color: #ffffff;
  }
  .pitch-lead {
    font-size: 0.78rem;
    line-height: 1.55;
    color: #ffffff;
  }

  .benefits {
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }
  .benefits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .benefits__index {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    line-height: 1;
  }
  .benefits strong {
    display: block;
    margin-bottom: 0.1rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: #ffffff;
  }
  .benefits p {
    font-size: 0.68rem;
    line-height: 1.5;
    color: #ffffff;
  }
  .drop-privacy {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1.65;
    color: #ffffff;
  }
  .drop-privacy a {
    display: inline-block;
    margin-top: 0.3rem;
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .form-panel__body {
    display: flex;
    min-height: 0;
    overflow: auto;
  }
  .form-panel__body :global(.drop-room-form) { height: auto; }

  @media (min-width: 901px) and (max-height: 820px) {
    .pitch-panel__body { gap: 0.45rem; }
    .pitch-panel__body h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }
    .benefits li { padding: 0.45rem 0; }
    .form-panel__body :global(.form-head) { padding: 0.5rem 0.9rem; }
    .form-panel__body :global(.form-body) { gap: 0.65rem; padding: 0.8rem 1rem; }
    .form-panel__body :global(input) { padding: 0.6rem 0.8rem; }
    .form-panel__body :global(.checkbox-label) { padding: 0.6rem 0.7rem; }
    .form-panel__body :global(button) { padding: 0.75rem 0.9rem; }
    .form-panel__body :global(.form-foot) { padding: 0.5rem 0.9rem; }
  }

  @media (max-width: 900px) {
    .drop-board {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 0.72fr) minmax(0, 1.28fr);
      overflow: hidden;
    }

    .pitch-panel__body { gap: 0.2rem; padding: 0.4rem 0.5rem; }
    .pitch-panel__body h2 { font-size: clamp(1.05rem, 4.5vw, 1.25rem); line-height: 0.95; }
    .pitch-lead { font-size: 0.6rem; line-height: 1.25; }
    .benefits li { gap: 0.45rem; padding: 0.12rem 0; }
    .benefits__index { width: 18px; height: 18px; font-size: 0.4rem; }
    .benefits strong { font-size: 0.8rem; }
    .benefits p { font-size: 0.54rem; line-height: 1.25; }
    .drop-privacy { margin-top: auto; font-size: 0.38rem; line-height: 1.25; }
    .drop-privacy a { margin-top: 0.1rem; }

    .form-panel__body { overflow: hidden; }
    .form-panel__body :global(.drop-room-form) { height: 100%; border-radius: 0; }
    .form-panel__body :global(.form-head) { padding: 0.3rem 0.5rem; }
    .form-panel__body :global(.form-head__label),
    .form-panel__body :global(.form-head__status) { font-size: 0.46rem; }
    .form-panel__body :global(.form-head__dot) { width: 5px; height: 5px; }
    .form-panel__body :global(.form-body) { gap: 0.4rem; padding: 0.45rem 0.55rem; }
    .form-panel__body :global(.field) { gap: 0.12rem; }
    .form-panel__body :global(.field__num),
    .form-panel__body :global(.field label) { font-size: 0.46rem; }
    .form-panel__body :global(input) { padding: 0.4rem 0.55rem; font-size: 0.78rem; border-radius: 0; }
    .form-panel__body :global(.checkbox-label) {
      gap: 0.35rem;
      padding: 0.3rem 0.45rem;
      font-size: 0.46rem;
      line-height: 1.4;
      border-radius: 0;
    }
    .form-panel__body :global(.checkbox-label input) { width: 13px; height: 13px; }
    .form-panel__body :global(button) { padding: 0.45rem 0.6rem; font-size: 0.52rem; border-radius: 0; }
    .form-panel__body :global(.error-message),
    .form-panel__body :global(.success-message) { font-size: 0.5rem; line-height: 1.4; }
    .form-panel__body :global(.form-foot) { padding: 0.3rem 0.5rem; font-size: 0.42rem; }
  }

  @media (max-width: 900px) and (max-height: 700px) {
    .pitch-panel__body { gap: 0.15rem; padding: 0.3rem 0.45rem; }
    .benefits li { padding-block: 0.08rem; }
    .pitch-panel__body .kicker,
    .drop-privacy { display: none; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import SpotifyLatestPlayer from "../components/SpotifyLatestPlayer.astro";
import DropCountdown from "../components/DropCountdown.astro";
import { DISCOGRAPHY, LATEST_RELEASE, SPOTIFY_ARTIST_URL } from "../data/siteConfig";

const sorted = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  if (a.streams && b.streams) return b.streams - a.streams;
  if (a.streams) return -1;
  if (b.streams) return 1;
  return 0;
});

const years = DISCOGRAPHY.map((track) => track.year);
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
const totalStreams = DISCOGRAPHY.reduce((total, track) => total + (track.streams ?? 0), 0);

function formatStreams(n?: number) {
  if (!n) return null;
  if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K`;
  return String(n);
}

const totalStreamsLabel = totalStreams >= 1000
  ? `${(totalStreams / 1000).toFixed(0)}K`
  : String(totalStreams);
---

<ArtistLayout
  title="Música"
  description="Discografía completa de Garguttieneunchingodeferia — singles 2025-2026."
  theme="red"
  rail={{
    number: "01",
    label: "Música",
    links: [
      { href: "#ahora", label: "Ahora suena" },
      { href: "#discografia", label: "Discografía" },
    ],
  }}
>
  <div class="internal-shell music-page">
    <header class="internal-hero">
      <div class="internal-hero__top">
        <span class="kicker">01 / Catálogo</span>
        <span class="internal-hero__note">{sorted.length} tracks · {firstYear}—{lastYear}</span>
        <span class="internal-hero__live"><i aria-hidden="true"></i> Spotify en vivo</span>
      </div>

      <div class="music-hero">
        <div>
          <h1 class="internal-hero__title">Música<span aria-hidden="true">*</span></h1>
          <p class="internal-hero__lead">
            Singles, colaboraciones y ruido desde Guadalajara. Todo lo que ha
            salido, en orden de caída.
          </p>
          <div class="internal-hero__actions">
            <a href="#discografia" class="btn btn--primary">Ver discografía <span aria-hidden="true">↓</span></a>
            <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--outline">
              Abrir Spotify <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <dl class="music-stats">
          <div>
            <dt>Lanzamientos</dt>
            <dd>{String(sorted.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Reproducciones</dt>
            <dd>{totalStreamsLabel}</dd>
          </div>
          <div>
            <dt>Periodo</dt>
            <dd>{firstYear}—{String(lastYear).slice(-2)}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="music-boards" id="ahora">
      <section class="panel-card last-drop" aria-labelledby="lastDropTitle">
        <div class="panel-card__bar">
          <span>Now playing</span>
          <span aria-hidden="true">GGT / Audio</span>
        </div>
        <div class="panel-card__body">
          <div class="last-drop__head">
            <div>
              <span class="kicker">Escucha ahora</span>
              <h2 id="lastDropTitle">{LATEST_RELEASE.name}</h2>
            </div>
            <span class="chip chip--accent">Spotify</span>
          </div>
          <SpotifyLatestPlayer />
          <DropCountdown />
          <p class="last-drop__note">
            Dale play. El siguiente drop ya viene en camino.
          </p>
        </div>
      </section>

      <aside class="drop-cta" aria-labelledby="dropCtaTitle">
        <span class="kicker">Acceso anticipado</span>
        <h2 id="dropCtaTitle">Entra al Drop Room</h2>
        <p>
          Escucha y mira antes que el público. Contenido exclusivo, fechas de
          shows y el próximo drop directo a tu email.
        </p>
        <a href="/drop-room" class="btn btn--primary">Unirme ahora <span aria-hidden="true">→</span></a>
        <ul>
          <li><span aria-hidden="true">01</span> Acceso anticipado</li>
          <li><span aria-hidden="true">02</span> Contenido exclusivo</li>
          <li><span aria-hidden="true">03</span> Fechas de shows</li>
        </ul>
      </aside>
    </div>

    <section id="discografia" aria-labelledby="discografiaTitle">
      <div class="section-heading">
        <h2 id="discografiaTitle">Discografía</h2>
        <span>{sorted.length} releases · {firstYear}—{lastYear}</span>
      </div>

      <ol class="ledger">
        {sorted.map((track, i) => (
          <li class="ledger__row" data-track-title={track.title}>
            <a
              href={track.spotifyUrl}
              target="_blank"
              rel="noopener"
              class="ledger__link"
              aria-label={`Escuchar ${track.title} en Spotify`}
            >
              <span class="ledger__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="ledger__cover">
                {track.coverUrl ? (
                  <img src={track.coverUrl} alt="" width="80" height="80" loading="lazy" decoding="async" />
                ) : (
                  <span class="ledger__fallback">{track.title.charAt(0)}</span>
                )}
              </span>
              <span class="ledger__info">
                <span class="ledger__title">{track.title}</span>
                <span class="ledger__meta">
                  {track.year} · {track.type === "solo" ? "Solo" : "Colab"}
                  {track.collaborators?.length ? ` · ${track.collaborators.join(" / ")}` : ""}
                </span>
              </span>
              <span class="ledger__plays" data-track-streams>
                {track.streams ? `${formatStreams(track.streams)} reprod.` : ""}
              </span>
              <span class="ledger__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="music-footer">
        <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--outline">
          Ver todo en Spotify <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <PageFooter />
</ArtistLayout>

<script is:inline>
  (() => {
    const normalize = (value) => String(value || "").trim().toLowerCase();
    const compact = (value) => {
      if (typeof value !== "number" || Number.isNaN(value)) return "";
      if (value >= 10_000) return `${(value / 1000).toFixed(0)}K`;
      if (value >= 1000) return `${(value / 1000).toFixed(1)}K`;
      return String(value);
    };

    const applyStats = (entries, key) => {
      if (!Array.isArray(entries) || entries.length === 0) return;

      const stats = new Map(
        entries
          .filter((entry) => entry && entry[key])
          .map((entry) => [normalize(entry[key]), entry.playcount])
      );

      document.querySelectorAll(".ledger__row[data-track-title]").forEach((row) => {
        const playcount = stats.get(normalize(row.dataset.trackTitle));
        if (typeof playcount !== "number") return;

        const target = row.querySelector("[data-track-streams]");
        if (target) target.textContent = `${compact(playcount)} reprod.`;
      });
    };

    fetch("/api/discography-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyStats(data.tracks, "title");
      })
      .catch(() => {});

    fetch("/api/artist-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyStats(data.topTracks, "name");
      })
      .catch(() => {});
  })();
</script>

<style>
  .music-page { padding-top: clamp(0.75rem, 2.5vw, 1.25rem); }

  .music-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: end;
  }

  .music-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
  }
  .music-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 0.8rem;
    border: 1px solid rgba(0, 0, 0, 0.35);
  }
  .music-stats dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
    color: #ffffff;
  }
  .music-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    line-height: 1;
    color: #ffffff;
  }
  .music-stats div:last-child dd { font-size: clamp(1rem, 2vw, 1.4rem); }

  .music-boards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .last-drop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }
  .last-drop__head h2 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 400;
    line-height: 0.95;
    text-transform: uppercase;
    color: #ffffff;
  }
  .last-drop__note {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .drop-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: clamp(1.35rem, 3.5vw, 2rem);
    border: 1px solid var(--accent);
  }
  .drop-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.1rem);
    font-weight: 400;
    line-height: 0.92;
    text-transform: uppercase;
    color: #ffffff;
  }
  .drop-cta p {
    max-width: 38ch;
    font-size: 0.92rem;
    line-height: 1.7;
    color: #ffffff;
  }
  .drop-cta .btn { margin-top: 0.15rem; }
  .drop-cta ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    list-style: none;
  }
  .drop-cta li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    color: #ffffff;
  }
  .drop-cta li span {
    color: #0a0002;
    letter-spacing: 0.1em;
  }

  /* Ledger de discografía */
  .ledger {
    list-style: none;
    background: #000000;
    border: 1px solid var(--accent);
    box-shadow: 12px 12px 0 rgba(0, 0, 0, 0.35);
  }
  .ledger__row { border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
  .ledger__row:last-child { border-bottom: 0; }
  .ledger__link {
    display: grid;
    grid-template-columns: 3.5rem 4.5rem minmax(0, 1fr) auto 1.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    color: #ffffff;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .ledger__num {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1;
    color: var(--accent);
    transition: color 0.18s ease;
  }
  .ledger__cover {
    display: block;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #120000;
  }
  .ledger__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.7) contrast(1.05);
    transition: filter 0.25s ease, transform 0.35s ease;
  }
  .ledger__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 2rem;
    color: #ffffff;
  }
  .ledger__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .ledger__title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.7rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ledger__meta {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ledger__plays {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #ffffff;
  }
  .ledger__arrow {
    font-size: 1.2rem;
    line-height: 1;
    color: var(--accent);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .ledger__row:hover .ledger__link,
  .ledger__row:focus-within .ledger__link {
    background: var(--accent);
  }
  .ledger__row:hover .ledger__num,
  .ledger__row:hover .ledger__arrow,
  .ledger__row:focus-within .ledger__num,
  .ledger__row:focus-within .ledger__arrow { color: #ffffff; }
  .ledger__row:hover .ledger__arrow { transform: translate(3px, -3px); }
  .ledger__row:hover .ledger__cover img { filter: grayscale(0) contrast(1.05); transform: scale(1.05); }

  .music-footer {
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (min-width: 640px) {
    .music-boards {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: stretch;
      gap: 1.1rem;
    }
  }

  @media (min-width: 900px) {
    .music-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    }
    .music-stats { align-self: end; }
  }

  @media (max-width: 640px) {
    .ledger__link {
      grid-template-columns: 2.2rem 3.4rem minmax(0, 1fr);
      grid-template-areas:
        "num cover info"
        "num cover plays";
      gap: 0.35rem 0.65rem;
      padding: 0.7rem 0.65rem;
    }
    .ledger__num { grid-area: num; font-size: 1.5rem; }
    .ledger__cover { grid-area: cover; width: 3.4rem; }
    .ledger__info { grid-area: info; }
    .ledger__plays { grid-area: plays; font-size: 0.56rem; }
    .ledger__arrow { display: none; }
    .ledger__title { white-space: normal; font-size: 0.98rem; }
    .ledger__meta { white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger__link,
    .ledger__cover img,
    .ledger__num,
    .ledger__arrow { transition: none; }
    .ledger__row:hover .ledger__cover img { transform: none; }
  }
</style>

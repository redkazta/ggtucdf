---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import Skeleton from "../components/Skeleton.astro";
import SpotifyLatestPlayer from "../components/SpotifyLatestPlayer.astro";
import DropCountdown from "../components/DropCountdown.astro";
import { DISCOGRAPHY, LATEST_RELEASE, SPOTIFY_ARTIST_URL } from "../data/siteConfig";

const sorted = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  if (a.streams && b.streams) return b.streams - a.streams;
  if (a.streams) return -1;
  if (b.streams) return 1;
  return 0;
});

const years = DISCOGRAPHY.map((track) => track.year);
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
const totalStreams = DISCOGRAPHY.reduce((total, track) => total + (track.streams ?? 0), 0);

function formatStreams(n?: number) {
  if (!n) return null;
  if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K`;
  return String(n);
}

const totalStreamsLabel = totalStreams >= 1000
  ? `${(totalStreams / 1000).toFixed(0)}K`
  : String(totalStreams);
---

<ArtistLayout title="Música" description="Discografía completa de Garguttieneunchingodeferia — singles 2025-2026." theme="red">
  <div class="internal-shell music-page">
    <header class="internal-hero">
      <div class="internal-hero__top">
        <span class="kicker">01 / Catálogo</span>
        <span class="internal-hero__note">{sorted.length} tracks · {firstYear}—{lastYear}</span>
        <span class="internal-hero__live"><i aria-hidden="true"></i> Spotify en vivo</span>
      </div>

      <div class="music-hero">
        <div>
          <h1 class="internal-hero__title">Música<span aria-hidden="true">*</span></h1>
          <p class="internal-hero__lead">
            Singles, colaboraciones y ruido desde Guadalajara. Todo lo que ha
            salido, en orden de caída.
          </p>
          <div class="internal-hero__actions">
            <a href="#discografia" class="btn btn--primary">Ver discografía <span aria-hidden="true">↓</span></a>
            <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--outline">
              Abrir Spotify <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <dl class="music-stats">
          <div>
            <dt>Lanzamientos</dt>
            <dd>{String(sorted.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Reproducciones</dt>
            <dd>{totalStreamsLabel}</dd>
          </div>
          <div>
            <dt>Periodo</dt>
            <dd>{firstYear}—{String(lastYear).slice(-2)}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="music-boards">
      <section class="panel-card last-drop" aria-labelledby="lastDropTitle">
        <div class="panel-card__bar">
          <span>Now playing</span>
          <span aria-hidden="true">GGT / Audio</span>
        </div>
        <div class="panel-card__body">
          <div class="last-drop__head">
            <div>
              <span class="kicker">Escucha ahora</span>
              <h2 id="lastDropTitle">{LATEST_RELEASE.name}</h2>
            </div>
            <span class="chip chip--accent">Spotify</span>
          </div>
          <SpotifyLatestPlayer />
          <DropCountdown />
          <p class="last-drop__note">
            Dale play. El siguiente drop ya viene en camino.
          </p>
        </div>
      </section>

      <aside class="drop-cta" aria-labelledby="dropCtaTitle">
        <span class="kicker">Acceso anticipado</span>
        <h2 id="dropCtaTitle">Entra al Drop Room</h2>
        <p>
          Escucha y mira antes que el público. Contenido exclusivo, fechas de
          shows y el próximo drop directo a tu email.
        </p>
        <a href="/drop-room" class="btn btn--primary">Unirme ahora <span aria-hidden="true">→</span></a>
        <ul>
          <li><span aria-hidden="true">01</span> Acceso anticipado</li>
          <li><span aria-hidden="true">02</span> Contenido exclusivo</li>
          <li><span aria-hidden="true">03</span> Fechas de shows</li>
        </ul>
      </aside>
    </div>

    <section id="discografia" aria-labelledby="discografiaTitle">
      <div class="section-heading">
        <h2 id="discografiaTitle">Discografía</h2>
        <span>{sorted.length} releases · {firstYear}—{lastYear}</span>
      </div>

      <div class="discography-grid">
        {sorted.map((track, i) => (
          <a
            href={track.spotifyUrl}
            target="_blank"
            rel="noopener"
            class="track-card"
            data-track-title={track.title}
            aria-label={`Escuchar ${track.title} en Spotify`}
          >
            <div class="track-card__cover-wrap">
              {track.coverUrl ? (
                <>
                  <img
                    src={track.coverUrl}
                    alt=""
                    class="track-card__cover"
                    width="300"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    onload="this.classList.add('is-loaded'); this.nextElementSibling?.classList.add('is-hidden');"
                  />
                  <div class="track-card__skeleton" aria-hidden="true">
                    <Skeleton width="100%" height="100%" borderRadius="0" />
                  </div>
                </>
              ) : (
                <div class="track-card__cover-fallback">
                  <span>{track.title.charAt(0)}</span>
                </div>
              )}
              <span class="track-card__type" data-type={track.type}>
                {track.type === "solo" ? "Solo" : "Colab"}
              </span>
              <span class="track-card__play" aria-hidden="true">▶</span>
            </div>

            <div class="track-card__body">
              <div class="track-card__top">
                <span class="track-card__index">{String(i + 1).padStart(2, "0")}</span>
                <span class="track-card__year">{track.year}</span>
              </div>
              <h3 class="track-card__title">{track.title}</h3>
              <div class="track-card__meta">
                <span data-track-streams>{track.streams ? `${formatStreams(track.streams)} reprod.` : ""}</span>
                {track.collaborators && track.collaborators.length > 0 && (
                  <span class="track-card__collabs">{track.collaborators.join(" / ")}</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="music-footer">
        <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--outline">
          Ver todo en Spotify <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <PageFooter />
</ArtistLayout>

<script is:inline>
  (() => {
    const normalize = (value) => String(value || "").trim().toLowerCase();
    const compact = (value) => {
      if (typeof value !== "number" || Number.isNaN(value)) return "";
      if (value >= 10_000) return `${(value / 1000).toFixed(0)}K`;
      if (value >= 1000) return `${(value / 1000).toFixed(1)}K`;
      return String(value);
    };

    const applyStats = (entries, key) => {
      if (!Array.isArray(entries) || entries.length === 0) return;

      const stats = new Map(
        entries
          .filter((entry) => entry && entry[key])
          .map((entry) => [normalize(entry[key]), entry.playcount])
      );

      document.querySelectorAll(".track-card[data-track-title]").forEach((card) => {
        const playcount = stats.get(normalize(card.dataset.trackTitle));
        if (typeof playcount !== "number") return;

        const target = card.querySelector("[data-track-streams]");
        if (target) target.textContent = `${compact(playcount)} reprod.`;
      });
    };

    // Primero los playcounts por lanzamiento (más completos).
    fetch("/api/discography-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyStats(data.tracks, "title");
      })
      .catch(() => {});

    // Refuerzo con el top de Spotify por si algún release no tiene álbum.
    fetch("/api/artist-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyStats(data.topTracks, "name");
      })
      .catch(() => {});
  })();
</script>

<style>
  .music-page { padding-top: clamp(0.75rem, 2.5vw, 1.25rem); }

  .music-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: end;
  }

  .music-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
  }
  .music-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .music-stats dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--ink);
  }
  .music-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 2.1rem);
    line-height: 1;
    color: var(--ink);
  }

  /* Paneles superiores */
  .music-boards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .last-drop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }
  .last-drop__head h2 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 400;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--ink);
  }
  .last-drop__note {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .drop-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: clamp(1.35rem, 3.5vw, 2rem);
    border: 1px solid var(--accent-line);
    border-radius: 22px;
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(255, 35, 56, 0.35), transparent 64%),
      linear-gradient(180deg, #1a0508, #080506);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .drop-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.1rem);
    font-weight: 400;
    line-height: 0.92;
    text-transform: uppercase;
    color: #ffffff;
  }
  .drop-cta p {
    max-width: 38ch;
    font-size: 0.92rem;
    line-height: 1.7;
    color: #ffffff;
  }
  .drop-cta .btn { margin-top: 0.15rem; }
  .drop-cta ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .drop-cta li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    color: #ffffff;
  }
  .drop-cta li span {
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  /* Discografía */
  .discography-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .track-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg-soft));
    text-decoration: none;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.4);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .track-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--accent);
  }
  .track-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .track-card__cover-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #0b0b0d;
  }
  .track-card__cover {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    opacity: 0;
    filter: grayscale(0.15) contrast(1.05);
    transition: opacity 0.35s ease, filter 0.35s ease, transform 0.5s ease;
  }
  .track-card:hover .track-card__cover {
    filter: grayscale(0) contrast(1.08);
    transform: scale(1.05);
  }
  .track-card__cover.is-loaded { opacity: 1; }

  .track-card__skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .track-card__skeleton.is-hidden { opacity: 0; pointer-events: none; }

  .track-card__cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(80% 80% at 50% 20%, rgba(255, 35, 56, 0.28), transparent 70%),
      var(--bg-elevated);
  }
  .track-card__cover-fallback span {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5rem);
    line-height: 1;
    color: var(--ink);
  }

  .track-card__type {
    position: absolute;
    top: 0.55rem;
    left: 0.55rem;
    z-index: 2;
    padding: 0.32rem 0.5rem;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.72);
    border: 1px solid var(--line);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }
  .track-card__type[data-type="solo"] {
    background: var(--accent);
    border-color: var(--accent);
  }

  .track-card__play {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding-left: 3px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    font-size: 0.78rem;
    line-height: 1;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .track-card:hover .track-card__play,
  .track-card:focus-visible .track-card__play {
    opacity: 1;
    transform: translateY(0);
  }

  .track-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.8rem 0.85rem 0.95rem;
  }
  .track-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .track-card__index { color: var(--accent); }
  .track-card__year { color: var(--ink); }

  .track-card__title {
    font-family: var(--font-display);
    font-size: clamp(0.98rem, 2.6vw, 1.3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .track-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--ink);
  }
  .track-card__meta [data-track-streams]:empty { display: none; }
  .track-card__collabs {
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .music-footer {
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (min-width: 640px) {
    .music-boards {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: stretch;
      gap: 1.1rem;
    }
    .discography-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .track-card__body { padding: 0.95rem 1rem 1.1rem; }
  }

  @media (min-width: 900px) {
    .music-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    }
    .music-stats { align-self: end; }
  }

  @media (min-width: 1024px) {
    .discography-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-card,
    .track-card__cover,
    .track-card__play { transition: none; }
    .track-card:hover { transform: none; }
    .track-card:hover .track-card__cover { transform: none; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import Skeleton from "../components/Skeleton.astro";
import SpotifyLatestPlayer from "../components/SpotifyLatestPlayer.astro";
import DropCountdown from "../components/DropCountdown.astro";
import { DISCOGRAPHY, SPOTIFY_ARTIST_URL } from "../data/siteConfig";

const sorted = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  if (a.streams && b.streams) return b.streams - a.streams;
  if (a.streams) return -1;
  if (b.streams) return 1;
  return 0;
});

function formatStreams(n?: number) {
  if (!n) return null;
  if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K`;
  return String(n);
}
---

<ArtistLayout title="Música" description="Discografía completa de Garguttieneunchingodeferia — singles 2025-2026.">
  <section class="music-page" aria-label="Discografía">
    <header class="page-head">
      <span class="eyebrow">Gargut / Catálogo</span>
      <h1 class="page-title">Música</h1>
    </header>

    <DropCountdown />

    <div class="featured-embed">
      <span class="embed-label">Escucha el último lanzamiento</span>
      <SpotifyLatestPlayer />
    </div>

    <div class="droproom-cta">
      <p>¿Quieres enterarte del próximo drop antes que nadie?</p>
      <a href="/drop-room" class="btn btn--primary">Unirme al Drop Room</a>
    </div>

    <h2 class="section-subtitle">Discografía</h2>

    <div class="discography-grid">
      {sorted.map((track) => (
        <a
          href={track.spotifyUrl}
          target="_blank"
          rel="noopener"
          class="track-card"
          aria-label={`Escuchar ${track.title} en Spotify`}
        >
          <div class="track-card__cover-wrap">
            {track.coverUrl ? (
              <>
                <img
                  src={track.coverUrl}
                  alt=""
                  class="track-card__cover"
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                  onload="this.classList.add('is-loaded'); this.nextElementSibling?.classList.add('is-hidden');"
                />
                <div class="track-card__skeleton" aria-hidden="true">
                  <Skeleton width="100%" height="100%" borderRadius="10px" />
                </div>
              </>
            ) : (
              <div class="track-card__cover-fallback">
                <span>{track.title.charAt(0)}</span>
              </div>
            )}
            <div class="track-card__overlay">
              <span class="track-card__play">▶</span>
            </div>
          </div>

          <div class="track-card__info">
            <h2 class="track-card__title">{track.title}</h2>
            <div class="track-card__meta">
              <span class="track-card__year">{track.year}</span>
              <span class="track-card__badge" data-type={track.type}>
                {track.type === "solo" ? "Solo" : "Colab"}
              </span>
              {track.streams ? (
                <span class="track-card__streams">{formatStreams(track.streams)} reprod.</span>
              ) : null}
            </div>
            {track.collaborators && track.collaborators.length > 0 && (
              <p class="track-card__collabs">
                {track.collaborators.join(", ")}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>

    <div class="music-footer">
      <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--outline">
        Ver todo en Spotify
      </a>
    </div>
  </section>

  <PageFooter />
</ArtistLayout>

<style>
  .music-page {
    padding: 2.5rem 1rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-head {
    margin-bottom: 1.75rem;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--accent-bright);
    text-transform: uppercase;
    margin-bottom: 0.45rem;
    opacity: 0.85;
  }

  .page-title {
    position: relative;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(2rem, 6vw, 3.2rem);
    color: var(--text);
    letter-spacing: 0.04em;
    line-height: 0.95;
    padding-bottom: 0.65rem;
    text-shadow: 0 0 32px rgba(225, 29, 46, 0.25);
  }
  .page-title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 64px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .featured-embed {
    max-width: 620px;
    margin: 0 auto 1.75rem;
  }
  .embed-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-align: center;
    margin-bottom: 0.6rem;
  }

  .droproom-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
    margin: 0 auto 2.5rem;
    padding: 1.5rem 1.25rem;
    max-width: 620px;
    border-radius: var(--radius);
    background:
      radial-gradient(420px 180px at 50% 0%, rgba(225, 29, 46, 0.14), transparent 70%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
    border: 1px solid var(--border);
    box-shadow: var(--shadow-deep);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
  }
  .droproom-cta::before {
    content: "";
    position: absolute;
    top: 0; left: 15%; right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-line), transparent);
  }
  .droproom-cta p {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .section-subtitle {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    color: var(--text-soft);
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    line-height: 1;
  }
  .section-subtitle::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
  }

  .discography-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.9rem;
  }

  @media (min-width: 640px) {
    .discography-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.1rem;
    }
  }

  .track-card {
    display: flex;
    flex-direction: column;
    padding: 0.65rem;
    border-radius: var(--radius);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.048) 0%, rgba(255, 255, 255, 0.012) 100%);
    box-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.9);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.3s ease;
  }
  .track-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-line);
    box-shadow:
      0 26px 50px -28px rgba(0, 0, 0, 0.95),
      0 0 30px -12px var(--accent-glow);
  }

  .track-card__cover-wrap {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.7rem;
    background: #0d0d10;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .track-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.5s ease;
  }
  .track-card:hover .track-card__cover { transform: scale(1.045); }
  .track-card__cover.is-loaded { opacity: 1; }

  .track-card__skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: opacity 0.4s ease;
  }
  .track-card__skeleton.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .track-card__cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(120% 100% at 50% 0%, rgba(225, 29, 46, 0.18), transparent 60%),
      linear-gradient(135deg, #1a0d10 0%, #0a0a0c 100%);
  }
  .track-card__cover-fallback span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: rgba(255, 255, 255, 0.18);
    text-transform: uppercase;
  }

  .track-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.6));
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .track-card:hover .track-card__overlay { opacity: 1; }

  .track-card__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding-left: 3px;
    border-radius: 50%;
    font-size: 1rem;
    color: #ffffff;
    background: rgba(225, 29, 46, 0.9);
    box-shadow: 0 0 28px var(--accent-glow), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    line-height: 1;
    transform: scale(0.85);
    transition: transform 0.25s ease;
  }
  .track-card:hover .track-card__play { transform: scale(1); }

  .track-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0 0.15rem 0.15rem;
  }

  .track-card__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text);
    letter-spacing: 0.02em;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .track-card__year {
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  .track-card__badge {
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.14rem 0.4rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--text-muted);
    line-height: 1;
  }
  .track-card__badge[data-type="solo"] {
    background: var(--accent-soft);
    border-color: var(--accent-line);
    color: #ff8b95;
  }

  .track-card__streams {
    font-size: 0.62rem;
    color: var(--text-dim);
  }

  .track-card__collabs {
    font-size: 0.68rem;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .music-footer {
    display: flex;
    justify-content: center;
    margin-top: 2.75rem;
  }

  @media (min-width: 768px) {
    .music-page { padding: 3rem 1.5rem 4rem; }
    .track-card { padding: 0.75rem; }
    .track-card__title { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-card, .track-card__cover, .track-card__play { transition: none; }
    .track-card:hover { transform: none; }
    .track-card:hover .track-card__cover { transform: none; }
  }
</style>

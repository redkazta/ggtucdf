---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import PageFooter from "../components/PageFooter.astro";
import Skeleton from "../components/Skeleton.astro";
import SpotifyLatestPlayer from "../components/SpotifyLatestPlayer.astro";
import DropCountdown from "../components/DropCountdown.astro";
import { DISCOGRAPHY, SPOTIFY_ARTIST_URL } from "../data/siteConfig";

const sorted = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  if (a.streams && b.streams) return b.streams - a.streams;
  if (a.streams) return -1;
  if (b.streams) return 1;
  return 0;
});

function formatStreams(n?: number) {
  if (!n) return null;
  if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K`;
  return String(n);
}
---

<ArtistLayout title="Música" description="Discografía completa de Garguttieneunchingodeferia — singles 2025-2026.">
  <section class="music-page" aria-label="Discografía">
    <header class="page-head">
      <div class="page-head__meta">
        <span class="kicker">01 / Catálogo</span>
        <span class="page-head__count">{sorted.length} tracks</span>
      </div>
      <h1 class="page-title page-title--xl">Música<span aria-hidden="true">*</span></h1>
      <p class="page-head__lead">
        Singles, colaboraciones y ruido de Guadalajara. Todo lo que ha salido,
        en orden de caída.
      </p>
    </header>

    <DropCountdown />

    <div class="featured-embed">
      <div class="featured-embed__info">
        <span class="kicker">Now playing</span>
        <h2>Último lanzamiento</h2>
        <p>Dale play. El siguiente drop ya viene en camino.</p>
      </div>
      <div class="featured-embed__player">
        <SpotifyLatestPlayer />
      </div>
    </div>

    <div class="droproom-cta">
      <div class="droproom-cta__text">
        <span class="kicker">Acceso anticipado</span>
        <p>¿Quieres enterarte del próximo drop antes que nadie?</p>
      </div>
      <a href="/drop-room" class="btn btn--primary">Unirme al Drop Room <span aria-hidden="true">→</span></a>
    </div>

    <div class="section-bar">
      <h2 class="section-subtitle">Discografía</h2>
      <span class="section-bar__meta">2025 — 2026</span>
    </div>

    <div class="discography-grid">
      {sorted.map((track, i) => (
        <a
          href={track.spotifyUrl}
          target="_blank"
          rel="noopener"
          class="track-card"
          aria-label={`Escuchar ${track.title} en Spotify`}
        >
          <div class="track-card__cover-wrap">
            {track.coverUrl ? (
              <>
                <img
                  src={track.coverUrl}
                  alt=""
                  class="track-card__cover"
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                  onload="this.classList.add('is-loaded'); this.nextElementSibling?.classList.add('is-hidden');"
                />
                <div class="track-card__skeleton" aria-hidden="true">
                  <Skeleton width="100%" height="100%" borderRadius="0" />
                </div>
              </>
            ) : (
              <div class="track-card__cover-fallback">
                <span>{track.title.charAt(0)}</span>
              </div>
            )}
            <span class="track-card__index">{String(i + 1).padStart(3, "0")}</span>
            <span class="track-card__badge" data-type={track.type}>
              {track.type === "solo" ? "Solo" : "Colab"}
            </span>
            <span class="track-card__play" aria-hidden="true">▶</span>
          </div>

          <div class="track-card__info">
            <h2 class="track-card__title">{track.title}</h2>
            <div class="track-card__meta">
              <span>{track.year}</span>
              {track.streams ? <span>{formatStreams(track.streams)} reprod.</span> : null}
            </div>
            {track.collaborators && track.collaborators.length > 0 && (
              <p class="track-card__collabs">{track.collaborators.join(" / ")}</p>
            )}
          </div>
        </a>
      ))}
    </div>

    <div class="music-footer">
      <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--outline">
        Ver todo en Spotify <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <PageFooter />
</ArtistLayout>

<style>
  .music-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  /* Cabecera editorial */
  .page-head {
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .page-head__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .page-head__count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .page-title--xl {
    display: flex;
    align-items: flex-start;
    gap: 0.1em;
    font-size: clamp(4rem, 19vw, 11rem);
    line-height: 0.78;
    letter-spacing: -0.02em;
  }
  .page-title--xl span {
    font-family: var(--font-mono);
    font-size: 0.16em;
    line-height: 1;
    margin-top: 0.25em;
    color: var(--accent);
    letter-spacing: 0;
  }
  .page-head__lead {
    max-width: 460px;
    margin-top: 1.2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  /* Player destacado */
  .featured-embed {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .featured-embed__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .featured-embed__info h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 400;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--ink);
  }
  .featured-embed__info p {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }
  .featured-embed__player { align-self: center; }

  /* Banda CTA */
  .droproom-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem 1.1rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    background: var(--bg-soft);
  }
  .droproom-cta__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .droproom-cta__text p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4.5vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Barra de sección */
  .section-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .section-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 6vw, 2.7rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .section-bar__meta {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  /* Grid de discografía */
  .discography-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .track-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--bg-soft);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s ease, border-color 0.2s ease, box-shadow 0.16s ease;
  }
  .track-card:hover {
    transform: translate(-3px, -3px);
    border-color: var(--accent);
    box-shadow: 6px 6px 0 var(--accent);
  }

  .track-card__cover-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--line);
  }
  .track-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    filter: grayscale(1) contrast(1.08);
    transition: opacity 0.35s ease, filter 0.35s ease, transform 0.5s ease;
  }
  .track-card:hover .track-card__cover {
    filter: grayscale(0) contrast(1.2);
    transform: scale(1.04);
  }
  .track-card__cover.is-loaded { opacity: 1; }

  .track-card__skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .track-card__skeleton.is-hidden { opacity: 0; pointer-events: none; }

  .track-card__cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
  }
  .track-card__cover-fallback span {
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--line-strong);
  }

  .track-card__index {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 0.28rem 0.45rem;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .track-card__badge {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    padding: 0.28rem 0.45rem;
    background: var(--bg);
    color: var(--text-muted);
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .track-card__badge[data-type="solo"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .track-card__play {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding-left: 2px;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.72rem;
    line-height: 1;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .track-card:hover .track-card__play {
    opacity: 1;
    transform: translateY(0);
  }

  .track-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.65rem 0.7rem 0.75rem;
  }
  .track-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .track-card__meta span + span { color: var(--accent); }
  .track-card__collabs {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .music-footer {
    display: flex;
    justify-content: flex-start;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .music-page { padding: 2.5rem 1.5rem 4rem; }
    .featured-embed {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: center;
      gap: 1.5rem;
      padding: 1.35rem;
    }
    .droproom-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.5rem 1.35rem;
    }
    .discography-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.9rem;
    }
  }

  @media (min-width: 1024px) {
    .music-page { padding: 3rem 2.25rem 5rem; }
    .discography-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
    .track-card__title { font-size: 1.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-card, .track-card__cover, .track-card__play { transition: none; }
    .track-card:hover { transform: none; }
    .track-card:hover .track-card__cover { transform: none; }
  }
</style>

---
import ArtistLayout from "../layouts/ArtistLayout.astro";
import SpotifyLatestPlayer from "../components/SpotifyLatestPlayer.astro";
import { DISCOGRAPHY, SPOTIFY_ARTIST_URL } from "../data/siteConfig";

const releases = [...DISCOGRAPHY].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  const aStreams = a.streams ?? -1;
  const bStreams = b.streams ?? -1;
  if (aStreams !== bStreams) return bStreams - aStreams;
  return a.title.localeCompare(b.title);
});

const half = Math.ceil(releases.length / 2);
const releasesA = releases.slice(0, half);
const releasesB = releases.slice(half);
const firstYear = Math.min(...DISCOGRAPHY.map((track) => track.year));
const lastYear = Math.max(...DISCOGRAPHY.map((track) => track.year));
const totalStreams = DISCOGRAPHY.reduce((total, track) => total + (track.streams ?? 0), 0);

const formatPlays = (value?: number) =>
  typeof value === "number" && value > 0 ? value.toLocaleString("es-MX") : "—";

const totalStreamsLabel = totalStreams >= 1000
  ? `${(totalStreams / 1000).toFixed(0)}K`
  : String(totalStreams);
---

<ArtistLayout
  title="Música"
  description="Discografía completa de Garguttieneunchingodeferia — singles 2025-2026."
  theme="red"
  board
>
  <div class="board-page">
    <header class="board-head">
      <h1 class="board-head__title">Música<span aria-hidden="true">*</span></h1>
      <div class="board-head__meta">
        <span><b>{releases.length}</b> tracks</span>
        <span>{firstYear}—{lastYear}</span>
        <span><b>{totalStreamsLabel}</b> reproducciones</span>
        <span>Spotify <b>live</b></span>
      </div>
    </header>

    <div class="board-grid music-board">
      <section class="board-panel player-panel">
        <div class="board-panel__head">
          <span>Ahora suena</span>
          <span>GGT / Audio</span>
        </div>
        <div class="board-panel__body player-panel__body">
          <SpotifyLatestPlayer />
          <p>Dale play. El siguiente drop ya viene en camino.</p>
          <a href={SPOTIFY_ARTIST_URL} target="_blank" rel="noopener" class="btn btn--primary">
            Abrir Spotify <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <aside class="board-panel drop-panel">
        <div class="board-panel__head">
          <span>Drop Room</span>
          <span>Acceso anticipado</span>
        </div>
        <div class="board-panel__body drop-panel__body">
          <span class="kicker">Antes que nadie</span>
          <h2>Entra al Drop Room</h2>
          <p>Contenido exclusivo, fechas de shows y el próximo drop directo a tu email.</p>
          <a href="/drop-room" class="btn btn--primary">Unirme <span aria-hidden="true">→</span></a>
          <ul>
            <li><span aria-hidden="true">01</span> Acceso anticipado</li>
            <li><span aria-hidden="true">02</span> Contenido exclusivo</li>
            <li><span aria-hidden="true">03</span> Fechas de shows</li>
          </ul>
        </div>
      </aside>

      <section class="board-panel catalog-board">
        <div class="board-panel__head">
          <span>Discografía</span>
          <span>{releases.length} releases · {firstYear}—{lastYear}</span>
        </div>
        <div class="board-panel__body board-panel__body--flush catalog-board__body">
          <div class="catalog-mini">
            <ol class="catalog-mini__col">
              {releasesA.map((track, i) => (
                <li class="release" data-track-title={track.title}>
                  <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                    <span class="release__index">{String(i + 1).padStart(2, "0")}</span>
                    <span class="release__cover">
                      {track.coverUrl ? (
                        <img src={track.coverUrl} alt="" width="48" height="48" loading="lazy" decoding="async" />
                      ) : (
                        <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                      )}
                    </span>
                    <span class="release__info">
                      <strong>{track.title}</strong>
                      <span class="release__meta">
                        {track.year} · {track.type === "solo" ? "Solo" : "Colab"}
                        {track.collaborators?.length ? ` · ${track.collaborators.join(" / ")}` : ""}
                      </span>
                    </span>
                    <span class="release__plays">{formatPlays(track.streams)}</span>
                    <span class="release__arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>

            <ol class="catalog-mini__col">
              {releasesB.map((track, i) => (
                <li class="release" data-track-title={track.title}>
                  <a href={track.spotifyUrl} target="_blank" rel="noopener" aria-label={`Escuchar ${track.title} en Spotify`}>
                    <span class="release__index">{String(i + half + 1).padStart(2, "0")}</span>
                    <span class="release__cover">
                      {track.coverUrl ? (
                        <img src={track.coverUrl} alt="" width="48" height="48" loading="lazy" decoding="async" />
                      ) : (
                        <span class="release__fallback" aria-hidden="true">{track.title.charAt(0)}</span>
                      )}
                    </span>
                    <span class="release__info">
                      <strong>{track.title}</strong>
                      <span class="release__meta">
                        {track.year} · {track.type === "solo" ? "Solo" : "Colab"}
                        {track.collaborators?.length ? ` · ${track.collaborators.join(" / ")}` : ""}
                      </span>
                    </span>
                    <span class="release__plays">{formatPlays(track.streams)}</span>
                    <span class="release__arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    </div>
  </div>
</ArtistLayout>

<script is:inline>
  (() => {
    const normalize = (value) => String(value || "").trim().toLowerCase();
    const compact = (value) => {
      if (typeof value !== "number" || Number.isNaN(value)) return "";
      if (value >= 10_000) return `${(value / 1000).toFixed(0)}K`;
      if (value >= 1000) return `${(value / 1000).toFixed(1)}K`;
      return String(value);
    };

    const applyStats = (entries, key) => {
      if (!Array.isArray(entries) || entries.length === 0) return;

      const stats = new Map(
        entries
          .filter((entry) => entry && entry[key])
          .map((entry) => [normalize(entry[key]), entry.playcount])
      );

      document.querySelectorAll(".release[data-track-title]").forEach((item) => {
        const playcount = stats.get(normalize(item.dataset.trackTitle));
        if (typeof playcount !== "number") return;

        const plays = item.querySelector(".release__plays");
        if (plays) plays.textContent = compact(playcount);
      });
    };

    fetch("/api/discography-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyStats(data.tracks, "title");
      })
      .catch(() => {});

    fetch("/api/artist-stats", { headers: { Accept: "application/json" } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || data.source !== "spotify") return;
        applyStats(data.topTracks, "name");
      })
      .catch(() => {});
  })();
</script>

<style>
  .music-board {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    grid-template-rows: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }
  .player-panel { grid-column: 1; grid-row: 1; }
  .drop-panel { grid-column: 2; grid-row: 1; }
  .catalog-board { grid-column: 1 / -1; grid-row: 2; }

  .player-panel__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }
  .player-panel__body p {
    font-size: 0.75rem;
    line-height: 1.5;
    color: #ffffff;
  }
  .player-panel__body .btn {
    padding: 0.65rem 0.9rem;
    font-size: 0.56rem;
  }

  .drop-panel__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .drop-panel__body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 400;
    line-height: 0.95;
    text-transform: uppercase;
    color: #ffffff;
  }
  .drop-panel__body p {
    font-size: 0.72rem;
    line-height: 1.5;
    color: #ffffff;
  }
  .drop-panel__body .btn {
    padding: 0.65rem 0.9rem;
    font-size: 0.56rem;
  }
  .drop-panel__body ul {
    width: 100%;
    margin-top: 0.2rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    list-style: none;
  }
  .drop-panel__body li {
    display: flex;
    gap: 0.45rem;
    padding: 0.18rem 0;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .drop-panel__body li span { color: var(--accent); }

  .catalog-board__body { display: flex; flex-direction: column; }
  .catalog-mini {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    flex: 1;
    min-height: 0;
  }
  .catalog-mini__col { list-style: none; min-width: 0; }
  .catalog-mini__col + .catalog-mini__col { border-left: 1px solid rgba(255, 255, 255, 0.18); }
  .release { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .release:last-child { border-bottom: 0; }
  .release a {
    display: grid;
    grid-template-columns: 1.15rem 2rem minmax(0, 1fr) auto 0.8rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.55rem;
    color: #ffffff;
    text-decoration: none;
    transition: background 0.16s ease;
  }
  .release__index { font-family: var(--font-display); font-size: 0.75rem; color: var(--accent); }
  .release__cover {
    display: block;
    width: 2rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #100000;
  }
  .release__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.8) contrast(1.05);
    transition: filter 0.25s ease, transform 0.3s ease;
  }
  .release__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 1rem;
    color: #ffffff;
  }
  .release__info { display: flex; flex-direction: column; min-width: 0; }
  .release__info strong {
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 1.2vw, 0.9rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #ffffff;
  }
  .release__meta {
    font-family: var(--font-mono);
    font-size: 0.45rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .release__plays {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
  }
  .release__arrow { font-size: 0.55rem; color: var(--accent); }
  .release:hover a { background: var(--accent); }
  .release:hover .release__index,
  .release:hover .release__arrow { color: #ffffff; }
  .release:hover .release__cover img { filter: grayscale(0); transform: scale(1.05); }

  @media (min-width: 901px) and (max-height: 820px) {
    .drop-panel__body { gap: 0.4rem; }
    .drop-panel__body h2 { font-size: clamp(1.3rem, 3vw, 1.9rem); }
    .drop-panel__body p { font-size: 0.66rem; }
    .drop-panel__body ul { padding-top: 0.35rem; }
    .release a { padding: 0.32rem 0.5rem; }
  }

  @media (max-width: 900px) {
    .music-board {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 0.85fr) minmax(0, 0.85fr) minmax(0, 1.3fr);
      overflow: hidden;
    }
    .player-panel,
    .drop-panel,
    .catalog-board { grid-column: auto; grid-row: auto; }

    .player-panel__body { gap: 0.3rem; padding: 0.4rem 0.5rem; }
    .player-panel__body p { font-size: 0.6rem; line-height: 1.3; }
    .player-panel__body .btn,
    .drop-panel__body .btn { padding: 0.38rem 0.55rem; font-size: 0.48rem; }

    .drop-panel__body { gap: 0.28rem; padding: 0.4rem 0.5rem; }
    .drop-panel__body h2 { font-size: 1.15rem; line-height: 0.95; }
    .drop-panel__body p { font-size: 0.58rem; line-height: 1.3; }
    .drop-panel__body ul { padding-top: 0.25rem; margin-top: 0.1rem; }
    .drop-panel__body li { padding: 0.05rem 0; font-size: 0.4rem; }

    .catalog-board__body { padding: 0; }
    .catalog-mini { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .catalog-mini__col + .catalog-mini__col {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.18);
    }
    .release a {
      grid-template-columns: 0.85rem 1.35rem minmax(0, 1fr) auto;
      gap: 0.25rem;
      padding: 0.2rem 0.3rem;
    }
    .release__cover { width: 1.35rem; }
    .release__index { font-size: 0.58rem; }
    .release__info strong { font-size: 0.58rem; }
    .release__meta { font-size: 0.38rem; }
    .release__plays { font-size: 0.4rem; }
    .release__arrow { display: none; }
  }

  @media (max-width: 380px) {
    .release a { grid-template-columns: 0.85rem minmax(0, 1fr) auto; }
    .release__cover { display: none; }
  }

  @media (max-width: 900px) and (max-height: 700px) {
    .player-panel__body p { display: none; }
    .drop-panel__body .kicker,
    .drop-panel__body ul { display: none; }
    .release__meta { display: none; }
  }
</style>

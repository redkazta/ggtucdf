---
import Analytics from "@vercel/analytics/astro";
import Hero from "../components/Hero.astro";
import RegisterSW from "../components/RegisterSW.astro";
import {
  HERO_VIDEO_URL,
  TRACK_SRC,
  WILDFORGE_LOGO,
  WILDFORGE_URL,
  SPOTIFY_URL,
  YOUTUBE_URL,
  INSTAGRAM_URL,
  SITE_URL,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_AUTHOR,
  SITE_THEME_COLOR,
  OG_IMAGE_URL,
} from "../data/siteConfig";

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Artista", href: "/artista" },
  { label: "Música", href: "/musica" },
  { label: "Videos", href: "/videos" },
  { label: "Drop Room", href: "/drop-room" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta name="keywords" content={SITE_KEYWORDS.join(", ")} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="theme-color" content={SITE_THEME_COLOR} />
    <meta name="robots" content="index, follow" />
    <title>{SITE_TITLE}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="canonical" href={SITE_URL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:image" content={OG_IMAGE_URL} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={SITE_URL} />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE_URL} />

    <link rel="manifest" href="/manifest.json" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MusicGroup",
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: SITE_URL,
      image: OG_IMAGE_URL,
      sameAs: [YOUTUBE_URL, SPOTIFY_URL, INSTAGRAM_URL],
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />
    <link rel="prefetch" href="/artista" as="document" />

    <style is:global>
      :root {
        --bg: #000000;
        --bg-soft: #050506;
        --bg-elevated: #0d0d10;
        --ink: #ffffff;
        --text: #ffffff;
        --line: rgba(255, 255, 255, 0.22);
        --line-strong: rgba(255, 255, 255, 0.5);
        --surface: rgba(255, 255, 255, 0.04);
        --accent: #ff2338;
        --accent-bright: #ff5a68;
        --accent-deep: #ad0012;
        --accent-glow: rgba(255, 35, 56, 0.45);
        --font-display: "Anton", "Arial Narrow", Impact, sans-serif;
        --font-body: "Space Grotesk", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --font-mono: "Space Mono", "Courier New", monospace;
        --font-serif: "Instrument Serif", Georgia, "Times New Roman", serif;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      html { background: var(--bg); scroll-behavior: smooth; }

      body {
        min-height: 100dvh;
        overflow-x: hidden;
        color: var(--text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a { color: inherit; }

      ::selection { background: var(--accent); color: #ffffff; }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 1rem 1.6rem 0.9rem;
        border-radius: 12px;
        border: 1px solid var(--line-strong);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: transform 0.16s ease, background 0.2s ease, color 0.2s ease,
          border-color 0.2s ease, box-shadow 0.16s ease;
      }
      .btn:active { transform: translateY(1px); }
      .btn--primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #ffffff;
        box-shadow: 0 12px 34px rgba(255, 35, 56, 0.28);
      }
      .btn--primary:hover {
        background: var(--accent-bright);
        border-color: var(--accent-bright);
        transform: translateY(-2px);
      }
      .btn--ghost {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--line-strong);
        color: #ffffff;
        backdrop-filter: blur(8px);
      }
      .btn--ghost:hover { background: #ffffff; border-color: #ffffff; color: #000000; }

      @media (prefers-reduced-motion: reduce) {
        .btn { transition: none; }
        .btn:hover { transform: none; }
      }
    </style>

    <style>
      .home-topbar {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.9rem clamp(1.25rem, 4vw, 3rem);
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0));
      }
      .home-logo {
        display: inline-flex;
        align-items: baseline;
        text-decoration: none;
        line-height: 1;
      }
      .home-logo span { font-family: var(--font-display); font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.02em; }
      .home-logo .is-red { color: var(--accent); }
      .home-logo .is-white { color: #ffffff; }

      .home-nav {
        display: none;
        align-items: center;
        gap: 0.25rem;
      }
      .home-nav a {
        font-family: var(--font-mono);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        color: #ffffff;
        padding: 0.45rem 0.7rem;
        border-radius: 8px;
        transition: background 0.18s ease, color 0.18s ease;
      }
      .home-nav a:hover { background: #ffffff; color: #000000; }

      .home-sound {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.5);
        color: #ffffff;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.1s ease;
      }
      .home-sound:hover { background: #ffffff; color: #000000; }
      .home-sound:active { transform: scale(0.96); }
      .home-sound svg { width: 22px; height: 22px; fill: currentColor; }

      .home-credit {
        position: fixed;
        left: clamp(1.25rem, 4vw, 3rem);
        bottom: 1.1rem;
        z-index: 150;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.55);
        text-decoration: none;
        backdrop-filter: blur(10px);
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .home-credit:hover { border-color: var(--line-strong); background: rgba(0, 0, 0, 0.75); }
      .home-credit__eyebrow {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #ffffff;
      }
      .home-credit img {
        display: block;
        height: 24px;
        width: auto;
        object-fit: contain;
      }
      .home-credit__fallback {
        display: none;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: #ff6a00;
        text-transform: uppercase;
      }

      @media (min-width: 768px) {
        .home-nav { display: flex; }
      }
    </style>
  </head>

  <body>
    <Analytics />
    <RegisterSW />

    <header class="home-topbar">
      <a href="/" class="home-logo" aria-label="Inicio">
        <span class="is-red">G</span><span class="is-white">ARGUT</span>
      </a>

      <nav class="home-nav" aria-label="Navegación principal">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <button class="home-sound" id="soundToggle" type="button" aria-label="Activar o desactivar sonido">
        <svg id="soundOnIcon" viewBox="0 0 24 24" style="display:none" aria-hidden="true">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path>
        </svg>
        <svg id="soundOffIcon" viewBox="0 0 24 24" style="display:block" aria-hidden="true">
          <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"></path>
        </svg>
      </button>
    </header>

    <Hero
      videoUrl={HERO_VIDEO_URL}
      title="GARGUTTIENEUNCHINGODEFERIA"
      tagline="Música urbana desde Guadalajara, México. Sin fórmula, sin permiso."
    />

    <a href={WILDFORGE_URL} target="_blank" rel="noopener noreferrer" class="home-credit" aria-label="Sitio hecho por WildForgeLabs">
      <span class="home-credit__eyebrow">Hecho por</span>
      <img
        src={WILDFORGE_LOGO}
        alt="WildForgeLabs"
        decoding="async"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';"
      />
      <span class="home-credit__fallback" style="display:none;">WILDFORGELABS</span>
    </a>

    <audio id="track" preload="none" loop playsinline muted data-src={TRACK_SRC}></audio>

    <script>
      (() => {
        const audio = document.getElementById("track");
        const btn = document.getElementById("soundToggle");
        const onIcon = document.getElementById("soundOnIcon");
        const offIcon = document.getElementById("soundOffIcon");
        if (!audio || !btn || !onIcon || !offIcon) return;

        let soundEnabled = false;

        function update() {
          onIcon.style.display = soundEnabled ? "block" : "none";
          offIcon.style.display = soundEnabled ? "none" : "block";
          btn.setAttribute("aria-pressed", soundEnabled ? "true" : "false");
        }

        btn.addEventListener("click", () => {
          if (!soundEnabled) {
            if (!audio.src) {
              audio.src = audio.dataset.src || "";
              audio.load();
            }
            soundEnabled = true;
            audio.muted = false;
            update();
            audio.play().catch(() => {});
          } else {
            soundEnabled = false;
            audio.muted = true;
            update();
          }
        });

        update();
      })();
    </script>
  </body>
</html>

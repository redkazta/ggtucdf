---
export const prerender = false;

import AdminTable from "../components/AdminTable.astro";
import DropSettingsForm from "../components/DropSettingsForm.astro";
import ArtistLayout from "../layouts/ArtistLayout.astro";
import { isAdminConfigured, isValidSession } from "../lib/adminAuth";
import { loadDropSettings } from "../lib/dropSettings";

const configured = isAdminConfigured();
const authenticated = configured && isValidSession(Astro.cookies);
const loginFailed = Astro.url.searchParams.get("error") === "1";
const dropSettings = authenticated ? await loadDropSettings() : null;
const today = new Intl.DateTimeFormat("es-MX", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "America/Mexico_City",
}).format(new Date());
---

<ArtistLayout
  title="Admin"
  noindex
  theme="red"
  rail={{
    number: "06",
    label: "Admin",
    links: authenticated
      ? [
          { href: "#drop-settings", label: "Drops" },
          { href: "#adminTable", label: "Registros" },
        ]
      : undefined,
  }}
>
  <div class="internal-shell admin-page">
    <header class="internal-hero">
      <div class="internal-hero__top">
        <span class="kicker">Privado / Consola</span>
        <span class="internal-hero__note">{today} / MX</span>
        <span class="internal-hero__live"><i aria-hidden="true"></i> GGT-ERP v2.6</span>
      </div>

      <div class="admin-hero">
        <div>
          <h1 class="internal-hero__title">Admin<span aria-hidden="true">*</span></h1>
          <p class="internal-hero__lead">Gestión de fans y operación de drops.</p>
        </div>

        <dl class="admin-facts">
          <div>
            <dt>Acceso</dt>
            <dd>{authenticated ? "Sesión activa" : "Restringido"}</dd>
          </div>
          <div>
            <dt>Entorno</dt>
            <dd>{configured ? "Producción" : "Sin configurar"}</dd>
          </div>
        </dl>
      </div>
    </header>

    {!configured ? (
      <div class="auth-panel" role="alert">
        <div class="panel-bar">
          <span>Error de configuración</span>
          <span class="panel-bar__flag">OFFLINE</span>
        </div>
        <div class="auth-panel__body">
          <p class="auth-error">
            El panel no está configurado. Añade <code>PRIVATE_ADMIN_TOKEN</code> en las
            variables de entorno del servidor y vuelve a desplegar.
          </p>
        </div>
      </div>
    ) : !authenticated ? (
      <form class="auth-panel" method="POST" action="/api/admin-login">
        <div class="panel-bar">
          <span>Acceso restringido</span>
          <span class="panel-bar__flag">SECURE</span>
        </div>
        <div class="auth-panel__body">
          <label class="auth-panel__label" for="adminPassword">
            <span aria-hidden="true">01</span> Contraseña de administrador
          </label>
          <input
            type="password"
            id="adminPassword"
            name="password"
            placeholder="••••••••••••"
            class="password-input"
            autocomplete="current-password"
            required
            autofocus
          />
          <button type="submit" class="login-btn">Entrar <span aria-hidden="true">→</span></button>
          {loginFailed ? (
            <p class="auth-error" role="alert">Contraseña incorrecta. Inténtalo de nuevo.</p>
          ) : null}
          <p class="auth-panel__foot">Sesión protegida por cookie HttpOnly.</p>
        </div>
      </form>
    ) : (
      <div class="admin-content">
        <div class="admin-toolbar">
          <span class="admin-toolbar__status">
            <span class="admin-toolbar__dot" aria-hidden="true"></span>
            Sesión activa
          </span>
          <form method="POST" action="/api/admin-logout">
            <button type="submit" class="logout-btn">Salir <span aria-hidden="true">↗</span></button>
          </form>
        </div>

        {dropSettings ? (
          <DropSettingsForm
            settings={dropSettings.settings}
            configured={dropSettings.configured}
            error={dropSettings.error}
          />
        ) : null}

        <AdminTable />
      </div>
    )}
  </div>
</ArtistLayout>

<style>
  .admin-page { padding-top: clamp(0.75rem, 2.5vw, 1.25rem); }

  .admin-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: end;
  }

  .admin-facts {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .admin-facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .admin-facts dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .admin-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    line-height: 1.05;
    text-align: right;
    white-space: nowrap;
    color: var(--ink);
  }

  .auth-panel {
    width: 100%;
    max-width: 520px;
    margin: clamp(1.25rem, 4vw, 2rem) auto 0;
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg-soft));
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.55);
  }
  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .panel-bar__flag { color: #ffffff; }

  .auth-panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.15rem, 3vw, 1.6rem);
  }
  .auth-panel__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .auth-panel__label span { color: var(--accent); letter-spacing: 0.08em; }

  .password-input {
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .password-input::placeholder { color: var(--ink); opacity: 0.6; }
  .password-input:hover:not(:focus) { border-color: var(--line-strong); }
  .password-input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--bg-elevated);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .login-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 14px 34px rgba(255, 35, 56, 0.3);
    transition: background 0.18s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }
  .login-btn:hover {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(255, 35, 56, 0.4);
  }
  .login-btn:active { transform: translateY(0); box-shadow: none; }

  .auth-error {
    padding: 0.7rem 0.8rem;
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.7;
  }
  .auth-error code {
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink);
  }
  .auth-panel__foot {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .admin-content { margin-top: 1.25rem; }

  .admin-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-soft);
  }
  .admin-toolbar__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .admin-toolbar__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc73;
    box-shadow: 0 0 10px rgba(61, 220, 115, 0.6);
  }

  .logout-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .logout-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .admin-content { animation: panel-in 0.35s ease; }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 768px) {
    .admin-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 360px); }
    .admin-facts { align-self: end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .admin-content { animation: none; }
    .login-btn,
    .logout-btn,
    .password-input { transition: none; }
    .login-btn:hover { transform: none; }
  }
</style>

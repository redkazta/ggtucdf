---
export const prerender = false;

import AdminTable from "../components/AdminTable.astro";
import DropSettingsForm from "../components/DropSettingsForm.astro";
import ArtistLayout from "../layouts/ArtistLayout.astro";
import { isAdminConfigured, isValidSession } from "../lib/adminAuth";
import { loadDropSettings } from "../lib/dropSettings";

const configured = isAdminConfigured();
const authenticated = configured && isValidSession(Astro.cookies);
const loginFailed = Astro.url.searchParams.get("error") === "1";
const dropSettings = authenticated ? await loadDropSettings() : null;
const today = new Intl.DateTimeFormat("es-MX", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "America/Mexico_City",
}).format(new Date());
---

<ArtistLayout title="Admin" noindex theme="red" board>
  <div class="board-page">
    <header class="board-head">
      <h1 class="board-head__title">Admin<span aria-hidden="true">*</span></h1>
      <div class="board-head__meta">
        <span>{today} / MX</span>
        <span>Acceso <b>{authenticated ? "activo" : "restringido"}</b></span>
        <span>Entorno <b>{configured ? "prod" : "sin configurar"}</b></span>
      </div>
    </header>

    {!configured ? (
      <div class="auth-wrap">
        <div class="auth-panel" role="alert">
          <div class="panel-bar">
            <span>Error de configuración</span>
            <span class="panel-bar__flag">OFFLINE</span>
          </div>
          <div class="auth-panel__body">
            <p class="auth-error">
              El panel no está configurado. Añade <code>PRIVATE_ADMIN_TOKEN</code> en las
              variables de entorno del servidor y vuelve a desplegar.
            </p>
          </div>
        </div>
      </div>
    ) : !authenticated ? (
      <div class="auth-wrap">
        <form class="auth-panel" method="POST" action="/api/admin-login">
          <div class="panel-bar">
            <span>Acceso restringido</span>
            <span class="panel-bar__flag">SECURE</span>
          </div>
          <div class="auth-panel__body">
            <label class="auth-panel__label" for="adminPassword">
              <span aria-hidden="true">01</span> Contraseña de administrador
            </label>
            <input
              type="password"
              id="adminPassword"
              name="password"
              placeholder="••••••••••••"
              class="password-input"
              autocomplete="current-password"
              required
              autofocus
            />
            <button type="submit" class="login-btn">Entrar <span aria-hidden="true">→</span></button>
            {loginFailed ? (
              <p class="auth-error" role="alert">Contraseña incorrecta. Inténtalo de nuevo.</p>
            ) : null}
            <p class="auth-panel__foot">Sesión protegida por cookie HttpOnly.</p>
          </div>
        </form>
      </div>
    ) : (
      <div class="board-grid admin-board">
        <div class="admin-toolbar">
          <span class="admin-toolbar__status">
            <span class="admin-toolbar__dot" aria-hidden="true"></span>
            Sesión activa
          </span>
          <form method="POST" action="/api/admin-logout">
            <button type="submit" class="logout-btn">Salir <span aria-hidden="true">↗</span></button>
          </form>
        </div>

        {dropSettings ? (
          <DropSettingsForm
            settings={dropSettings.settings}
            configured={dropSettings.configured}
            error={dropSettings.error}
          />
        ) : null}

        <AdminTable />
      </div>
    )}
  </div>
</ArtistLayout>

<style>
  .admin-board {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto minmax(0, 1fr);
  }

  .auth-wrap {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: auto;
    padding: 0.5rem 0;
  }
  .auth-panel {
    width: 100%;
    max-width: 440px;
    border: 1px solid var(--accent);
    background: #000000;
    overflow: hidden;
  }
  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.7rem;
    background: var(--accent);
    color: #0a0002;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .auth-panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem;
  }
  .auth-panel__label {
    display: flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .auth-panel__label span { color: var(--accent); }
  .password-input {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0;
    background: #050000;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
  .password-input:focus { outline: none; border-color: var(--accent); }
  .login-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--accent);
    border-radius: 0;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .login-btn:hover { background: var(--accent-bright); }
  .auth-error {
    padding: 0.5rem 0.6rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    line-height: 1.6;
  }
  .auth-error code { color: #ffffff; }
  .auth-panel__foot {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .admin-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--accent);
    background: #000000;
  }
  .admin-toolbar__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .admin-toolbar__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ddc73;
    box-shadow: 0 0 8px rgba(61, 220, 115, 0.6);
  }
  .logout-btn {
    padding: 0.35rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: transparent;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .logout-btn:hover { background: var(--accent); border-color: var(--accent); }

  :global(.admin-board .drop-settings) {
    margin: 0;
    min-height: 0;
    overflow: auto;
  }
  :global(.admin-board .drop-settings .settings-body) { padding: 0.75rem; }
  :global(.admin-board .admin-table-container) {
    margin: 0;
    min-height: 0;
    overflow: auto;
    padding: 0.75rem;
  }

  @media (max-width: 900px) {
    .admin-board { grid-template-columns: 1fr; grid-template-rows: auto; }
  }
</style>

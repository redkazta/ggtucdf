# Supabase (usar service_role key solo en server-side)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Resend (email de bienvenida)
PRIVATE_RESEND_API_KEY=re_tu_api_key
PRIVATE_RESEND_FROM_EMAIL=welcome@gargut.com

# Spotify (Client Credentials flow)
SPOTIFY_CLIENT_ID=tu_spotify_client_id
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret
# Opcional: si se omite, se usa el artista configurado en src/data/siteConfig.ts
SPOTIFY_ARTIST_ID=3IWeUxh0WKXHNXJ6ahJUtX

# Obligatorio para entrar a /admin y leer /api/fans.
# Usa un token largo y aleatorio (mínimo 8 caracteres, ideal 32+).
# Genera uno con: openssl rand -hex 32
PRIVATE_ADMIN_TOKEN=tu_token_secreto
